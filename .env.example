# ==============================================================================
# PINOKA SAAS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Gunakan template ini sebagai daftar variabel aplikasi. Untuk pengembangan lokal,
# buat .env.local dari template ini jika belum ada dan isi sesuai fitur yang dipakai.
# NODE_ENV diatur oleh perintah dev/build dan tidak perlu ditambahkan ke akun baru.
# Untuk deploy, atur konfigurasi runtime di Settings > Variables and Secrets pada
# Worker tujuan. Simpan nilai sensitif sebagai Secret.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT & APPLICATION URLS
# ------------------------------------------------------------------------------
# URL publik utama platform (contoh: https://pinoka.id atau domain Cloudflare Workers/Pages)
PUBLIC_SITE_URL=https://your-domain.com
# Opsional jika landing page memakai origin terpisah untuk formulir laporan bug.
# PUBLIC_LANDING_URL juga diterima sebagai alias.
PINOKA_LANDING_URL=
# URL publik aset logo resmi Pinoka (digunakan di template email transaksi/notifikasi)
PUBLIC_LOGO_URL=https://your-domain.com/assets/logo/logo.webp
# Kontak publik di landing page, tersedia saat Astro build.
PUBLIC_CONTACT_EMAIL=support@your-domain.com
PUBLIC_CONTACT_WA=6281234567890

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL / Neon Serverless)
# ------------------------------------------------------------------------------
# Connection string Postgres (mendukung Neon Serverless pooling / standard Postgres)
DATABASE_URL=postgresql://user:password@host:5432/pinoka_db?sslmode=require

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (Better Auth & Google OAuth)
# ------------------------------------------------------------------------------
# Secret runtime Worker. Buat nilai acak dengan `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Origin aplikasi. Untuk Worker, gunakan origin HTTPS yang menghosting aplikasi.
BETTER_AUTH_URL=http://localhost:4321
# Google Cloud Console OAuth 2.0 Client Credentials (untuk fitur login Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Khusus pengujian auth di server dev lokal. Biarkan nonaktif untuk penggunaan biasa.
ALLOW_DEV_AUTH_HEADER=false

# ------------------------------------------------------------------------------
# 4. AI STUDIO & GENERATION (OpenAI API)
# ------------------------------------------------------------------------------
# API Key OpenAI untuk fitur pembuatan Logo, Mockup Kemasan, dan Poster AI tenant
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (Xendit Invoice & E-Wallet)
# ------------------------------------------------------------------------------
# Secret API Key Xendit untuk lingkungan yang dipakai. Alias lama: XENDIT_SECRET_KEY.
XENDIT_API_KEY=
# Verification Token / Webhook Secret dari Dashboard Xendit (mencegah spoofing webhook)
XENDIT_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 6. MEDIA STORAGE & CDN (Cloudinary)
# ------------------------------------------------------------------------------
# Kredensial Cloudinary untuk hosting gambar produk, banner toko, dan thumbnail template
# Alias lama: CLOUDINARY_CLOUD_NAME untuk nama dan CLOUDINARY_API_SECRET untuk secret.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET=

# ------------------------------------------------------------------------------
# 7. EMAIL DELIVERY (SMTP / Gmail App Password)
# ------------------------------------------------------------------------------
# Konfigurasi SMTP untuk pengiriman invoice, kode verifikasi, dan reset password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Password aplikasi 16 karakter tanpa spasi (bukan password login email akun)
SMTP_PASS=

# ------------------------------------------------------------------------------
# 8. CRON JOB & AUTOMATED MAINTENANCE
# ------------------------------------------------------------------------------
# Token rahasia otorisasi request background scheduler / cron service luar
# Digunakan untuk membatalkan otomatis invoice pembelian template & kuota AI yang kedaluwarsa (> 24 jam belum dibayar):
# POST /api/cron/expire-transactions dengan header `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# ------------------------------------------------------------------------------
# 9. INITIAL DATABASE SEED (Superadmin Akun Pertama)
# ------------------------------------------------------------------------------
# Untuk pengembangan lokal (`bun run seed:superadmin`).
# Untuk setup database produksi, ikuti docs/production-bootstrap.md.
SEED_SUPERADMIN_NAME="Super Administrator"
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 10. CLOUDFLARE TURNSTILE (Verifikasi Halaman)
# ------------------------------------------------------------------------------
# Wajib untuk hostname yang memakai verifikasi dari Worker. Gunakan pasangan kunci dari widget Managed yang sama.
# Untuk Astro dev di localhost atau loopback, kosongkan kedua kunci untuk melewati verifikasi.
# Lihat docs/turnstile-gate.md untuk konfigurasi hostname dan Durable Object.
# Tambahkan sebagai Text di Cloudflare Worker > Settings > Variables and Secrets.
TURNSTILE_SITE_KEY=
# Tambahkan sebagai Secret di pengaturan Worker yang sama.
TURNSTILE_SECRET_KEY=
# Opsional. Isi satu hostname saja setelah aturan WAF Managed Challenge aktif dan terverifikasi.
TURNSTILE_MANAGED_CHALLENGE_HOST=
