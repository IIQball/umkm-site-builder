# `.agents/` is the product here, not local tooling.
# Many developers globally ignore `**/.agents/` to keep agent config out of repos.
# This negation overrides that, so the rules actually get committed.
!.agents/

# Dependencies and build output
node_modules/
dist/
.astro/

# Cloudflare / Wrangler local state
.wrangler/
.dev.vars

# Secrets (G6 — never pushed to GitHub)
.env
.env.local
.env.*.local
.env.production
!.env.example

# Uploaded media (local Cloudinary cache, if any)
uploads/
*.tmp

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/
