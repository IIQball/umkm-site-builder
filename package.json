{
  "name": "umkm-site-builder",
  "type": "module",
  "version": "0.0.1",
  "description": "No-code SaaS web builder for Indonesian UMKM",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src tests --ext .ts,.js,.astro,.svelte --max-warnings 0",
    "db:seed": "bun run src/db/seed.ts",
    "lint:fix": "eslint src tests --ext .ts,.js,.astro,.svelte --fix",
    "format": "prettier --write src",
    "test": "vitest",
    "test:unit": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "postinstall": "node scripts/fix-better-auth.js"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@neondatabase/serverless": "^1.1.0",
    "@types/bcryptjs": "^3.0.0",
    "astro": "^3.6.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.1",
    "cloudinary": "^2.10.1",
    "clsx": "^2.0.0",
    "daisyui": "^4.0.0",
    "drizzle-orm": "^0.45.2",
    "lucide-svelte": "^0.292.0",
    "svelte": "^4.0.0",
    "ws": "^8.21.3",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^7.0.0",
    "@astrojs/svelte": "^3.1.0",
    "@babel/eslint-parser": "^8.0.1",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "astro-eslint-parser": "0.16.3",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-astro": "0.31.4",
    "eslint-plugin-svelte": "^3.23.0",
    "prettier": "^3.1.0",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "3",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
