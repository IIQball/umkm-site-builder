{
  "name": "umkm-site-builder",
  "type": "module",
  "version": "0.0.1",
  "description": "No-code SaaS web builder for Indonesian UMKM",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src",
    "test": "vitest",
    "test:unit": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "astro": "^3.6.0",
    "better-auth": "^1.7.0",
    "clsx": "^2.0.0",
    "daisyui": "^4.0.0",
    "drizzle-orm": "^0.45.2",
    "lucide-svelte": "^0.292.0",
    "svelte": "^4.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@astrojs/svelte": "^3.1.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.5.26",
    "prettier": "^3.1.0",
    "tailwindcss": "3.4.19",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
