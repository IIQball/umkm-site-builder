---
/**
 * Navbar.astro
 * Semantic navbar with theme toggle
 * Sticky header with navigation links and dark/light mode toggle
 */
import ThemeToggle from '@/components/common/ThemeToggle.astro';
---

<nav class="navbar bg-base-100/90 backdrop-blur-md border-b border-base-200 sticky top-0 z-40 shadow-sm transition-colors">
  <div class="flex-1 px-2">
    <a href="/" class="btn btn-ghost text-base sm:text-lg font-bold gap-2 px-2 hover:bg-base-200/60 rounded-xl">
      <div class="w-7 h-7 rounded-lg bg-blue-600 text-white flex items-center justify-center font-black text-sm shadow-sm">
        U
      </div>
      <span class="tracking-tight text-base-content">UMKM Builder</span>
    </a>
  </div>

  <div class="flex-none gap-2 px-2">
    <!-- Navigation Links -->
    <div class="hidden md:flex items-center gap-1.5">
      <a href="/" class="btn btn-ghost btn-sm rounded-lg text-xs font-medium text-base-content/80 hover:text-base-content">
        Beranda
      </a>
      <a href="/templates" class="btn btn-ghost btn-sm rounded-lg text-xs font-medium text-base-content/80 hover:text-base-content">
        Katalog Template
      </a>
      <a href="/builder/new" class="btn btn-primary btn-sm rounded-xl text-xs font-semibold gap-1.5 shadow-sm shadow-blue-600/20">
        <span class="material-symbols-outlined text-[16px]">add_circle</span>
        <span>Buat Template</span>
      </a>
    </div>

    <!-- Theme Toggle -->
    <ThemeToggle />

    <!-- Mobile Menu -->
    <div class="dropdown dropdown-end md:hidden">
      <button
        tabindex="0"
        class="btn btn-ghost btn-circle btn-sm"
        aria-label="Menu"
      >
        <span class="material-symbols-outlined text-[20px]">menu</span>
      </button>
      <ul
        tabindex="0"
        class="dropdown-content z-[1] menu p-2 shadow-lg bg-base-100 rounded-xl w-52 border border-base-200 space-y-1 mt-2 text-xs"
      >
        <li><a href="/" class="rounded-lg">Beranda</a></li>
        <li><a href="/templates" class="rounded-lg">Katalog Template</a></li>
        <li>
          <a href="/builder/new" class="font-semibold text-primary rounded-lg flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px]">add_circle</span>
            <span>Buat Template</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>
