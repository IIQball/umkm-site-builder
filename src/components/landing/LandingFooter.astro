---
/**
 * LandingFooter.astro
 * Premium Floating Glassmorphic Footer
 * High-end Vercel/Apple inspired layout featuring kinetic typography, 
 * real-time system status indicator, and interactive support bento card.
 */

interface NavLink {
  label: string;
  href: string;
  badge?: string;
}

interface NavGroup {
  title: string;
  links: NavLink[];
}

interface SocialLink {
  name: string;
  href: string;
  ariaLabel: string;
  iconPath: string;
}

const FOOTER_NAVIGATION_GROUPS: NavGroup[] = [
  {
    title: 'Solusi & Produk',
    links: [
      { label: 'Fitur Utama', href: '/#fitur' },
      { label: 'Koleksi Template', href: '/templates', badge: 'Populer' },
      { label: 'Harga & Paket', href: '/#pricing' },
      { label: 'Direktori UMKM', href: '/umkm', badge: 'Baru' },
    ]
  },
  {
    title: 'Platform',
    links: [
      { label: 'Masuk Akun', href: '/auth/login' },
      { label: 'Daftar Mitra Baru', href: '/auth/login?mode=register' },
      { label: 'Portal Desainer', href: '/auth/login?role=designer' },
    ]
  },
  {
    title: 'Bantuan & Legal',
    links: [
      { label: 'Pusat Bantuan', href: '#' },
      { label: 'Syarat & Ketentuan', href: '#' },
      { label: 'Kebijakan Privasi', href: '#' },
    ]
  }
];

const SOCIAL_LINKS: SocialLink[] = [
  {
    name: 'Instagram',
    href: 'https://instagram.com',
    ariaLabel: 'Ikuti Pinoka di Instagram',
    iconPath: 'M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z M17.5 6.5h.01 M2 7a5 5 0 0 1 5-5h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7z'
  },
  {
    name: 'WhatsApp',
    href: 'https://wa.me/6281234567890',
    ariaLabel: 'Hubungi CS Pinoka via WhatsApp',
    iconPath: 'M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z'
  },
  {
    name: 'Twitter',
    href: 'https://twitter.com',
    ariaLabel: 'Ikuti Pinoka di Twitter',
    iconPath: 'M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z'
  },
  {
    name: 'LinkedIn',
    href: 'https://linkedin.com',
    ariaLabel: 'Ikuti Pinoka di LinkedIn',
    iconPath: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z M2 9h4v12H2z M4 2a2 2 0 1 0 0 4 2 2 0 0 0 0-4z'
  }
];
---

<div class="px-4 pb-6 md:px-8 md:pb-8 relative">
  <footer class="lp-footer relative overflow-hidden rounded-[2.5rem] bg-slate-950 text-slate-300 border border-slate-800/80 shadow-2xl" role="contentinfo">
    
    <!-- Top Edge Glow Line -->
    <div class="absolute top-0 inset-x-0 h-[2px] bg-gradient-to-r from-transparent via-blue-500 to-emerald-400 opacity-80"></div>
    
    <!-- Ambient Radial Glow backdrop -->
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] md:w-[1000px] h-[350px] bg-gradient-to-b from-blue-600/20 via-sky-500/10 to-transparent blur-[120px] pointer-events-none"></div>

    <!-- Kinetic Typography Watermark -->
    <div class="absolute -bottom-8 -right-4 sm:right-8 select-none pointer-events-none opacity-[0.04] font-black text-[clamp(6rem,16vw,15rem)] tracking-tighter leading-none text-slate-100 uppercase font-heading">
      PINOKA
    </div>

    <div class="max-w-7xl mx-auto px-6 py-10 lg:px-12 lg:py-14 relative z-10">
      


      <!-- Main Layout Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 pb-12">
        
        <!-- Brand Info & Quick Support Bento Card (Spans 5 cols) -->
        <div class="lg:col-span-5 flex flex-col justify-between gap-8">
          <div>
            <a href="/" class="flex items-center group cursor-pointer w-fit mb-4" style="text-decoration: none;">
              <div class="relative flex items-center justify-center transition-all duration-300 group-hover:scale-105">
                <img 
                  src="/logo.webp" 
                  alt="Pinoka UMKM Builder Logo" 
                  class="h-10 w-auto object-contain drop-shadow-md" 
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-blue-500/30 blur-xl rounded-full scale-50 opacity-0 group-hover:scale-110 group-hover:opacity-100 transition-all duration-300 -z-10"></div>
              </div>
            </a>

            <p class="text-slate-400 text-sm leading-relaxed max-w-md">
              Platform pembuatan toko online UMKM terdepan di Banyuwangi. Pilih template karya desainer lokal, isi produk, dan mulai jualan online via WhatsApp dalam kurun hitungan menit.
            </p>
          </div>


        </div>

        <!-- Navigation Links Grid (Spans 7 cols) -->
        <div class="lg:col-span-7 grid grid-cols-2 sm:grid-cols-3 gap-8 pt-2">
          {FOOTER_NAVIGATION_GROUPS.map((group) => (
            <div class="flex flex-col gap-4">
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200">{group.title}</h3>
              <ul class="flex flex-col gap-3">
                {group.links.map((link) => (
                  <li>
                    <a 
                      href={link.href} 
                      class="text-xs font-medium text-slate-400 hover:text-white transition-colors duration-200 inline-flex items-center gap-2 group/link"
                    >
                      <span class="w-1.5 h-1.5 rounded-full bg-blue-500 opacity-0 group-hover/link:opacity-100 transition-all duration-200 -ml-3 group-hover/link:ml-0"></span>
                      <span>{link.label}</span>
                      {link.badge && (
                        <span class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-blue-500/20 text-blue-400 border border-blue-500/30">
                          {link.badge}
                        </span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- Bottom Bar: Copyright & Social Media Icons -->
      <div class="pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-slate-400 text-xs text-center sm:text-left">
          &copy; {new Date().getFullYear()} <span class="text-slate-200 font-semibold">Pinoka</span>. Dibuat oleh tim gombalan mamel untuk pedagang lokal Banyuwangi.
        </p>

        <!-- Social Media Floating Buttons -->
        <div class="flex items-center gap-2.5">
          {SOCIAL_LINKS.map((social) => (
            <a 
              href={social.href} 
              target="_blank" 
              rel="noopener noreferrer" 
              aria-label={social.ariaLabel}
              class="w-9 h-9 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-400 hover:text-white hover:bg-blue-600 hover:border-blue-500 transition-all duration-300 hover:-translate-y-1 shadow-sm"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={social.iconPath} />
              </svg>
            </a>
          ))}
        </div>
      </div>

    </div>
  </footer>
</div>



<style>
  .lp-footer {
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
  }
</style>

