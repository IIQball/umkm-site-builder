---
// LandingHero.astro
---

<section class="relative min-h-[100dvh] flex items-center justify-center overflow-hidden bg-canvas dark:bg-[#030712] text-center -mt-16 pt-32 pb-20" aria-label="Hero Pinoka">
  <!-- Animated Background Video -->
  <video
    src="/assets/video-pinoka.mp4"
    autoplay
    loop
    muted
    playsinline
    class="absolute inset-0 w-full h-full object-cover z-0 opacity-15 dark:opacity-30 pointer-events-none scale-105 transition-opacity duration-700"
    aria-hidden="true"
  ></video>

  <!-- Solid Vignette Overlay (Clean Header Transition without heavy glass filter) -->
  <div class="absolute top-0 left-0 right-0 h-40 bg-gradient-to-b from-canvas via-canvas/80 to-transparent dark:from-[#030712] dark:via-[#030712]/85 dark:to-transparent pointer-events-none z-10" aria-hidden="true"></div>

  <!-- Tech Grid Texture Pattern -->
  <div class="absolute inset-0 pointer-events-none z-0 [background-image:radial-gradient(rgba(0,0,0,0.06)_1px,transparent_1px)] dark:[background-image:radial-gradient(rgba(255,255,255,0.05)_1px,transparent_1px)] bg-[size:28px_28px] [mask-image:linear-gradient(to_bottom,transparent,rgba(0,0,0,0.5)_20%,rgba(0,0,0,0.5)_80%,transparent)]" aria-hidden="true"></div>

  <!-- Bottom Fade Overlay -->
  <div class="absolute bottom-0 left-0 right-0 h-[220px] bg-gradient-to-b from-transparent via-canvas/60 to-canvas dark:via-[#030712]/70 dark:to-[#030712] pointer-events-none z-10" aria-hidden="true"></div>

  <div class="relative z-20 max-w-[920px] px-6 flex flex-col items-center gap-6 my-auto">
    <!-- Short & Punchy Headline (Strictly 2 Lines) -->
    <h1 class="font-heading text-[clamp(2.5rem,5.2vw,4.5rem)] font-extrabold tracking-tight leading-[1.12] text-main dark:text-slate-50 m-0 opacity-0 animate-pinoka-enter [animation-delay:60ms]">
      Toko Online UMKM.<br />
      <span class="text-primary font-extrabold">Pesanan via WhatsApp.</span>
    </h1>

    <!-- Subtitle -->
    <p class="text-[clamp(1rem,1.4vw,1.15rem)] text-secondary dark:text-slate-300 leading-relaxed max-w-[46ch] m-0 font-sans font-normal opacity-0 animate-pinoka-enter [animation-delay:120ms]">
      Pilih template desainer lokal, atur produk Anda, dan terima pesanan WhatsApp tanpa komisi.
    </p>

    <!-- CTAs (Solid & Clean, No iPhone Glass Effect) -->
    <div class="flex flex-wrap gap-4 justify-center mt-2 opacity-0 animate-pinoka-enter [animation-delay:180ms]">
      <a href="/auth/login?mode=register&role=merchant" class="inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-full text-[0.9375rem] font-bold font-heading no-underline whitespace-nowrap bg-primary text-white shadow-md transition-all duration-200 ease-out hover:-translate-y-0.5 hover:bg-primary-dark active:scale-[0.98]" id="hero-cta-merchant">
        Mulai Buat Toko
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      <a href="/auth/login?mode=register&role=designer" class="inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-full text-[0.9375rem] font-bold font-heading no-underline whitespace-nowrap bg-card text-main border border-border hover:bg-nested dark:bg-slate-900 dark:text-slate-100 dark:border-slate-800 dark:hover:bg-slate-800 transition-all duration-200 ease-out hover:-translate-y-0.5 active:scale-[0.98]" id="hero-cta-designer">
        Gabung sebagai Desainer
      </a>
    </div>

    <!-- Trust Highlights -->
    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-muted dark:text-slate-400 font-medium opacity-0 animate-pinoka-enter [animation-delay:240ms]">
      <span class="inline-flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        Gratis Selamanya
      </span>
      <span class="inline-flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        Tanpa Komisi Penjualan
      </span>
      <span class="inline-flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        Siap Pakai 5 Menit
      </span>
    </div>
  </div>
</section>
