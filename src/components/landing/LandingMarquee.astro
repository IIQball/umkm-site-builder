---
/**
 * LandingMarquee.astro
 * Infinite CSS marquee showcasing actual Website UI Mockups corresponding to UMKM categories.
 */
// Rich Mockup data for website showcase landing pages per category
const WEBSITE_MOCKUPS: Record<string, {
  storeName: string;
  domain: string;
  category: string;
  headline: string;
  productName: string;
  priceTag: string;
  heroImg: string;
  tagColor: string;
}> = {
  'f-b': {
    storeName: 'Warung Kopi Ijen',
    domain: 'kopi-ijen.pinoka.id',
    category: 'Kuliner & F&B',
    headline: 'Kopi Robusta Asli Sangrai Segar',
    productName: 'Biji Kopi Robusta Ijen 250g',
    priceTag: 'Rp 28.000',
    heroImg: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80',
    tagColor: 'bg-amber-500',
  },
  'fashion': {
    storeName: 'Batik Asri Banyuwangi',
    domain: 'batik-asri.pinoka.id',
    category: 'Fashion & Busana',
    headline: 'Kain Batik Tulis Motif Gajah Oling',
    productName: 'Batik Tulis Handmade Premium',
    priceTag: 'Rp 250.000',
    heroImg: 'https://images.unsplash.com/photo-1544441893-675973e31985?auto=format&fit=crop&w=600&q=80',
    tagColor: 'bg-purple-500',
  },
  'kesehatan': {
    storeName: 'Apotek Sehat Herbal',
    domain: 'sehat-herbal.pinoka.id',
    category: 'Kesehatan & Herbal',
    headline: 'Madu Murni Organik BPOM',
    productName: 'Madu Hutan Liar 500ml',
    priceTag: 'Rp 45.000',
    heroImg: 'https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?auto=format&fit=crop&w=600&q=80',
    tagColor: 'bg-emerald-500',
  },
  'jasa': {
    storeName: 'Kilat Express Laundry',
    domain: 'laundry-kilat.pinoka.id',
    category: 'Jasa & Layanan',
    headline: 'Cuci & Setrika Express 3 Jam',
    productName: 'Paket Cuci Kiloan Super Clean',
    priceTag: 'Rp 7.000/kg',
    heroImg: 'https://images.unsplash.com/photo-1545173168-9f1947eebb7f?auto=format&fit=crop&w=600&q=80',
    tagColor: 'bg-blue-500',
  },
  'kerajinan': {
    storeName: 'Craft Bambu Nusantara',
    domain: 'bambu-craft.pinoka.id',
    category: 'Kerajinan Tangan',
    headline: 'Anyaman Bambu Tradisional',
    productName: 'Teko & Cangkir Bambu Handmade',
    priceTag: 'Rp 35.000',
    heroImg: 'https://images.unsplash.com/photo-1513519245088-0e12902e5a38?auto=format&fit=crop&w=600&q=80',
    tagColor: 'bg-orange-500',
  },
  'retail': {
    storeName: 'Warm Bakery & Roti',
    domain: 'warm-bakery.pinoka.id',
    category: 'Bakery & Roti',
    headline: 'Roti Sobek Fresh Oven Setiap Hari',
    productName: 'Roti Sobek Cokelat Keju',
    priceTag: 'Rp 18.000',
    heroImg: 'https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=600&q=80',
    tagColor: 'bg-yellow-500',
  },
  'kecantikan': {
    storeName: 'Glow Skin Skincare',
    domain: 'glowskin.pinoka.id',
    category: 'Kecantikan',
    headline: 'Serum Brightening Herbal Organik',
    productName: 'Glowing Face Serum 30ml',
    priceTag: 'Rp 85.000',
    heroImg: 'https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=600&q=80',
    tagColor: 'bg-pink-500',
  },
  'otomotif': {
    storeName: 'Bengkel Maju Motor',
    domain: 'maju-motor.pinoka.id',
    category: 'Otomotif & Sparepart',
    headline: 'Servis Motor & Sparepart Asli',
    productName: 'Oli Mesin Matic Premium 1L',
    priceTag: 'Rp 55.000',
    heroImg: 'https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=600&q=80',
    tagColor: 'bg-cyan-500',
  },
};

const defaultWebsitesList = Object.values(WEBSITE_MOCKUPS);
const websiteCardsToShow = defaultWebsitesList;

// Duplicate items for smooth infinite horizontal marquee loop
const marqueeItems = [...websiteCardsToShow, ...websiteCardsToShow, ...websiteCardsToShow];
---

<section class="group relative bg-canvas py-16 overflow-hidden border-y border-border" aria-label="Hasil Tampilan Website UMKM">
  <div class="max-w-7xl mx-auto px-6 mb-8 text-center">
    <h3 class="text-xs font-bold tracking-[0.12em] text-muted uppercase font-heading m-0">
      Hasil Tampilan Website Toko UMKM per Kategori Bisnis
    </h3>
  </div>

  <!-- Marquee Container with Generous Vertical Padding so Hover State Never Clips -->
  <div class="overflow-hidden py-4 [mask-image:linear-gradient(to_right,transparent,black_6%,black_94%,transparent)]" aria-hidden="true">
    <div class="flex gap-6 w-max animate-lp-marquee hover:[animation-play-state:paused] px-4">
      {marqueeItems.map((site) => (
        <div class="flex-shrink-0 w-[320px] rounded-2xl overflow-hidden bg-card border border-border shadow-sm transition-all duration-300 hover:border-primary/60 hover:shadow-xl hover:-translate-y-2 group/card cursor-pointer">
          <!-- Window Header Bar (Neutral Computer Browser Decoration) -->
          <div class="bg-slate-900 text-slate-300 px-3.5 py-1.5 border-b border-slate-800 flex items-center justify-between font-mono text-[10px]">
            <div class="flex items-center gap-1.5 text-slate-400">
              <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <span class="bg-slate-950 border border-slate-800 rounded px-2.5 py-0.5 text-slate-300 font-mono text-[10px] truncate max-w-[190px]">
              https://{site.domain}
            </span>
            <span class="text-[9px] text-slate-500">Live</span>
          </div>

          <!-- Website Real Store Preview Card Screen -->
          <div class="relative h-[210px] bg-slate-950 text-white overflow-hidden p-4 flex flex-col justify-between font-sans">
            <!-- Full Bleed Store Image Background -->
            <img
              src={site.heroImg}
              alt={site.storeName}
              class="absolute inset-0 w-full h-full object-cover z-0 transition-transform duration-700 ease-out group-hover/card:scale-105"
              loading="lazy"
            />

            <!-- Dark Overlay Vignette for Readability -->
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/70 to-slate-950/40 z-10"></div>

            <!-- Top Screen Header Bar (Live Badge & Category) -->
            <div class="relative z-20 flex items-center justify-between">
              <span class="inline-flex items-center gap-1.5 bg-emerald-500/90 text-white px-2 py-0.5 rounded-full text-[9px] font-bold font-mono shadow-xs">
                <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                Toko Aktif
              </span>
              <span class="bg-black/60 backdrop-blur-xs text-white/90 px-2 py-0.5 rounded text-[9px] font-semibold border border-white/10">
                {site.category}
              </span>
            </div>

            <!-- Bottom Screen Content (Store Title, Product, Price & Order Button) -->
            <div class="relative z-20 flex flex-col gap-1 mt-auto">
              <span class="text-[10px] font-bold text-cyan-300 font-heading uppercase tracking-wide">
                {site.storeName}
              </span>
              <h4 class="text-sm font-extrabold text-white leading-tight font-heading m-0 line-clamp-1">
                {site.headline}
              </h4>
              <p class="text-[11px] text-slate-200 line-clamp-1 m-0 font-normal">
                {site.productName}
              </p>

              <div class="pt-2 flex items-center justify-between">
                <span class="text-xs font-black text-amber-300 font-mono bg-amber-400/20 px-2 py-0.5 rounded border border-amber-400/30">
                  {site.priceTag}
                </span>
                <span class="inline-flex items-center gap-1 bg-emerald-600 text-white px-2.5 py-1 rounded-lg text-[10px] font-bold shadow-xs hover:bg-emerald-500 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.705 1.754zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
                  Pesan WA
                </span>
              </div>
            </div>
          </div>

          <!-- Bottom Outer Footer Info Bar -->
          <div class="p-3.5 bg-card flex items-center justify-between border-t border-border">
            <div class="flex flex-col min-w-0">
              <span class="text-xs font-bold text-main font-heading truncate">
                {site.storeName}
              </span>
              <span class="text-[11px] text-muted truncate">
                Website Storefront {site.category}
              </span>
            </div>
            <span class="text-[11px] font-bold text-primary bg-primary/10 px-2.5 py-1 rounded-full border border-primary/20 shrink-0">
              Lihat Demo &rarr;
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
