---
/**
 * LandingTestimonials.astro
 * High-contrast, clean 3-testimonial showcase featuring real Merchant & Designer reviews.
 */

const reviews = [
  {
    name: 'Budi Santoso',
    role: 'Pemilik Warung Kopi Sejahtera',
    location: 'Banyuwangi',
    badge: 'Merchant',
    avatar: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=150&q=80',
    content:
      'Dulu pesanan cuma via DM Instagram, sering kelewatan dan catat manual. Pakai Pinoka, toko online WhatsApp saya langsung jadi dalam 10 menit. Omzet bulanan naik lebih dari 40%!',
    rating: 5,
  },
  {
    name: 'Siti Rahmawati',
    role: 'UI Designer & Web Creator',
    location: 'Banyuwangi Creative Studio',
    badge: 'Desainer',
    avatar: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=150&q=80',
    content:
      'Sebagai desainer lokal, Pinoka memberikan pasif income yang nyata. Sekali buat template toko, hasilnya terus mengalir tiap kali ada UMKM yang menggunakan template saya.',
    rating: 5,
  },
  {
    name: 'Dewi Lestari',
    role: 'Owner Batik Asri Banyuwangi',
    location: 'Banyuwangi',
    badge: 'Merchant',
    avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80',
    content:
      'Tampilan websitenya sangat cepat diakses dan terkesan mahal. Pelanggan dari luar kota makin percaya pesan kain batik tulis premium karena toko onlinenya sangat profesional.',
    rating: 5,
  },
];
---

<section class="py-24 px-6 border-t border-light bg-nested/50 dark:bg-white/5" aria-labelledby="testimonials-heading">
  <div class="max-w-[1100px] mx-auto flex flex-col gap-14">
    <!-- Section Header -->
    <div class="text-center opacity-0 animate-lp-fade-up">
      <h2 class="font-heading text-[clamp(1.875rem,4vw,3rem)] font-extrabold tracking-tight leading-tight text-main mb-4" id="testimonials-heading">
        Dipercaya oleh UMKM & Desainer Lokal
      </h2>
      <p class="text-[1.0625rem] text-muted max-w-[54ch] mx-auto leading-relaxed">
        Dengar langsung pengalaman dari pemilik bisnis dan desainer yang telah berkembang bersama platform kami.
      </p>
    </div>

    <!-- 3 Card Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      {reviews.map((rev) => (
        <div class="flex flex-col justify-between p-7 rounded-3xl bg-card border border-light shadow-sm transition-all duration-300 hover:shadow-md hover:border-primary/30 group">
          <!-- Rating Stars & Badge -->
          <div class="flex items-center justify-between gap-2 mb-5">
            <div class="flex items-center gap-1 text-amber-400">
              {Array.from({ length: rev.rating }).map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                </svg>
              ))}
            </div>
            <span class={`text-3xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-full border ${
              rev.badge === 'Desainer'
                ? 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20'
                : 'bg-primary/10 text-primary border-primary/20'
            }`}>
              {rev.badge}
            </span>
          </div>

          <!-- Quote Content -->
          <blockquote class="text-body-base text-main dark:text-slate-200 leading-relaxed font-sans mb-8 flex-1 italic">
            "{rev.content}"
          </blockquote>

          <!-- Author Info Footer -->
          <div class="flex items-center gap-3.5 pt-5 border-t border-light/60">
            <img
              src={rev.avatar}
              alt={rev.name}
              class="w-11 h-11 rounded-full object-cover border border-light shrink-0"
              loading="lazy"
            />
            <div class="flex flex-col min-w-0">
              <span class="text-xs font-bold text-main font-heading truncate">
                {rev.name}
              </span>
              <span class="text-3xs text-muted truncate">
                {rev.role}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
