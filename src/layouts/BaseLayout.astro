---
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'UMKM Site Builder', description = 'No-code SaaS for Indonesian micro-enterprises' } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* Ensure body takes full height */
  html,
  body {
    height: 100%;
    width: 100%;
  }
</style>
