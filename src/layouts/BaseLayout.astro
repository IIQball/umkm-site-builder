---
import '@/styles/global.css'
import Navbar from '@/components/common/Navbar.astro'
import ToastContainer from '@/components/ui/ToastContainer.svelte'
import RateLimitAlert from '@/components/ui/RateLimitAlert.svelte'
import SmoothScroll from '@/components/common/SmoothScroll.svelte'
import LandingMarquee from '@/components/landing/LandingMarquee.svelte'

interface Props {
  title?: string
  description?: string
  image?: string
  type?: string
  noindex?: boolean
  hideNavbar?: boolean
  customMarquee?: boolean
  hideToasts?: boolean
}

const {
  title = 'Pinoka - Platform Digitalisasi Visual Produk Lokal Banyuwangi',
  description = 'Platform kolaborasi modern yang mempertemukan UMKM Banyuwangi dan desainer kreatif untuk mendigitalisasi visual produk lokal.',
  image = '/og-image.png',
  type = 'website',
  noindex = false,
  hideNavbar = false,
  customMarquee = false,
  hideToasts = false
} = Astro.props

const siteUrl = Astro.url.origin
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href
const ogImageUrl = new URL(image, siteUrl).href
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <title>{title}</title>

    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/svg+xml" href="/icon-512x512.svg" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#36C6FD" />
    <meta name="apple-mobile-web-app-title" content="Pinoka" />
    <meta name="application-name" content="Pinoka" />

    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
    <meta property="og:site_name" content="Pinoka" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Schema.org JSON-LD for AI Search Agents (ChatGPT, Perplexity, Gemini) & Search Engines -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${siteUrl}/#website`,
          "url": siteUrl,
          "name": "Pinoka",
          "description": description,
          "inLanguage": "id-ID",
          "publisher": {
            "@id": `${siteUrl}/#organization`
          }
        },
        {
          "@type": "Organization",
          "@id": `${siteUrl}/#organization`,
          "name": "Pinoka",
          "url": siteUrl,
          "logo": {
            "@type": "ImageObject",
            "url": `${siteUrl}/icon-512x512.svg`,
            "width": "512",
            "height": "512"
          },
          "image": ogImageUrl,
          "description": "Platform SaaS No-Code & Kurasi Visual Toko Online UMKM Banyuwangi"
        }
      ]
    })} />

    <!-- Preconnect to Google Fonts CDN -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Host+Grotesk:wght@700..800&family=Poppins:wght@400..600&display=swap" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Host+Grotesk:wght@700..800&family=Poppins:wght@400..600&display=swap">
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200">
    </noscript>

    <!-- Preload Hero Sequence Frame 1 (Responsive for Desktop & Mobile) -->
    <link
      rel="preload"
      as="image"
      href="/frames/frame_0001_sm.webp"
      media="(max-width: 768px)"
      fetchpriority="high"
      type="image/webp"
    />
    <link
      rel="preload"
      as="image"
      href="/frames/frame_0001.webp"
      media="(min-width: 769px)"
      fetchpriority="high"
      type="image/webp"
    />

    <!-- Preload Critical Above-The-Fold Heading & Body Fonts (Instant LCP) -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="https://fonts.gstatic.com/s/hostgrotesk/v5/co3BmWBnlCJ3U42vbbfdwMjZpFjm.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="https://fonts.gstatic.com/s/poppins/v24/pxiByp8kv8JHgFVrLEj6Z1xlFQ.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="https://fonts.gstatic.com/s/poppins/v24/pxiEyp8kv8JHgFVrJJfecg.woff2"
      crossorigin
    />

    <!-- Inlined Critical @font-face to eliminate font discovery delay for instant paint -->
    <style is:inline>
      @font-face {
        font-family: 'Host Grotesk';
        font-style: normal;
        font-weight: 700 800;
        font-display: swap;
        src: url(https://fonts.gstatic.com/s/hostgrotesk/v5/co3BmWBnlCJ3U42vbbfdwMjZpFjm.woff2) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Poppins';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url(https://fonts.gstatic.com/s/poppins/v24/pxiEyp8kv8JHgFVrJJfecg.woff2) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Poppins';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url(https://fonts.gstatic.com/s/poppins/v24/pxiByp8kv8JHgFVrLEj6Z1xlFQ.woff2) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      astro-island {
        display: block;
      }
    </style>
    
    <!-- Anti-flicker theme script - runs before DOM renders -->
    <script is:inline>
      const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
      document.documentElement.setAttribute('data-theme', theme)
      if (theme === 'dark') {
        document.documentElement.classList.add('dark')
      } else {
        document.documentElement.classList.remove('dark')
      }
    </script>
  </head>
  <body class="overflow-x-clip">
    <SmoothScroll client:load />
    {!hideToasts && <ToastContainer client:idle />}
    {!hideToasts && <RateLimitAlert client:idle />}
    {hideNavbar && !customMarquee && <LandingMarquee client:load />}
    {!hideNavbar && (
      <div class="sticky top-0 inset-x-0 z-50 w-full flex flex-col">
        {!customMarquee && <LandingMarquee client:load />}
        <Navbar />
      </div>
    )}
    <div id="base-content-container">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  html,
  body {
    min-height: 100%;
    width: 100%;
  }
</style>
