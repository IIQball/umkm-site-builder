---
import globalCssUrl from '@/styles/global.css?url';
import criticalCSS from '@/styles/critical.css?raw';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Toko Online Resmi UMKM — Didukung oleh Pinoka',
  image = '/og-image.png',
} = Astro.props;

const siteUrl = Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(image, siteUrl).href;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/svg+xml" href="/icon-512x512.svg" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#36C6FD" />

    <!-- Open Graph / WhatsApp Social Share -->
    <meta property="og:site_name" content="Pinoka Storefront" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    
    {/* Inline critical CSS — immediate render above the fold */}
    <style is:inline set:html={criticalCSS} />

    {/* Non-render-blocking Global CSS via preload + media switch */}
    <link rel="preload" href={globalCssUrl} as="style" />
    <link rel="stylesheet" href={globalCssUrl} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={globalCssUrl} />
    </noscript>
    
    {/* Preconnect to external resources */}
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Anti-flicker theme script - runs before DOM renders -->
    <script is:inline>
      const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased overflow-x-clip">
    <div id="base-content-container">
      <slot />
    </div>

    <!-- Lightweight Zero-Overhead Storefront Interactions -->
    <script is:inline>
      document.addEventListener('click', function(e) {
        // 1. Mobile Menu Drawer Toggle
        var menuBtn = e.target.closest('button[aria-label*="menu navigasi"]');
        if (menuBtn) {
          var drawer = document.getElementById('header-mobile-drawer');
          if (drawer) {
            var isHidden = drawer.classList.contains('hidden');
            if (isHidden) {
              drawer.classList.remove('hidden');
              drawer.classList.add('block');
              menuBtn.setAttribute('aria-label', 'Tutup menu navigasi');
              menuBtn.setAttribute('aria-expanded', 'true');
            } else {
              drawer.classList.add('hidden');
              drawer.classList.remove('block');
              menuBtn.setAttribute('aria-label', 'Buka menu navigasi');
              menuBtn.setAttribute('aria-expanded', 'false');
            }
          }
          return;
        }

        // Auto-close drawer on clicking any navigation link inside it
        var drawerLink = e.target.closest('#header-mobile-drawer a');
        if (drawerLink) {
          var drawer = document.getElementById('header-mobile-drawer');
          if (drawer) {
            drawer.classList.add('hidden');
            drawer.classList.remove('block');
            var btn = document.querySelector('button[aria-label*="menu navigasi"]');
            if (btn) {
              btn.setAttribute('aria-label', 'Buka menu navigasi');
              btn.setAttribute('aria-expanded', 'false');
            }
          }
          return;
        }

        // 2. Theme Toggle (Light/Dark mode)
        var themeBtn = e.target.closest('button[aria-label*="tema"]');
        if (themeBtn) {
          var current = document.documentElement.getAttribute('data-theme') || (document.documentElement.classList.contains('dark') ? 'dark' : 'light');
          var next = current === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          document.documentElement.classList.toggle('dark', next === 'dark');
          try { localStorage.setItem('theme', next); } catch (err) {}
          return;
        }
      });
    </script>
  </body>
</html>
