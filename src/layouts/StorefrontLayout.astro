---
import BaseLayout from './BaseLayout.astro';
import type { Store } from '@/types/store'; // Asumsi ada tipe Store

interface Props {
  store?: Store;
  title?: string;
  description?: string;
}

const { store, title, description } = Astro.props;
const defaultTitle = store?.name ? `${store.name} - Storefront` : 'Storefront';
---

<BaseLayout title={title || defaultTitle} description={description || store?.description || ''}>
  <header class="bg-primary text-primary-content p-4">
    <div class="container mx-auto">
      <h1 class="text-2xl font-bold">{store?.name || 'Storefront'}</h1>
    </div>
  </header>
  
  <main class="container mx-auto p-4 min-h-screen">
    <slot />
  </main>
  
  <footer class="bg-base-200 text-base-content p-4 mt-8">
    <div class="container mx-auto text-center">
      <p>&copy; {new Date().getFullYear()} {store?.name || 'Storefront'}. All rights reserved.</p>
    </div>
  </footer>
</BaseLayout>
