---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="404 Tidak Ditemukan">
  <div class="flex flex-col items-center justify-center min-h-screen text-center px-4">
    <h1 class="text-6xl font-bold text-base-content mb-4">404</h1>
    <p class="text-xl mb-6 text-base-content/70">Halaman yang Anda cari tidak dapat ditemukan atau telah dipindahkan.</p>
    <a href="/" class="btn btn-primary">Kembali ke Beranda</a>
  </div>
</BaseLayout>
