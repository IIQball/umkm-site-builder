---
import { getAuthenticatedUser, isSuperAdmin } from "@/lib/auth";

export const prerender = false;

const user = await getAuthenticatedUser(Astro.request);
if (!user) {
  return Astro.redirect("/auth/login?redirect=/superadmin/ai-monitoring");
}

if (isSuperAdmin(user)) {
  return Astro.redirect("/superadmin/ai-monitoring");
}

// Monitoring AI eksklusif untuk superadmin. Admin dialihkan ke dashboard utama admin.
return Astro.redirect("/admin");
---
