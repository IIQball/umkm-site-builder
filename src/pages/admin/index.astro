---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { getAuthenticatedUser } from '@/lib/auth';
import AdminAssistedStores from '@/components/admin/AdminAssistedStores.svelte';
import AdminBankManager from '@/components/admin/AdminBankManager.svelte';
import AdminMetricsOverview from '@/components/admin/AdminMetricsOverview.svelte';
import { db } from '@/lib/db/client';
import { stores, users } from '@/db/schema';
import { eq, and, isNull, desc } from 'drizzle-orm';

export const prerender = false;

const user = await getAuthenticatedUser(Astro.request);
if (!user || user.role !== 'admin') {
  return Astro.redirect('/auth/login?redirect=/admin');
}

const isSuper = user.role === 'superadmin';

let assistedStores: Array<{
  id: string;
  name: string;
  subdomain: string;
  status: string;
  userId: string;
  createdAt: string;
  tenantName: string | null;
  tenantEmail: string | null;
  owner: {
    id: string;
    name: string | null;
    email: string;
  };
}> = [];

if (!isSuper) {
  try {
    const rows = await db
      .select({
        id: stores.id,
        name: stores.name,
        subdomain: stores.subdomain,
        status: stores.status,
        userId: stores.userId,
        createdAt: stores.createdAt,
        tenantName: users.name,
        tenantEmail: users.email,
      })
      .from(stores)
      .leftJoin(users, eq(stores.userId, users.id))
      .where(and(eq(stores.registeredBy, user.id), isNull(stores.deletedAt)))
      .orderBy(desc(stores.createdAt));

    assistedStores = (rows || []).map((s) => ({
      id: s.id,
      name: s.name,
      subdomain: s.subdomain,
      status: s.status,
      userId: s.userId,
      tenantName: s.tenantName,
      tenantEmail: s.tenantEmail,
      createdAt: s.createdAt ? s.createdAt.toISOString() : new Date().toISOString(),
      owner: {
        id: s.userId,
        name: s.tenantName,
        email: s.tenantEmail ?? '-',
      },
    }));
  } catch (error) {
    console.error('[AdminDashboard] Failed to query assisted stores:', error);
    assistedStores = [];
  }
}

const currentHour = new Date().getHours();
let greeting = 'Selamat Datang';
if (currentHour >= 4 && currentHour < 11) {
  greeting = 'Selamat Pagi';
} else if (currentHour >= 11 && currentHour < 15) {
  greeting = 'Selamat Siang';
} else if (currentHour >= 15 && currentHour < 18.5) {
  greeting = 'Selamat Sore';
} else {
  greeting = 'Selamat Malam';
}

const pageTitle = isSuper ? 'Dasbor Super Admin' : 'Dasbor Admin Pendamping';
---

<DashboardLayout title={pageTitle} breadcrumb="Dashboard">
  <div class="min-h-full space-y-8 md:space-y-10 pb-10">
    <!-- Header Section with Distinct Role Badges -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2 border-b border-light">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-heading-lg text-main font-bold tracking-tight">
            <span>{greeting}, {user.name ? user.name.split(' ')[0] : (isSuper ? 'Super Admin' : 'Admin')}!</span>
          </h1>
          {isSuper ? (
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-2xs font-extrabold tracking-wider uppercase bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20 shadow-2xs">
              <span class="material-symbols-outlined text-xs">shield_person</span>
              <span>Super Admin</span>
            </span>
          ) : (
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-2xs font-extrabold tracking-wider uppercase bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 shadow-2xs">
              <span class="material-symbols-outlined text-xs">admin_panel_settings</span>
              <span>Admin Pendamping</span>
            </span>
          )}
        </div>
        <p class="text-body-base text-secondary mt-1.5 max-w-3xl leading-relaxed">
          {isSuper
            ? 'Pusat kendali ekosistem platform: kurasi template, kelola akses admin, manajemen pengguna, dan ringkasan metrik global.'
            : 'Pusat aktivitas operasional pendampingan UMKM, pengelolaan rekening pencairan komisi, dan monitoring toko binaan Anda.'}
        </p>
      </div>

      <!-- Quick Action Badges -->
      <div class="flex items-center gap-2 flex-shrink-0">
        {isSuper ? (
          <a
            href="/admin/whitelist"
            class="px-4 py-2 rounded-2xl bg-nested border border-light text-main text-xs font-bold hover:bg-card hover:border-primary/40 transition-all flex items-center gap-2 shadow-2xs"
          >
            <span class="material-symbols-outlined text-base text-primary">admin_panel_settings</span>
            <span>Akses Whitelist</span>
          </a>
        ) : (
          <a
            href="/admin/merchants"
            class="px-4 py-2 rounded-2xl bg-orange text-white text-xs font-bold hover:bg-orange/90 transition-all flex items-center gap-2 shadow-xs"
          >
            <span class="material-symbols-outlined text-base">storefront</span>
            <span>Kelola Merchant</span>
          </a>
        )}
      </div>
    </div>

    <div class="space-y-8">
      <!-- Section 1: Bank Accounts Manager (Admin can add up to 3 bank accounts like designer) -->
      <div class="p-6 rounded-3xl bg-card border border-light shadow-xs space-y-4">
        <AdminBankManager client:load />
      </div>

      <!-- Section 2: Toko Binaan Saya (Assisted Stores) -->
      <div>
        <AdminAssistedStores client:load stores={assistedStores} currentUser={user} />
      </div>

      <!-- Section 3: Overview Metrik Transaksi & Layanan -->
      <div class="pt-2">
        <div class="mb-4">
          <h2 class="text-lg font-bold text-main font-heading">Ringkasan Aktivitas & Layanan</h2>
          <p class="text-xs text-secondary mt-0.5">Monitoring transaksi toko UMKM dan aktivitas sistem.</p>
        </div>
        <AdminMetricsOverview client:load isSuperAdmin={false} />
      </div>
    </div>
  </div>
</DashboardLayout>
