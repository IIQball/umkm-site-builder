---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { getAuthenticatedUser, isAuthorizedAdmin } from '@/lib/auth';
import AdminMetricsOverview from '@/components/admin/AdminMetricsOverview.svelte';
import AdminAssistedStores from '@/components/admin/AdminAssistedStores.svelte';
import { db } from '@/lib/db/client';
import { stores, users } from '@/db/schema';
import { eq, and, isNull, desc } from 'drizzle-orm';

export const prerender = false;

const user = await getAuthenticatedUser(Astro.request);
if (!user || !isAuthorizedAdmin(user)) {
  return Astro.redirect('/auth/login?redirect=/admin');
}

let assistedStores: Array<{
  id: string;
  name: string;
  subdomain: string;
  status: string;
  userId: string;
  createdAt: string;
  tenantName: string | null;
  tenantEmail: string | null;
  owner: {
    id: string;
    name: string | null;
    email: string;
  };
}> = [];

try {
  const rows = await db
    .select({
      id: stores.id,
      name: stores.name,
      subdomain: stores.subdomain,
      status: stores.status,
      userId: stores.userId,
      createdAt: stores.createdAt,
      tenantName: users.name,
      tenantEmail: users.email,
    })
    .from(stores)
    .leftJoin(users, eq(stores.userId, users.id))
    .where(and(eq(stores.registeredBy, user.id), isNull(stores.deletedAt)))
    .orderBy(desc(stores.createdAt));

  assistedStores = (rows || []).map((s) => ({
    id: s.id,
    name: s.name,
    subdomain: s.subdomain,
    status: s.status,
    userId: s.userId,
    tenantName: s.tenantName,
    tenantEmail: s.tenantEmail,
    createdAt: s.createdAt ? s.createdAt.toISOString() : new Date().toISOString(),
    owner: {
      id: s.userId,
      name: s.tenantName,
      email: s.tenantEmail ?? '-',
    },
  }));
} catch (error) {
  console.error('[AdminDashboard] Failed to query assisted stores:', error);
  assistedStores = [];
}

const currentHour = new Date().getHours();
let greeting = 'Selamat Datang';
if (currentHour >= 4 && currentHour < 11) {
  greeting = 'Selamat Pagi';
} else if (currentHour >= 11 && currentHour < 15) {
  greeting = 'Selamat Siang';
} else if (currentHour >= 15 && currentHour < 18.5) {
  greeting = 'Selamat Sore';
} else {
  greeting = 'Selamat Malam';
}
---

<DashboardLayout title="Admin Dashboard" breadcrumb="Dashboard">
  <div class="min-h-full space-y-8 md:space-y-10 pb-10">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2">
      <div>
        <h1 class="text-heading-lg text-main font-bold tracking-tight flex items-center gap-2.5">
          <span>{greeting}, {user.name ? user.name.split(' ')[0] : 'Admin'}!</span>
        </h1>
        <p class="text-body-base text-secondary mt-1 max-w-2xl leading-relaxed">
          Berikut adalah rangkuman metrik sistem, pendapatan, dan pengelolaan toko UMKM binaan Anda.
        </p>
      </div>
    </div>

    <!-- Toko Binaan Saya -->
    <AdminAssistedStores client:load stores={assistedStores} />

    <!-- Metrik Sistem & Transaksi -->
    <AdminMetricsOverview client:load />
  </div>
</DashboardLayout>
