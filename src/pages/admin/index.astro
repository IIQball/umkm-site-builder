---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { getAuthenticatedUser, isAuthorizedAdmin } from '@/lib/auth';
import Button from '@/components/ui/Button.svelte';
import AdminOverviewDashboard from '@/components/admin/dashboard/AdminOverviewDashboard.svelte';
import { getDesignerWalletSummary } from '@/services';
import { db } from '@/lib/db/client';
import { users, stores, transactions, templates, tenantInvitations } from '@/db/schema';
import { eq, and, or, isNull, desc, notExists, ne } from 'drizzle-orm';

export const prerender = false;

const user = await getAuthenticatedUser(Astro.request);
if (!user || !isAuthorizedAdmin(user)) {
  return Astro.redirect('/auth/login?redirect=/admin');
}

if (user.role === 'superadmin') {
  return Astro.redirect('/superadmin');
}

let availableBalance = 0;
let tenantRows: Array<{
  id: string;
  name: string | null;
  email: string;
  createdAt: string;
  storeId?: string | null;
  storeName?: string | null;
  storeStatus?: string | null;
}> = [];

let transactionRows: Array<{
  id: string;
  externalId?: string | null;
  amount: number;
  adminFee: number | null;
  status: string;
  type: string;
  createdAt: string;
  templateId?: string | null;
  templateName: string | null;
  templateThumbnailUrl?: string | null;
  merchantName: string | null;
  storeName: string | null;
}> = [];

try {
  const wallet = await getDesignerWalletSummary(user.id);
  availableBalance = wallet.availableBalance;

  const unacceptedInvitationSubquery = db
    .select()
    .from(tenantInvitations)
    .where(
      and(
        eq(tenantInvitations.email, users.email),
        isNull(tenantInvitations.acceptedAt),
      ),
    );

  const rawTenants = await db
    .select({
      id: users.id,
      name: users.name,
      email: users.email,
      createdAt: users.createdAt,
      storeId: stores.id,
      storeName: stores.name,
      storeStatus: stores.status,
    })
    .from(users)
    .leftJoin(stores, and(eq(stores.userId, users.id), isNull(stores.deletedAt)))
    .where(
      and(
        eq(users.registeredBy, user.id),
        eq(users.role, 'tenant'),
        ne(users.status, 'pending'),
        isNull(users.deletedAt),
        notExists(unacceptedInvitationSubquery),
      ),
    )
    .orderBy(desc(users.createdAt));

  tenantRows = rawTenants.map((t) => ({
    id: t.id,
    name: t.name,
    email: t.email,
    createdAt: t.createdAt ? t.createdAt.toISOString() : new Date().toISOString(),
    storeId: t.storeId,
    storeName: t.storeName,
    storeStatus: t.storeStatus,
  }));

  const whereCondition = or(
    eq(transactions.userId, user.id),
    eq(transactions.assistedBy, user.id),
  );

  const rawTransactions = await db
    .select({
      id: transactions.id,
      externalId: transactions.externalId,
      amount: transactions.amount,
      adminFee: transactions.adminFee,
      status: transactions.status,
      type: transactions.type,
      createdAt: transactions.createdAt,
      templateId: templates.id,
      templateName: templates.name,
      templateThumbnailUrl: templates.thumbnailUrl,
      merchantName: users.name,
      merchantEmail: users.email,
      storeName: stores.name,
    })
    .from(transactions)
    .leftJoin(templates, eq(transactions.templateId, templates.id))
    .leftJoin(users, eq(transactions.userId, users.id))
    .leftJoin(
      stores,
      or(eq(transactions.storeId, stores.id), eq(stores.userId, transactions.userId)),
    )
    .where(whereCondition)
    .orderBy(desc(transactions.createdAt));

  transactionRows = rawTransactions.map((t) => ({
    id: t.id,
    externalId: t.externalId,
    amount: Number(t.amount),
    adminFee: Number(t.adminFee || 0),
    status: t.status,
    type: t.type,
    createdAt: t.createdAt ? t.createdAt.toISOString() : new Date().toISOString(),
    templateId: t.templateId,
    templateName: t.templateName,
    templateThumbnailUrl: t.templateThumbnailUrl,
    merchantName: t.merchantName || '—',
    merchantEmail: t.merchantEmail || null,
    storeName: t.storeName || 'Belum Membuat Toko',
  }));
} catch (error) {
  console.error('[AdminDashboard] Gagal memuat data overview dasbor:', error);
}

const userCreatedYear = user.createdAt
  ? new Date(user.createdAt).getFullYear()
  : new Date().getFullYear();

const currentHour = new Date().getHours();
let greeting = 'Selamat Datang';
if (currentHour >= 4 && currentHour < 11) {
  greeting = 'Selamat Pagi';
} else if (currentHour >= 11 && currentHour < 15) {
  greeting = 'Selamat Siang';
} else if (currentHour >= 15 && currentHour < 18.5) {
  greeting = 'Selamat Sore';
} else {
  greeting = 'Selamat Malam';
}
---

<DashboardLayout title="Overview Dasbor" breadcrumb="Dashboard">
  <div class="min-h-full space-y-8 md:space-y-10 pb-12">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2">
      <div>
        <h1 class="text-heading-lg text-main font-bold tracking-tight">
          <span>{greeting}, {user.name ? user.name.split(' ')[0] : 'Admin'}!</span>
        </h1>
        <p class="text-body-base text-secondary mt-1 max-w-2xl leading-relaxed font-sans">
          Pusat monitoring performa pendampingan UMKM, tren pertumbuhan merchant, dan metrik bisnis operasional Anda.
        </p>
      </div>

      <!-- Quick Action Navigation -->
      <div class="flex items-center gap-3 flex-shrink-0">
        <Button href="/templates" variant="secondary" size="md">
          <span class="material-symbols-outlined text-base">storefront</span>
          <span>Beli Template</span>
        </Button>

        <Button href="/admin/merchants" variant="primary" size="md">
          <span class="material-symbols-outlined text-base">groups</span>
          <span>Kelola Merchant</span>
        </Button>
      </div>
    </div>

    <!-- Master Overview Dashboard (Filter Tahun & Bulan, Statcard, Grafik & Tabel Terkini) -->
    <AdminOverviewDashboard
      client:load
      allTenants={tenantRows}
      allTransactions={transactionRows}
      availableBalance={availableBalance}
      userCreatedYear={userCreatedYear}
    />
  </div>
</DashboardLayout>
