---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import CommissionSettingsPanel from '@/components/admin/CommissionSettingsPanel.svelte';
import { getAuthenticatedUser, isAuthorizedAdmin } from '@/lib/auth';
import { db } from '@/lib/db/client';
import { platformSettings } from '@/db/schema';

export const prerender = false;

const user = await getAuthenticatedUser(Astro.request);
if (!user) {
  return Astro.redirect('/auth/login');
}

if (!isAuthorizedAdmin(user)) {
  return Astro.redirect('/dashboard');
}

let initialFeePercentage = 30;
let initialSettlementDelayDays = 7;

try {
  const records = await db.select().from(platformSettings).limit(1);
  if (records.length > 0) {
    if (typeof records[0].platformFeePercentage === 'number') {
      initialFeePercentage = records[0].platformFeePercentage;
    }
    if (typeof records[0].settlementDelayDays === 'number') {
      initialSettlementDelayDays = records[0].settlementDelayDays;
    }
  }
} catch {
  initialFeePercentage = 30;
  initialSettlementDelayDays = 7;
}
---

<DashboardLayout title="Pengaturan Komisi" breadcrumb="Admin / Pengaturan Platform">
  <div class="min-h-full space-y-8 md:space-y-10 pb-10">
    <CommissionSettingsPanel
      client:load
      {initialFeePercentage}
      {initialSettlementDelayDays}
    />
  </div>
</DashboardLayout>
