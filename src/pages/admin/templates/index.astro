---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import TemplateReviewPanel from '@/components/admin/TemplateReviewPanel.svelte';
import { getAuthenticatedUser, isAuthorizedAdmin } from '@/lib/auth';
import { getTemplatesForAdmin } from '@/services';

const user = await getAuthenticatedUser(Astro.request);
if (!user) {
  return Astro.redirect('/auth/login');
}

if (!isAuthorizedAdmin(user)) {
  return Astro.redirect('/dashboard');
}

let initialTemplates: Awaited<ReturnType<typeof getTemplatesForAdmin>> = [];
try {
  initialTemplates = await getTemplatesForAdmin();
} catch {
  initialTemplates = [];
}

const initialTemplatesJson = JSON.stringify(initialTemplates);
---

<DashboardLayout title="Kurasi Template" breadcrumb="Admin / Kurasi Template">
  <div class="min-h-full bg-canvas -m-4 md:-m-6 lg:-m-8 p-4 md:p-6 lg:p-8 animate-fade-in">
    <TemplateReviewPanel client:load {initialTemplatesJson} />
  </div>
</DashboardLayout>
