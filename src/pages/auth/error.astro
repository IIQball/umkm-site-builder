---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Card from "@/components/ui/Card.svelte";
import Button from "@/components/ui/Button.svelte";

const errorParam = Astro.url.searchParams.get("error") || "";
const errorDesc = Astro.url.searchParams.get("error_description") || "";

// Whitelist-specific checks or generic unauthorized check
const isUnauthorizedEmail = 
  errorParam.includes("UNAUTHORIZED_EMAIL") ||
  errorParam.includes("UNAUTHORIZED") ||
  errorParam.includes("unable_to_create_user") ||
  errorDesc.includes("UNAUTHORIZED_EMAIL") ||
  errorDesc.includes("unable_to_create_user");

const errorMessage = isUnauthorizedEmail
  ? "Email Anda belum terdaftar di sistem. Silakan hubungi Administrator untuk mendapatkan akses."
  : (errorDesc || errorParam || "Terjadi kesalahan saat memproses autentikasi.");
---

<BaseLayout title="Autentikasi Gagal - UMKM Site Builder" description="Akses akun dibatasi atau terjadi kesalahan login" hideNavbar={true}>
  <main class="min-h-screen flex items-center justify-center px-4 py-12 bg-canvas">
    <div class="w-full max-w-md animate-fade-in-up">
      <Card variant="bordered" padding="lg" radius="2xl" class="text-center">
        <div class="space-y-4">
          <!-- Icon State -->
          <div class="mx-auto w-16 h-16 rounded-full bg-error/10 text-error flex items-center justify-center shadow-inner">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>

          <div>
            <h1 class="text-heading-md text-main">Akses Ditolak</h1>
            <p class="text-label-caps text-muted mt-1 font-semibold">Strict Whitelist Policy</p>
          </div>

          <div class="p-4 rounded-xl bg-error/5 border border-error/20 text-left">
            <p class="text-body-sm text-secondary leading-relaxed">
              {errorMessage}
            </p>
          </div>

          <div class="space-y-3 pt-2 flex flex-col items-center">
            <Button href="/auth/login" variant="primary" fullWidth size="md">
              Coba Masuk Lagi
            </Button>
            <div class="grid grid-cols-2 gap-2 w-full">
              <Button href="/" variant="ghost" size="sm" class="w-full">
                Kembali ke Beranda
              </Button>
              <Button href="mailto:admin@umkm.local?subject=Permintaan%20Akses%20Akun%20UMKM" variant="outline" size="sm" class="w-full">
                Hubungi Admin
              </Button>
            </div>
          </div>
        </div>
      </Card>
    </div>
  </main>
</BaseLayout>
