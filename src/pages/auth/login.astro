---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LoginForm from "@/components/auth/LoginForm.svelte";
---

<BaseLayout title="Masuk - UMKM Site Builder" description="Masuk ke akun Anda">
  <main class="min-h-screen flex items-center justify-center px-4 py-12 bg-base-200/30">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-base-content">Selamat Datang</h1>
        <p class="text-base-content/70 mt-2">Masuk untuk mengelola toko UMKM Anda</p>
      </div>
      <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="card-body p-6 sm:p-8">
          <LoginForm client:load />
          <div class="divider my-6">ATAU</div>
          <p class="text-center text-sm text-base-content/70">
            Belum punya akun?
            <a href="/auth/register" class="link link-primary font-medium ml-1">Buat akun</a>
          </p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
