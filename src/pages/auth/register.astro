---
import BaseLayout from "@/layouts/BaseLayout.astro";
import RegisterForm from "@/components/auth/RegisterForm.svelte";
---

<BaseLayout title="Buat Akun - UMKM Site Builder" description="Buat akun UMKM Site Builder Anda">
  <main class="min-h-[100dvh] flex items-center justify-center px-4 py-12 bg-base-200/40">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-base-content">Buat Akun</h1>
        <p class="text-sm text-base-content/70 mt-2">Mulai bangun toko UMKM Anda hari ini</p>
      </div>
      <div class="card border border-base-200/80 shadow-2xl rounded-3xl p-6 sm:p-9 bg-base-100 backdrop-blur-sm">
        <RegisterForm client:load />
        <p class="text-center text-sm text-base-content/70 mt-6 pt-5 border-t border-base-200">
          Sudah punya akun?
          <a href="/auth/login" class="link link-primary font-semibold ml-1">Masuk</a>
        </p>
      </div>
    </div>
  </main>
</BaseLayout>
