---
import BaseLayout from "@/layouts/BaseLayout.astro";
import RegisterForm from "@/components/auth/RegisterForm.svelte";
---

<BaseLayout title="Buat Akun - UMKM Site Builder" description="Buat akun UMKM Site Builder Anda">
  <main class="min-h-screen flex items-center justify-center px-4 py-12 bg-base-200/30">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-base-content">Buat Akun</h1>
        <p class="text-base-content/70 mt-2">Mulai bangun toko UMKM Anda hari ini</p>
      </div>
      <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="card-body p-6 sm:p-8">
          <RegisterForm client:load />
          <div class="divider my-6">ATAU</div>
          <p class="text-center text-sm text-base-content/70">
            Sudah punya akun?
            <a href="/auth/login" class="link link-primary font-medium ml-1">Masuk</a>
          </p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
