---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm.svelte";
---

<BaseLayout title="Atur Ulang Sandi - UMKM Site Builder" description="Atur Ulang Kata Sandi Anda" hideNavbar={true}>
  <main class="h-[100dvh] w-full flex items-center justify-center p-4 bg-slate-50 dark:bg-slate-950 relative overflow-hidden">
    <div class="w-full max-w-md bg-white dark:bg-slate-900 shadow-xl rounded-3xl overflow-hidden relative z-10 border border-slate-200 dark:border-slate-800 p-6 sm:p-10">
      
      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-2 hover:opacity-80 transition-opacity w-fit mx-auto mb-6">
          <div class="w-8 h-8 rounded-xl bg-blue-600 text-white flex items-center justify-center font-black text-sm shadow-sm">U</div>
          <span class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">UMKM Builder</span>
        </a>
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Atur Ulang Sandi</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
          Silakan masukkan kata sandi baru untuk akun Anda.
        </p>
      </div>

      <ResetPasswordForm client:load />
    </div>
  </main>
</BaseLayout>
