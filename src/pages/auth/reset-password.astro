---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm.svelte";
import Card from "@/components/ui/Card.svelte";
---

<BaseLayout title="Atur Ulang Sandi - UMKM Site Builder" description="Atur Ulang Kata Sandi Anda" hideNavbar={true}>
  <main class="min-h-screen w-full flex items-center justify-center p-4 bg-canvas relative overflow-hidden">
    <div class="w-full max-w-md relative z-10 animate-fade-in-up">
      <Card variant="elevated" padding="xl" radius="3xl">
        <div class="text-center mb-8">
          <a href="/" class="inline-flex items-center gap-2 hover:opacity-80 transition-opacity w-fit mx-auto mb-6 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 rounded-xl">
            <img
              src="/assets/logo/logo.webp"
              alt="Pinoka"
              class="h-8 w-auto object-contain"
              width="117"
              height="36"
              loading="eager"
            />
          </a>
          <h1 class="text-heading-lg text-main">Atur Ulang Sandi</h1>
          <p class="text-body-base text-secondary mt-2">
            Silakan masukkan kata sandi baru untuk akun Anda.
          </p>
        </div>

        <ResetPasswordForm client:load />
      </Card>
    </div>
  </main>
</BaseLayout>
