---
/**
 * pages/builder/new.astro
 * Create-new-template form. Auth-guarded: designer or superadmin only.
 * Rendered inside DashboardLayout shell (with Sidebar + Navbar).
 */
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import NewTemplateForm from '@/components/builder/NewTemplateForm.svelte';
import { getAuthenticatedUser, isAuthorizedDesigner } from '@/lib/auth';
import { getTemplateCategories } from '@/services/template-categories';
import { getTemplateById } from '@/services/templates';

const user = await getAuthenticatedUser(Astro.request);
if (!user || !isAuthorizedDesigner(user)) {
  return Astro.redirect('/auth/login');
}

const url = new URL(Astro.request.url);
const templateId = url.searchParams.get('id') || url.searchParams.get('templateId');
let initialTemplate = null;

if (templateId) {
  try {
    const tpl = await getTemplateById(templateId, user.id, user.role);
    if (tpl) {
      initialTemplate = {
        id: tpl.id,
        name: tpl.name,
        description: tpl.description,
        categoryId: tpl.categoryId,
        thumbnailUrl: tpl.thumbnailUrl,
        price: tpl.price,
        status: tpl.status,
        rejectionReason: tpl.rejectionReason,
        revisionCount: tpl.revisionCount,
        revisionNotes: tpl.revisionNotes,
      };
    }
  } catch (err) {
    console.error('[builder/new] Error loading template for initialization:', err);
  }
}

const categories = await getTemplateCategories();
const pageTitle = initialTemplate ? `Inisialisasi: ${initialTemplate.name}` : 'Studio Inisialisasi Template';
const breadcrumb = initialTemplate ? 'Template Saya / Inisialisasi Desain' : 'Template Saya / Buat Baru';
---

<DashboardLayout title={pageTitle} breadcrumb={breadcrumb}>
  <div class="min-h-full py-4 md:py-6 flex items-center justify-center animate-fade-in-up">
    <NewTemplateForm
      client:load
      categories={categories}
      initialTemplate={initialTemplate}
      backHref="/designer/templates"
    />
  </div>
</DashboardLayout>
