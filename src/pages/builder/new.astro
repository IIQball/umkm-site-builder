---
/**
 * pages/builder/new.astro
 * Create-new-template form. Auth-guarded: designer or superadmin only.
 * Rendered inside DashboardLayout shell (with Sidebar + Navbar).
 */
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import NewTemplateForm from '@/components/builder/NewTemplateForm.svelte';
import { getAuthenticatedUser, isAuthorizedDesigner } from '@/lib/auth';

const user = await getAuthenticatedUser(Astro.request);
if (!user || !isAuthorizedDesigner(user)) {
  return Astro.redirect('/auth/login');
}
---

<DashboardLayout title="Buat Template Baru" breadcrumb="Buat Template">
  <!-- Breadcrumb trail -->
  <nav class="flex items-center gap-1.5 text-xs text-base-content/50 mb-6" aria-label="Breadcrumb">
    <a href="/dashboard" class="hover:text-base-content transition-colors">Dashboard</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <a href="/designer/templates" class="hover:text-base-content transition-colors">Template Saya</a>
    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
    <span class="text-base-content font-medium">Buat Baru</span>
  </nav>

  <!-- Center the form in the content area -->
  <div class="flex justify-center">
    <NewTemplateForm client:load backHref="/designer/templates" />
  </div>
</DashboardLayout>
