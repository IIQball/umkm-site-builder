---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ReadOnlyPreview from '@/components/builder/ReadOnlyPreview.svelte';
import { db } from '@/lib/db/client';
import { templates, stores, userTemplates } from '@/db/schema';
import { eq, and } from 'drizzle-orm';
import { getAuthenticatedUser } from '@/lib/auth';
import type { EditorTemplate } from '@/components/builder/stores/editorStore';
import type { TemplateConfig } from '@/schemas';

export const prerender = false;

const currentUser = await getAuthenticatedUser(Astro.request);
const { templateId } = Astro.params;

if (!templateId) {
  return Astro.redirect('/templates');
}

const templateRecord = await db.query.templates.findFirst({
  where: eq(templates.id, templateId),
});

if (!templateRecord) {
  return Astro.redirect('/templates');
}

const isOwner = !!currentUser && currentUser.id === templateRecord.designerId;
const isDesigner = currentUser?.role === 'designer';

let tenantStoreId: string | null = null;
let isOwned = false;

if (currentUser) {
  if (currentUser.role === 'tenant') {
    const storeRecord = await db.query.stores.findFirst({
      where: eq(stores.userId, currentUser.id),
    });
    if (storeRecord) {
      tenantStoreId = storeRecord.id;
    }
  }

  const owned = await db.query.userTemplates.findFirst({
    where: and(
      eq(userTemplates.userId, currentUser.id),
      eq(userTemplates.templateId, templateRecord.id)
    ),
  });
  isOwned = !!owned;
}

const rawConfig = templateRecord.config;
let parsedConfig: TemplateConfig;
if (typeof rawConfig === 'string') {
  try {
    parsedConfig = JSON.parse(rawConfig);
  } catch {
    parsedConfig = { sections: [], theme: {} } as unknown as TemplateConfig;
  }
} else {
  parsedConfig = (rawConfig || { sections: [], theme: {} }) as TemplateConfig;
}

const previewTemplate: EditorTemplate = {
  id: templateRecord.id,
  name: templateRecord.name,
  description: templateRecord.description,
  thumbnailUrl: templateRecord.thumbnailUrl,
  price: templateRecord.price,
  status: templateRecord.status,
  rejectionReason: templateRecord.rejectionReason,
  config: parsedConfig,
};
---

<BaseLayout title={`Pratinjau: ${templateRecord.name} - UMKM Site Builder`} hideNavbar={true}>
  <ReadOnlyPreview
    client:load
    template={previewTemplate}
    isOwner={isOwner}
    isDesigner={isDesigner}
    isLoggedIn={!!currentUser}
    isOwned={isOwned}
    storeId={tenantStoreId}
  />
</BaseLayout>

