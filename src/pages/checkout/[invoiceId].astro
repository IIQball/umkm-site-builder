---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PaymentStatus from '@/components/checkout/PaymentStatus.svelte';
import { paymentService } from '@/services/payment.service';
import { formatCurrency } from '@/lib/utils/format';
import type { CheckoutPageData } from '@/types/payments';

interface Props {
  invoiceId: string;
}

const { invoiceId } = Astro.params as Props;

if (!invoiceId) {
  return Astro.redirect('/');
}

let pageData: CheckoutPageData | null = null;
let error: string | null = null;

try {
  const payment = await paymentService.getPaymentDetails(invoiceId);
  if (!payment) {
    error = 'Invoice not found';
  } else {
    pageData = {
      invoiceId: payment.metadata?.invoiceId || invoiceId,
      amount: payment.amount,
      amountFormatted: formatCurrency(Math.round(payment.amount * 100)),
      paymentUrl: payment.metadata?.invoiceUrl || '',
      status: payment.status as 'pending' | 'completed' | 'failed',
      expiresAt: payment.metadata?.expiresAt || '',
      paymentMethod: payment.metadata?.method,
    };
  }
} catch (err) {
  console.error('[Checkout] Error fetching payment:', err);
  error = 'Failed to load payment details';
}

const statusBadgeClass = pageData?.status === 'completed' ? 'badge-success' : 
                         pageData?.status === 'failed' ? 'badge-error' : 
                         'badge-warning';

const statusText = pageData?.status === 'completed' ? 'Lunas' :
                   pageData?.status === 'failed' ? 'Gagal' :
                   'Menunggu Pembayaran';
---

<BaseLayout title="Checkout - UMKM Site Builder" description="Complete your payment">
  <main class="min-h-screen bg-gradient-to-br from-base-100 to-base-200 flex items-center py-8">
    <div class="w-full max-w-md mx-auto px-4">
      
      <!-- Back Link -->
      <a href="/" class="link link-hover text-sm mb-6 inline-flex items-center gap-1">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Kembali
      </a>

      <!-- Error State -->
      {error && (
        <div class="alert alert-error shadow-lg mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l-2-2m0 0l-2-2m2 2l2-2m-2 2l-2 2"></path>
          </svg>
          <div>
            <h3 class="font-bold">Error</h3>
            <div class="text-sm">{error}</div>
          </div>
        </div>
      )}

      <!-- Loading State -->
      {!pageData && !error && (
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body flex items-center justify-center py-12">
            <span class="loading loading-spinner loading-lg"></span>
          </div>
        </div>
      )}

      <!-- Payment Card -->
      {pageData && (
        <div class="card bg-base-100 shadow-xl border border-base-300">
          <div class="card-body space-y-6">
            
            <!-- Header with Status Badge -->
            <div class="flex items-start justify-between gap-4">
              <div>
                <h1 class="text-2xl font-bold">Pembayaran Aktivasi</h1>
                <p class="text-sm text-base-content/60">Selesaikan pembayaran untuk mengaktifkan akun</p>
              </div>
              <div class={`badge ${statusBadgeClass} badge-lg shrink-0`}>
                {statusText}
              </div>
            </div>

            <div class="divider my-2"></div>

            <!-- Invoice Number -->
            <div>
              <label class="text-xs font-semibold text-base-content/70 uppercase tracking-wide">Nomor Invoice</label>
              <div class="bg-base-200 px-3 py-2 rounded text-sm font-mono break-all">
                {pageData.invoiceId}
              </div>
            </div>

            <!-- Transaction Item -->
            <div class="flex items-center justify-between py-2">
              <div class="text-sm">
                <p class="font-medium">Biaya Aktivasi Akun</p>
                <p class="text-xs text-base-content/60">1x</p>
              </div>
              <p class="font-semibold">{pageData.amountFormatted}</p>
            </div>

            <div class="divider my-2"></div>

            <!-- Total Amount -->
            <div class="flex items-baseline justify-between">
              <span class="text-sm font-medium">Total Tagihan</span>
              <div class="text-3xl font-bold text-primary">{pageData.amountFormatted}</div>
            </div>

            <!-- Payment Details -->
            {pageData.paymentMethod && (
              <div class="bg-base-200 px-3 py-2 rounded text-sm">
                <p class="text-xs text-base-content/70">Metode Pembayaran</p>
                <p class="font-medium capitalize">{pageData.paymentMethod}</p>
              </div>
            )}

            <!-- Expiry -->
            {pageData.expiresAt && (
              <div class="text-xs text-base-content/60">
                Berlaku hingga {new Date(pageData.expiresAt).toLocaleDateString('id-ID', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit',
                })}
              </div>
            )}

            <!-- Status Poller -->
            <PaymentStatus invoiceId={invoiceId} client:load />

            <!-- Pay Button -->
            {pageData.status === 'pending' && pageData.paymentUrl && (
              <>
                <button
                  class="btn btn-primary w-full"
                  onclick={`window.open('${pageData.paymentUrl}', '_blank', 'width=800,height=700')`}
                >
                  <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                  </svg>
                  Bayar Sekarang
                </button>
                <p class="text-xs text-center text-base-content/60">
                  Akan membuka halaman pembayaran Xendit di jendela baru
                </p>
              </>
            )}

            <!-- Success Alert -->
            {pageData.status === 'completed' && (
              <div class="alert alert-success">
                <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <div>
                  <h3 class="font-bold">Pembayaran Berhasil!</h3>
                  <div class="text-sm">Akun Anda telah diaktifkan. Nikmati fitur lengkap sekarang.</div>
                </div>
              </div>
            )}

            <!-- Error Alert -->
            {pageData.status === 'failed' && (
              <div class="alert alert-error">
                <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
                <div>
                  <h3 class="font-bold">Pembayaran Gagal</h3>
                  <div class="text-sm">Silakan coba lagi atau hubungi support@umkmbuilder.com</div>
                </div>
              </div>
            )}

          </div>
        </div>
      )}

      <!-- Info Footer -->
      {pageData && (
        <div class="mt-6 space-y-3 text-sm">
          <div class="alert alert-info">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 w-5 h-5" fill="none" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
              <h3 class="font-bold">Pembayaran Aman</h3>
              <div class="text-xs">Diproses melalui Xendit, penyedia pembayaran terpercaya Indonesia.</div>
            </div>
          </div>
          <div class="alert">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 w-5 h-5" fill="none" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.172l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
            <div>
              <h3 class="font-bold">Butuh Bantuan?</h3>
              <div class="text-xs">Hubungi support@umkmbuilder.com atau tanya di support channel.</div>
            </div>
          </div>
        </div>
      )}

    </div>
  </main>
</BaseLayout>

<style>
  /* No custom styles — daisyUI tokens only */
</style>
