---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PaymentStatus from '@/components/checkout/PaymentStatus.svelte';
import { paymentService } from '@/services/payment.service';
import { formatCurrency } from '@/lib/utils/format';
import type { CheckoutPageData } from '@/types/payments';
import '@/styles/checkout.css';

const { invoiceId } = Astro.params;

if (!invoiceId) {
  return Astro.redirect('/');
}

let pageData: CheckoutPageData | null = null;
let error: string | null = null;

try {
  const payment = await paymentService.getPaymentDetails(invoiceId);
  if (!payment) {
    error = 'Invoice tidak ditemukan atau telah kedaluwarsa';
  } else {
    pageData = {
      invoiceId: payment.metadata?.invoiceId || invoiceId,
      amount: payment.amount,
      amountFormatted: formatCurrency(Math.round(payment.amount * 100)),
      paymentUrl: payment.metadata?.invoiceUrl || '',
      status: payment.status as 'pending' | 'completed' | 'failed',
      expiresAt: payment.metadata?.expiresAt || '',
      paymentMethod: payment.metadata?.method,
    };
  }
} catch (err) {
  console.error('[Checkout] Error fetching payment:', err);
  error = 'Gagal memuat rincian pembayaran';
}
---

<BaseLayout title="Pembayaran Aktivasi - UMKM Builder" description="Selesaikan pembayaran untuk mengaktifkan akun Anda">
  <!-- Material Symbols Font for Icons -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <div class="checkout-wrapper">
    <main class="checkout-card">
      
      <!-- Top Navigation & Status -->
      <div class="checkout-header">
        <a href="/" class="back-link">
          <span class="material-symbols-outlined icon-16">arrow_back</span>
          Kembali ke Beranda
        </a>
        
        {pageData?.status === 'completed' ? (
          <div class="status-badge badge-success">
            <span class="badge-dot dot-success"></span>
            Lunas
          </div>
        ) : pageData?.status === 'failed' ? (
          <div class="status-badge badge-error">
            <span class="badge-dot dot-error"></span>
            Gagal
          </div>
        ) : (
          <div class="status-badge badge-warning pulse-amber">
            <span class="badge-dot dot-warning"></span>
            Menunggu Pembayaran
          </div>
        )}
      </div>

      <!-- Main Body -->
      <div class="checkout-body">
        
        {error && (
          <div class="alert-box alert-error">
            <span class="material-symbols-outlined icon-24">error</span>
            <div>
              <strong>Terjadi Kesalahan</strong>
              <p>{error}</p>
            </div>
          </div>
        )}

        <div class="title-section">
          {pageData?.status === 'completed' && (
            <div class="success-icon-wrapper">
              <span class="material-symbols-outlined icon-32">check_circle</span>
            </div>
          )}
          <h1 class="page-title">Pembayaran Aktivasi</h1>
          <p class="page-subtitle">
            {pageData?.status === 'completed'
              ? 'Pembayaran berhasil diverifikasi. Akun Anda kini sudah aktif.'
              : 'Selesaikan pembayaran untuk mengaktifkan toko online Anda.'}
          </p>
        </div>

        {pageData && (
          <div class="invoice-box">
            
            <!-- Reference Box -->
            <div class="reference-row">
              <div>
                <span class="field-label">No. Referensi / Invoice</span>
                <span class="field-value font-mono">{pageData.invoiceId}</span>
              </div>
              <button
                type="button"
                class="copy-btn"
                title="Salin Nomor Invoice"
                onclick={`navigator.clipboard.writeText('${pageData.invoiceId}'); alert('Nomor invoice berhasil disalin!');`}
              >
                <span class="material-symbols-outlined icon-18">content_copy</span>
              </button>
            </div>

            <!-- Line Items -->
            <div class="item-row">
              <div>
                <span class="item-title">Biaya Aktivasi Akun UMKM</span>
                <span class="item-subtitle">1x paket aktivasi tenant</span>
              </div>
              <span class="item-price">{pageData.amountFormatted}</span>
            </div>

            <!-- Total Amount -->
            <div class="total-section">
              <span class="field-label uppercase">Total Tagihan</span>
              <span class="total-amount">{pageData.amountFormatted}</span>
              
              {pageData.status === 'pending' && (
                <div class="expiry-indicator">
                  <span class="material-symbols-outlined icon-14">schedule</span>
                  Berlaku hingga 24 jam ke depan
                </div>
              )}
            </div>
          </div>
        )}

        <!-- Actions -->
        {pageData?.status === 'pending' && pageData.paymentUrl ? (
          <div class="action-container">
            <button
              type="button"
              class="primary-btn"
              onclick="document.getElementById('xendit_payment_modal').showModal()"
            >
              <span>Bayar Sekarang</span>
              <span class="material-symbols-outlined icon-18">payment</span>
            </button>

            <div class="poller-wrapper">
              <PaymentStatus invoiceId={invoiceId} client:load />
            </div>
          </div>
        ) : pageData?.status === 'completed' ? (
          <a href="/" class="primary-btn text-center">
            <span>Buka Dashboard Toko</span>
            <span class="material-symbols-outlined icon-18">dashboard</span>
          </a>
        ) : null}

      </div>

      <!-- Footer Info -->
      <div class="checkout-footer">
        <div class="security-note">
          <span class="material-symbols-outlined icon-14 text-emerald">lock</span>
          Diproses secara aman dan terenkripsi via Xendit
        </div>
        <div class="footer-links">
          <a href="#">Pusat Bantuan</a>
          <span>•</span>
          <a href="#">Hubungi Support</a>
        </div>
      </div>

    </main>

    <!-- In-Page Xendit Modal -->
    {pageData?.paymentUrl && (
      <dialog id="xendit_payment_modal" class="payment-modal">
        <div class="modal-header">
          <div class="modal-title">
            <span class="material-symbols-outlined icon-18 text-indigo">shield</span>
            Gateway Pembayaran Xendit
          </div>
          <button
            type="button"
            class="modal-close-btn"
            onclick="document.getElementById('xendit_payment_modal').close()"
          >
            <span class="material-symbols-outlined icon-20">close</span>
          </button>
        </div>
        <div class="modal-iframe-container">
          <iframe
            src={pageData.paymentUrl}
            class="payment-iframe"
            title="Xendit Payment Gateway"
            allow="payment"
          ></iframe>
        </div>
      </dialog>
    )}
  </div>
</BaseLayout>