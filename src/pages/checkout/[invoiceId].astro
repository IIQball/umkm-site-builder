---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CheckoutSummaryCard from '@/components/checkout/CheckoutSummaryCard.svelte';
import { transactionService } from '@/services';
import { formatCurrency } from '@/lib/utils/format';
import type { CheckoutPageData } from '@/types';
import { getAuthenticatedUser } from '@/lib/auth';
import { db } from '@/lib/db/client';
import { templates } from '@/db/schema';
import { eq } from 'drizzle-orm';

const { invoiceId } = Astro.params;

if (!invoiceId) {
  return Astro.redirect('/');
}

// Auth guard: must be logged in to view checkout
const currentUser = await getAuthenticatedUser(Astro.request);
if (!currentUser) {
  return Astro.redirect(`/auth/login?redirect=/checkout/${invoiceId}`);
}

let accessDenied = false;
let pageData: CheckoutPageData | null = null;
let error: string | null = null;
let templateName = '';

try {
  const transaction = await transactionService.getTransactionDetails(invoiceId);
  if (!transaction) {
    error = 'Tagihan tidak ditemukan atau telah kedaluwarsa';
  } else {
    // Ownership check: only transaction owner or admin can view
    const isOwner = transaction.userId === currentUser.id;
    const isAdmin = currentUser.role === 'admin' || currentUser.role === 'superadmin';
    if (!isOwner && !isAdmin) {
      accessDenied = true;
    } else {
      if (transaction.templateId) {
        const tpl = await db.query.templates.findFirst({
          where: eq(templates.id, transaction.templateId),
        });
        if (tpl) {
          templateName = tpl.name;
        }
      }

      let paymentUrl = '';
      if (transaction.status === 'pending') {
        paymentUrl = await transactionService.getInvoiceUrl(transaction.externalId) || '';
      }

      pageData = {
        invoiceId: transaction.externalId,
        amount: transaction.amount,
        amountFormatted: formatCurrency(transaction.amount),
        paymentUrl,
        status: transaction.status,
        expiresAt: '',
        paymentMethod: transaction.paymentChannel || undefined,
      };
    }
  }
} catch (err) {
  console.error('Checkout load error:', err);
  error = 'Gagal memuat data tagihan';
}

const isTemplatePurchase = true;
const checkoutTitle = 'Pembayaran Template';
const checkoutMetaTitle = `Pembelian Template - ${templateName || 'UMKM Site Builder'}`;
const checkoutDescription = 'Selesaikan pembayaran untuk menerapkan template desain toko UMKM Anda';
const lineItemTitle = `Pembelian Template "${templateName || 'Desain UMKM'}"`;
const lineItemSubtitle = 'Desain Template Website UMKM Siap Pakai';
---

<BaseLayout title={checkoutMetaTitle} description={checkoutDescription}>
  <div class="min-h-screen bg-canvas flex flex-col justify-center items-center py-10 px-4 text-main antialiased">
    <div class="w-full max-w-lg">

      <!-- 403 Access Denied -->
      {accessDenied && (
        <div class="p-8 rounded-2xl bg-card border border-light shadow-lg text-center space-y-3">
          <div class="w-12 h-12 rounded-full bg-error/10 text-error flex items-center justify-center mx-auto">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <h2 class="text-heading-md font-bold text-main">Akses Ditolak</h2>
          <p class="text-body-sm text-secondary">Anda tidak memiliki akses ke halaman pembayaran ini.</p>
          <a href="/dashboard" class="btn btn-primary btn-sm rounded-xl">Ke Dashboard</a>
        </div>
      )}

      <!-- Error Alert -->
      {!accessDenied && error && (
        <div class="alert alert-error shadow-lg text-white text-xs rounded-xl flex items-start gap-2 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-alert-triangle shrink-0"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
          <div>
            <h3 class="font-bold">Terjadi Kesalahan</h3>
            <p>{error}</p>
          </div>
        </div>
      )}

      <!-- Loading State Skeleton -->
      {!pageData && !error && (
        <div class="w-full max-w-lg rounded-2xl overflow-hidden shadow-2xl bg-card border border-light">
          <div class="flex flex-col items-center justify-center py-20">
            <span class="loading loading-spinner loading-lg text-primary"></span>
            <p class="text-xs text-muted mt-4 font-medium">Memuat data tagihan...</p>
          </div>
        </div>
      )}

      <!-- Main Unified Checkout Card -->
      {pageData && (
        <CheckoutSummaryCard
          pageData={pageData}
          checkoutTitle={checkoutTitle}
          checkoutDescription={checkoutDescription}
          lineItemTitle={lineItemTitle}
          lineItemSubtitle={lineItemSubtitle}
          isTemplatePurchase={isTemplatePurchase}
          invoiceId={invoiceId}
          client:load
        />
      )}

    </div>
  </div>
</BaseLayout>