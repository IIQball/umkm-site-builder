---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PaymentStatus from '@/components/checkout/PaymentStatus.svelte';
import { paymentService } from '@/services/payment.service';
import { formatCurrency } from '@/lib/utils/format';
import type { CheckoutPageData } from '@/types/payments';

const { invoiceId } = Astro.params;

if (!invoiceId) {
  return Astro.redirect('/');
}

let pageData: CheckoutPageData | null = null;
let error: string | null = null;

try {
  const payment = await paymentService.getPaymentDetails(invoiceId);
  if (!payment) {
    error = 'Invoice tidak ditemukan atau telah kedaluwarsa';
  } else {
    pageData = {
      invoiceId: payment.metadata?.invoiceId || invoiceId,
      amount: payment.amount,
      amountFormatted: formatCurrency(Math.round(payment.amount * 100)),
      paymentUrl: payment.metadata?.invoiceUrl || '',
      status: payment.status as 'pending' | 'completed' | 'failed',
      expiresAt: payment.metadata?.expiresAt || '',
      paymentMethod: payment.metadata?.method,
    };
  }
} catch (err) {
  console.error('[Checkout] Error fetching payment:', err);
  error = 'Gagal memuat rincian pembayaran';
}
---

<BaseLayout title="Pembayaran Aktivasi - UMKM Builder" description="Selesaikan pembayaran untuk mengaktifkan akun Anda">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <div class="min-h-screen bg-base-100 flex items-center justify-center p-4">
    <div class="w-full max-w-md">
      
      <!-- Back Link -->
      <a href="/" class="inline-flex items-center gap-2 text-sm text-base-content/60 hover:text-base-content mb-6 transition-colors">
        <span class="material-symbols-outlined text-base">arrow_back</span>
        Kembali ke Beranda
      </a>

      <!-- Error State -->
      {error && (
        <div class="alert alert-error mb-6 text-sm">
          <span class="material-symbols-outlined">error</span>
          <div>
            <h3 class="font-bold">Terjadi Kesalahan</h3>
            <p>{error}</p>
          </div>
        </div>
      )}

      <!-- Loading State -->
      {!pageData && !error && (
        <div class="card bg-base-200 shadow-lg">
          <div class="card-body flex items-center justify-center py-12">
            <span class="loading loading-spinner loading-lg"></span>
            <p class="text-sm text-base-content/60 mt-4">Memuat data invoice...</p>
          </div>
        </div>
      )}

      <!-- Payment Card -->
      {pageData && (
        <div class="card bg-base-100 border border-base-300 shadow-lg">
          <div class="card-body p-6 space-y-6">
            
            <!-- Header -->
            <div class="flex items-start justify-between gap-3">
              <div>
                <h1 class="text-2xl font-bold text-base-content">Pembayaran Aktivasi</h1>
                <p class="text-xs text-base-content/60 mt-1">Selesaikan pembayaran untuk mengaktifkan akun Anda</p>
              </div>
              {pageData.status === 'completed' ? (
                <div class="badge badge-success gap-1 text-white font-semibold">
                  <span class="material-symbols-outlined text-sm">check_circle</span>
                  Lunas
                </div>
              ) : pageData.status === 'failed' ? (
                <div class="badge badge-error gap-1 text-white font-semibold">
                  <span class="material-symbols-outlined text-sm">cancel</span>
                  Gagal
                </div>
              ) : (
                <div class="badge badge-warning gap-1 text-base-content font-semibold animate-pulse">
                  <span class="material-symbols-outlined text-sm">schedule</span>
                  Menunggu
                </div>
              )}
            </div>

            <div class="divider my-0"></div>

            <!-- Invoice Number -->
            <div>
              <label class="label">
                <span class="label-text text-xs uppercase font-semibold text-base-content/60">Nomor Invoice</span>
              </label>
              <div class="flex items-center justify-between gap-2 p-2 bg-base-200 rounded border border-base-300">
                <code class="text-xs font-mono text-base-content break-all">{pageData.invoiceId}</code>
                <button
                  type="button"
                  class="btn btn-ghost btn-xs"
                  title="Salin Nomor Invoice"
                  onclick={`
                    navigator.clipboard.writeText('${pageData.invoiceId}');
                    const toast = document.getElementById('copy_toast');
                    if (toast) {
                      toast.classList.remove('hidden');
                      toast.classList.add('opacity-100');
                      setTimeout(() => {
                        toast.classList.add('hidden');
                        toast.classList.remove('opacity-100');
                      }, 2500);
                    }
                  `}
                >
                  <span class="material-symbols-outlined text-sm">content_copy</span>
                </button>
              </div>
            </div>

            <!-- Item Details -->
            <div class="space-y-2 border-b border-base-300 pb-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-base-content">Biaya Aktivasi Akun UMKM</p>
                  <p class="text-xs text-base-content/60">1x paket aktivasi tenant</p>
                </div>
                <p class="text-sm font-semibold text-base-content">{pageData.amountFormatted}</p>
              </div>
            </div>

            <!-- Total Amount -->
            <div class="space-y-2 text-center">
              <label class="label">
                <span class="label-text text-xs uppercase font-semibold text-base-content/60">Total Tagihan</span>
              </label>
              <p class="text-3xl font-black text-primary">{pageData.amountFormatted}</p>
              
              {pageData.status === 'pending' && (
                <div class="badge badge-outline badge-sm gap-1 mx-auto">
                  <span class="material-symbols-outlined text-xs">schedule</span>
                  Berlaku hingga 24 jam ke depan
                </div>
              )}
            </div>

            <!-- Real-time Poller -->
            <PaymentStatus invoiceId={invoiceId} client:load />

            <!-- Actions -->
            {pageData.status === 'pending' && pageData.paymentUrl ? (
              <div class="space-y-2 pt-2">
                <button
                  type="button"
                  class="btn btn-primary w-full font-semibold gap-2"
                  onclick="document.getElementById('xendit_payment_modal').showModal()"
                >
                  <span class="material-symbols-outlined">payment</span>
                  Bayar Sekarang
                </button>
                <p class="text-xs text-center text-base-content/50">
                  Gateway pembayaran resmi Xendit
                </p>
              </div>
            ) : pageData.status === 'completed' ? (
              <a href="/" class="btn btn-primary w-full font-semibold gap-2">
                <span class="material-symbols-outlined">dashboard</span>
                Buka Dashboard Toko
              </a>
            ) : null}

          </div>
        </div>
      )}

      <!-- Footer Info -->
      {pageData && (
        <div class="mt-4 p-3 rounded-lg border border-base-300 text-xs text-base-content/60 flex items-start gap-2">
          <span class="material-symbols-outlined text-sm text-success shrink-0 mt-0.5">lock</span>
          <span>Pembayaran terenkripsi dan diproses aman melalui Xendit. <a href="#" class="link link-hover">Pusat Bantuan</a></span>
        </div>
      )}

    </div>

    <!-- In-Page Xendit Modal -->
    {pageData?.paymentUrl && (
      <dialog id="xendit_payment_modal" class="modal">
        <div class="modal-box w-11/12 max-w-2xl p-0 overflow-hidden">
          <!-- Modal Header -->
          <div class="flex justify-between items-center p-4 border-b border-base-300 bg-base-200">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">shield</span>
              <h3 class="font-bold text-sm">Gateway Pembayaran Xendit</h3>
            </div>
            <form method="dialog">
              <button class="btn btn-sm btn-circle btn-ghost">
                <span class="material-symbols-outlined">close</span>
              </button>
            </form>
          </div>
          <!-- Modal Content -->
          <iframe
            src={pageData.paymentUrl}
            class="w-full h-[600px] border-none"
            title="Xendit Payment Gateway"
            allow="payment"
          ></iframe>
        </div>
        <!-- Close on backdrop click -->
        <form method="dialog" class="modal-backdrop">
          <button>close</button>
        </form>
      </dialog>
    )}

    <!-- Copy Toast Notification -->
    <div
      id="copy_toast"
      class="toast toast-top toast-end fixed z-50 hidden opacity-0 transition-opacity duration-200"
    >
      <div class="alert alert-success text-xs text-white gap-2">
        <span class="material-symbols-outlined text-sm">check_circle</span>
        <span>Nomor invoice berhasil disalin!</span>
      </div>
    </div>

  </div>
</BaseLayout>