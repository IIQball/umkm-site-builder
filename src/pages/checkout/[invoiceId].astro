---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PaymentStatus from '@/components/checkout/PaymentStatus.svelte';
import { paymentService } from '@/services/payment.service';
import { formatCurrency } from '@/lib/utils/format';
import type { CheckoutPageData } from '@/types/payments';

const { invoiceId } = Astro.params;

if (!invoiceId) {
  return Astro.redirect('/');
}

let pageData: CheckoutPageData | null = null;
let error: string | null = null;

try {
  const payment = await paymentService.getPaymentDetails(invoiceId);
  if (!payment) {
    error = 'Invoice tidak ditemukan atau telah kedaluwarsa';
  } else {
    pageData = {
      invoiceId: payment.metadata?.invoiceId || invoiceId,
      amount: payment.amount,
      amountFormatted: formatCurrency(Math.round(payment.amount * 100)),
      paymentUrl: payment.metadata?.invoiceUrl || '',
      status: payment.status as 'pending' | 'completed' | 'failed',
      expiresAt: payment.metadata?.expiresAt || '',
      paymentMethod: payment.metadata?.method,
    };
  }
} catch (err) {
  console.error('[Checkout] Error fetching payment:', err);
  error = 'Gagal memuat rincian pembayaran';
}
---

<BaseLayout title="Pembayaran Aktivasi - UMKM Builder" description="Selesaikan pembayaran untuk mengaktifkan akun Anda">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <div class="min-h-screen bg-slate-50 dark:bg-[#0a0f1e] flex flex-col justify-center items-center py-10 px-4">
    <div class="w-full max-w-lg">
      
      {error && (
        <div class="alert alert-error shadow-md text-error-content text-xs rounded-xl flex items-start gap-2 mb-4">
          <span class="material-symbols-outlined text-lg shrink-0">error</span>
          <div>
            <h3 class="font-bold">Terjadi Kesalahan</h3>
            <p>{error}</p>
          </div>
        </div>
      )}

      {!pageData && !error && (
        <div class="w-full max-w-lg rounded-xl overflow-hidden shadow-2xl bg-white dark:bg-[#161e31] border border-slate-200 dark:border-slate-700/50">
          <div class="card-body flex flex-col items-center justify-center py-16">
            <span class="loading loading-spinner loading-lg text-primary"></span>
            <p class="text-xs text-slate-600 dark:text-slate-400 mt-4">Memuat data invoice...</p>
          </div>
        </div>
      )}

      {pageData && (
        <div class="w-full max-w-lg rounded-xl overflow-hidden shadow-2xl bg-white dark:bg-[#161e31] border border-slate-200 dark:border-slate-700/50">
          
          <!-- Header dengan Back Link & Status -->
          <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700/50 flex items-start justify-between gap-3">
            <a href="/" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors shrink-0">
              <span class="material-symbols-outlined text-[16px]">arrow_back</span>
              Kembali
            </a>
            
            <div class="flex-1 text-center">
              <h1 class="text-lg font-bold text-slate-900 dark:text-white">Pembayaran Aktivasi</h1>
            </div>

            {pageData.status === 'completed' ? (
              <div class="badge badge-success gap-1 text-white font-bold text-xs py-3 px-3 shrink-0">
                <span class="material-symbols-outlined text-[14px]">check_circle</span>
                Lunas
              </div>
            ) : pageData.status === 'failed' ? (
              <div class="badge badge-error gap-1 text-white font-bold text-xs py-3 px-3 shrink-0">
                <span class="material-symbols-outlined text-[14px]">cancel</span>
                Gagal
              </div>
            ) : (
              <div class="badge badge-warning gap-1 text-slate-900 font-bold text-xs py-3 px-3 shrink-0 animate-pulse">
                <span class="material-symbols-outlined text-[14px]">schedule</span>
                Menunggu
              </div>
            )}
          </div>

          <!-- Body Content -->
          <div class="p-6 space-y-5">
            
            <!-- Invoice Number -->
            <div class="bg-slate-50 dark:bg-[#1c263c] rounded-lg p-4 border border-slate-200 dark:border-slate-700/30 flex items-center justify-between gap-2">
              <div class="min-w-0 flex-1">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-1">Nomor Invoice</span>
                <code class="text-xs font-mono font-semibold text-slate-900 dark:text-white block truncate select-all">{pageData.invoiceId}</code>
              </div>
              <button
                type="button"
                class="btn btn-ghost btn-sm btn-square text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white shrink-0"
                title="Salin Nomor Invoice"
                onclick={`
                  navigator.clipboard.writeText('${pageData.invoiceId}');
                  const toast = document.getElementById('copy_toast');
                  if (toast) {
                    toast.classList.remove('hidden');
                    toast.classList.add('opacity-100');
                    setTimeout(() => {
                      toast.classList.remove('opacity-100');
                      toast.classList.add('opacity-0');
                      setTimeout(() => toast.classList.add('hidden'), 200);
                    }, 2200);
                  }
                `}
              >
                <span class="material-symbols-outlined text-[18px]">content_copy</span>
              </button>
            </div>

            <!-- Item Details -->
            <div class="space-y-3 bg-slate-50 dark:bg-[#1c263c] rounded-lg p-4 border border-slate-200 dark:border-slate-700/30">
              <div class="flex justify-between items-start gap-4">
                <div class="max-w-[70%]">
                  <p class="text-sm font-semibold text-slate-900 dark:text-white">Biaya Aktivasi Akun UMKM</p>
                  <p class="text-xs text-slate-600 dark:text-slate-400 mt-0.5">1x Aktivasi Tenant Standard</p>
                </div>
                <p class="text-sm font-bold text-slate-900 dark:text-white text-right whitespace-nowrap">{pageData.amountFormatted}</p>
              </div>

              <div class="divider my-2"></div>

              <div class="flex items-baseline justify-between pt-1">
                <span class="text-xs font-semibold text-slate-600 dark:text-slate-400">Total Tagihan</span>
                <span class="text-3xl font-black text-blue-600 dark:text-blue-400">{pageData.amountFormatted}</span>
              </div>

              {pageData.status === 'pending' && (
                <div class="flex items-center justify-center gap-1.5 py-2 text-xs font-medium text-amber-600 dark:text-amber-400">
                  <span class="material-symbols-outlined text-[16px]">timer</span>
                  Berlaku selama 24 jam ke depan
                </div>
              )}
            </div>

            <!-- Payment Status Poller -->
            <div class="pt-2">
              <PaymentStatus invoiceId={invoiceId} client:load />
            </div>

            <!-- Action Buttons -->
            {pageData.status === 'pending' && pageData.paymentUrl ? (
              <div class="space-y-2 pt-2">
                <button
                  type="button"
                  class="btn btn-primary w-full shadow-lg font-bold gap-2 text-white dark:text-slate-900"
                  onclick="document.getElementById('xendit_payment_modal').showModal()"
                >
                  <span class="material-symbols-outlined text-[20px]">payment</span>
                  Bayar Sekarang
                </button>
                <p class="text-xs text-center text-slate-600 dark:text-slate-400">
                  Pembayaran aman didukung gateway resmi Xendit
                </p>
              </div>
            ) : pageData.status === 'completed' ? (
              <a href="/" class="btn btn-primary w-full shadow-lg font-bold gap-2 text-white dark:text-slate-900">
                <span class="material-symbols-outlined text-[20px]">dashboard</span>
                Buka Dashboard Toko
              </a>
            ) : null}

          </div>

          <!-- Footer dengan Info Keamanan -->
          <div class="px-6 py-4 border-t border-slate-200 dark:border-slate-700/50 bg-slate-50/50 dark:bg-slate-900/20 flex items-center justify-between text-xs text-slate-600 dark:text-slate-400">
            <div class="flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[16px] text-green-600 dark:text-green-400">lock</span>
              <span>Enkripsi 256-bit</span>
            </div>
            <div class="flex items-center gap-2">
              <a href="#" class="link link-hover">Bantuan</a>
              <span>•</span>
              <a href="#" class="link link-hover">Hubungi CS</a>
            </div>
          </div>

        </div>
      )}

    </div>

    <!-- Xendit Payment Modal -->
    {pageData?.paymentUrl && (
      <dialog id="xendit_payment_modal" class="modal modal-bottom sm:modal-middle">
        <div class="modal-box w-11/12 max-w-2xl p-0 overflow-hidden bg-white dark:bg-[#161e31] border border-slate-200 dark:border-slate-700/50">
          
          <div class="flex justify-between items-center px-4 py-3 border-b border-slate-200 dark:border-slate-700/50 bg-slate-50 dark:bg-slate-900/30">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-blue-600 dark:text-blue-400 text-[20px]">verified_user</span>
              <h3 class="font-bold text-sm text-slate-900 dark:text-white">Gateway Pembayaran Xendit</h3>
            </div>
            <form method="dialog">
              <button class="btn btn-sm btn-circle btn-ghost text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">
                <span class="material-symbols-outlined text-[18px]">close</span>
              </button>
            </form>
          </div>

          <div class="w-full h-[620px] bg-white dark:bg-[#161e31]">
            <iframe
              src={pageData.paymentUrl}
              class="w-full h-full border-none"
              title="Xendit Checkout"
              allow="payment"
            ></iframe>
          </div>
        </div>

        <form method="dialog" class="modal-backdrop">
          <button>close</button>
        </form>
      </dialog>
    )}

    <!-- Copy Toast Notification -->
    <div
      id="copy_toast"
      class="toast toast-top toast-end fixed z-50 p-4 transition-all duration-200 hidden opacity-0"
    >
      <div class="alert alert-success shadow-lg text-white text-xs font-semibold py-2 px-3 gap-2 rounded-lg">
        <span class="material-symbols-outlined text-[16px]">check_circle</span>
        <span>Nomor invoice berhasil disalin</span>
      </div>
    </div>

  </div>
</BaseLayout>