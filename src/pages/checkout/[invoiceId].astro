---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TransactionStatus from '@/components/checkout/TransactionStatus.svelte';
import InvoiceCard from '@/components/checkout/InvoiceCard.svelte';
import { transactionService } from '@/services';
import type { CheckoutPageData } from '@/types';
import { getAuthenticatedUser } from '@/lib/auth';
import { db } from '@/lib/db/client';
import { templates } from '@/db/schema';
import { eq } from 'drizzle-orm';

const { invoiceId } = Astro.params;

if (!invoiceId) {
  return Astro.redirect('/');
}

const currentUser = await getAuthenticatedUser(Astro.request);
if (!currentUser) {
  return Astro.redirect(`/auth/login?redirect=/checkout/${invoiceId}`);
}

let accessDenied = false;
let pageData: CheckoutPageData | null = null;
let error: string | null = null;
let transactionType: 'store_registration' | 'template_purchase' = 'store_registration';
let templateName = '';

try {
  const transaction = await transactionService.getTransactionDetails(invoiceId);
  if (!transaction) {
    error = 'Tagihan tidak ditemukan atau telah kedaluwarsa';
  } else {
    const isOwner = transaction.userId === currentUser.id;
    const isAdmin = currentUser.role === 'admin' || currentUser.role === 'superadmin';
    if (!isOwner && !isAdmin) {
      accessDenied = true;
    } else {
      transactionType = transaction.type;
      if (transaction.type === 'template_purchase' && transaction.templateId) {
        const tpl = await db.query.templates.findFirst({
          where: eq(templates.id, transaction.templateId),
        });
        if (tpl) {
          templateName = tpl.name;
        }
      }
      pageData = {
        invoiceId: transaction.id,
        status: transaction.status,
        amount: transaction.amount,
        expiryDate: transaction.expiryDate?.toISOString() || null,
        invoiceUrl: transaction.invoiceUrl || '',
      };
    }
  }
} catch {
  error = 'Gagal memuat informasi tagihan';
}
---

<BaseLayout title="Detail Pembayaran Tagihan">
  <main class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl w-full space-y-6">
      {accessDenied ? (
        <div class="p-8 text-center bg-base-100 dark:bg-slate-900 border border-base-200 dark:border-slate-800 rounded-3xl space-y-4">
          <h2 class="text-xl font-bold text-rose-500">Akses Ditolak</h2>
          <p class="text-xs text-base-content/60">Anda tidak memiliki izin untuk melihat tagihan ini.</p>
          <a href="/dashboard" class="inline-block px-4 py-2 bg-primary text-white text-xs font-semibold rounded-xl">Kembali ke Dashboard</a>
        </div>
      ) : error || !pageData ? (
        <div class="p-8 text-center bg-base-100 dark:bg-slate-900 border border-base-200 dark:border-slate-800 rounded-3xl space-y-4">
          <h2 class="text-xl font-bold text-rose-500">Tagihan Tidak Ditemukan</h2>
          <p class="text-xs text-base-content/60">{error || 'Data tagihan tidak tersedia.'}</p>
          <a href="/" class="inline-block px-4 py-2 bg-primary text-white text-xs font-semibold rounded-xl">Kembali ke Beranda</a>
        </div>
      ) : (
        <div class="space-y-6">
          <TransactionStatus client:load invoiceId={pageData.invoiceId} initialStatus={pageData.status} />
          <InvoiceCard client:load pageData={pageData} transactionType={transactionType} templateName={templateName} />
        </div>
      )}
    </div>
  </main>
</BaseLayout>