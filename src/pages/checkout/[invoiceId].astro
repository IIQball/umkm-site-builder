---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PaymentStatus from '@/components/checkout/PaymentStatus.svelte';
import { paymentService } from '@/services/payment.service';
import { formatCurrency } from '@/lib/utils/format';
import type { CheckoutPageData } from '@/types/payments';

const { invoiceId } = Astro.params;

if (!invoiceId) {
  return Astro.redirect('/');
}

let pageData: CheckoutPageData | null = null;
let error: string | null = null;

try {
  const payment = await paymentService.getPaymentDetails(invoiceId);
  if (!payment) {
    error = 'Invoice tidak ditemukan atau telah kedaluwarsa';
  } else {
    pageData = {
      invoiceId: payment.metadata?.invoiceId || invoiceId,
      amount: payment.amount,
      amountFormatted: formatCurrency(Math.round(payment.amount * 100)),
      paymentUrl: payment.metadata?.invoiceUrl || '',
      status: payment.status as 'pending' | 'completed' | 'failed',
      expiresAt: payment.metadata?.expiresAt || '',
      paymentMethod: payment.metadata?.method,
    };
  }
} catch (err) {
  console.error('[Checkout] Error fetching payment:', err);
  error = 'Gagal memuat rincian pembayaran';
}
---

<BaseLayout title="Pembayaran Aktivasi - UMKM Builder" description="Selesaikan pembayaran untuk mengaktifkan akun Anda">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <div class="min-h-screen bg-base-200/60 flex flex-col justify-center items-center py-10 px-4">
    <div class="w-full max-w-md mx-auto space-y-4">
      
      <div class="flex items-center justify-between px-1">
        <a href="/" class="link link-hover inline-flex items-center gap-1.5 text-xs font-semibold text-base-content/70 hover:text-primary transition-colors">
          <span class="material-symbols-outlined text-[16px]">arrow_back</span>
          Kembali ke Beranda
        </a>
      </div>

      {error && (
        <div class="alert alert-error shadow-md text-error-content text-xs rounded-xl flex items-start gap-2">
          <span class="material-symbols-outlined text-lg shrink-0">error</span>
          <div>
            <h3 class="font-bold">Terjadi Kesalahan</h3>
            <p>{error}</p>
          </div>
        </div>
      )}

      {!pageData && !error && (
        <div class="card bg-base-100 shadow-xl border border-base-content/10">
          <div class="card-body flex flex-col items-center justify-center py-16">
            <span class="loading loading-spinner loading-lg text-primary"></span>
            <p class="text-xs text-base-content/60 mt-4">Memuat data invoice...</p>
          </div>
        </div>
      )}

      {pageData && (
        <div class="card bg-base-100 shadow-xl border border-base-content/10 overflow-hidden">
          
          <div class="p-6 pb-4 border-b border-base-200 flex items-start justify-between gap-3">
            <div class="space-y-1">
              <h1 class="text-xl font-bold tracking-tight text-base-content">Pembayaran Aktivasi</h1>
              <p class="text-xs text-base-content/60">Aktivasi toko instan UMKM Site Builder</p>
            </div>
            
            {pageData.status === 'completed' ? (
              <div class="badge badge-success gap-1 text-success-content font-bold text-xs py-3 px-3 shrink-0">
                <span class="material-symbols-outlined text-[14px]">check_circle</span>
                Lunas
              </div>
            ) : pageData.status === 'failed' ? (
              <div class="badge badge-error gap-1 text-error-content font-bold text-xs py-3 px-3 shrink-0">
                <span class="material-symbols-outlined text-[14px]">cancel</span>
                Gagal
              </div>
            ) : (
              <div class="badge badge-warning gap-1 text-warning-content font-bold text-xs py-3 px-3 shrink-0 animate-pulse">
                <span class="material-symbols-outlined text-[14px]">schedule</span>
                Menunggu
              </div>
            )}
          </div>

          <div class="card-body p-6 space-y-5">
            
            <div class="bg-base-200/80 rounded-xl p-3.5 border border-base-content/5 flex items-center justify-between gap-2">
              <div class="min-w-0 flex-1">
                <span class="text-[10px] font-bold uppercase tracking-wider text-base-content/50 block mb-0.5">Nomor Invoice</span>
                <code class="text-xs font-mono font-semibold text-base-content block truncate select-all">{pageData.invoiceId}</code>
              </div>
              <button
                type="button"
                class="btn btn-ghost btn-sm btn-square text-base-content/70 hover:text-primary shrink-0"
                title="Salin Nomor Invoice"
                onclick={`
                  navigator.clipboard.writeText('${pageData.invoiceId}');
                  const toast = document.getElementById('copy_toast');
                  if (toast) {
                    toast.classList.remove('hidden');
                    toast.classList.add('opacity-100');
                    setTimeout(() => {
                      toast.classList.remove('opacity-100');
                      toast.classList.add('opacity-0');
                      setTimeout(() => toast.classList.add('hidden'), 200);
                    }, 2200);
                  }
                `}
              >
                <span class="material-symbols-outlined text-[18px]">content_copy</span>
              </button>
            </div>

            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs py-1">
                <div>
                  <p class="font-semibold text-base-content">Biaya Aktivasi Akun UMKM</p>
                  <p class="text-[11px] text-base-content/50">1x Aktivasi Tenant Standard</p>
                </div>
                <p class="font-semibold text-base-content">{pageData.amountFormatted}</p>
              </div>

              <div class="divider my-1"></div>

              <div class="flex items-baseline justify-between pt-1">
                <span class="text-xs font-semibold text-base-content/70">Total Tagihan</span>
                <div class="text-right">
                  <span class="text-2xl font-black text-primary tracking-tight">{pageData.amountFormatted}</span>
                </div>
              </div>

              {pageData.status === 'pending' && (
                <div class="flex items-center justify-center gap-1.5 py-1 text-[11px] font-medium text-warning">
                  <span class="material-symbols-outlined text-[14px]">timer</span>
                  Berlaku selama 24 jam ke depan
                </div>
              )}
            </div>

            <div class="pt-1">
              <PaymentStatus invoiceId={invoiceId} client:load />
            </div>

            {pageData.status === 'pending' && pageData.paymentUrl ? (
              <div class="space-y-2 pt-2">
                <button
                  type="button"
                  class="btn btn-primary w-full shadow-lg shadow-primary/20 font-bold gap-2 text-primary-content"
                  onclick="document.getElementById('xendit_payment_modal').showModal()"
                >
                  <span class="material-symbols-outlined text-[20px]">payment</span>
                  Bayar Sekarang
                </button>
                <p class="text-[11px] text-center text-base-content/50">
                  Pembayaran aman didukung gateway resmi Xendit
                </p>
              </div>
            ) : pageData.status === 'completed' ? (
              <div class="pt-2">
                <a href="/" class="btn btn-primary w-full shadow-lg font-bold gap-2 text-primary-content">
                  <span class="material-symbols-outlined text-[20px]">dashboard</span>
                  Buka Dashboard Toko
                </a>
              </div>
            ) : null}

          </div>

          <div class="bg-base-200/50 px-6 py-3.5 border-t border-base-200 flex items-center justify-between text-[11px] text-base-content/60">
            <div class="flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[16px] text-success">lock</span>
              <span>Enkripsi 256-bit</span>
            </div>
            <div class="flex items-center gap-2">
              <a href="#" class="link link-hover">Bantuan</a>
              <span>•</span>
              <a href="#" class="link link-hover">Hubungi CS</a>
            </div>
          </div>

        </div>
      )}

    </div>

    {pageData?.paymentUrl && (
      <dialog id="xendit_payment_modal" class="modal modal-bottom sm:modal-middle">
        <div class="modal-box w-11/12 max-w-2xl p-0 overflow-hidden bg-base-100 border border-base-content/10">
          
          <div class="flex justify-between items-center px-4 py-3 border-b border-base-200 bg-base-200/50">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-[20px]">verified_user</span>
              <h3 class="font-bold text-xs text-base-content">Gateway Pembayaran Xendit</h3>
            </div>
            <form method="dialog">
              <button class="btn btn-sm btn-circle btn-ghost text-base-content/70 hover:text-base-content">
                <span class="material-symbols-outlined text-[18px]">close</span>
              </button>
            </form>
          </div>

          <div class="w-full h-[620px] bg-base-100">
            <iframe
              src={pageData.paymentUrl}
              class="w-full h-full border-none"
              title="Xendit Checkout"
              allow="payment"
            ></iframe>
          </div>
        </div>

        <form method="dialog" class="modal-backdrop">
          <button>close</button>
        </form>
      </dialog>
    )}

    <div
      id="copy_toast"
      class="toast toast-top toast-end fixed z-50 p-4 transition-all duration-200 hidden opacity-0"
    >
      <div class="alert alert-success shadow-lg text-success-content text-xs font-semibold py-2 px-3 gap-2 rounded-lg">
        <span class="material-symbols-outlined text-[16px]">check_circle</span>
        <span>Nomor invoice berhasil disalin</span>
      </div>
    </div>

  </div>
</BaseLayout>