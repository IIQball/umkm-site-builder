---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import Button from '@/components/ui/Button.svelte';
import { getAuthenticatedUser } from '@/lib/auth';
import { db, stores } from '@/db';
import { eq } from 'drizzle-orm';
import CategoryManager from '@/components/dashboard/CategoryManager.svelte';

const user = await getAuthenticatedUser(Astro.request);
if (!user) return Astro.redirect("/auth/login");
if (user.role !== "tenant") return Astro.redirect("/dashboard");

const userStore = await db.query.stores.findFirst({
  where: eq(stores.userId, user.id),
});
---

<DashboardLayout title="Kategori Produk" breadcrumb="Kategori">
  <div class="min-h-full space-y-8 md:space-y-10 pb-10">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2">
      <div>
        <h1 class="text-heading-lg font-bold tracking-tight text-main">Manajemen Kategori</h1>
        <p class="text-body-base text-secondary mt-1 max-w-2xl leading-relaxed">
          Kelola daftar kategori produk dan organisir inventory toko Anda.
        </p>
      </div>
      <Button
        client:load
        id="add-category-btn"
        variant="primary"
        size="md"
        class="font-bold flex-shrink-0"
      >
        <span class="material-symbols-outlined text-base">add</span>
        <span>Tambah Kategori</span>
      </Button>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('add-category-btn');
        if (btn) {
          btn.addEventListener('click', () => {
            window.dispatchEvent(new CustomEvent('open-add-category'));
          });
        }
      });
    </script>

    <div class="animate-fade-in-up delay-100">
      <CategoryManager 
        client:load 
        storeId={userStore?.id || ''} 
        storeName={userStore?.name || 'Toko Anda'} 
      />
    </div>
  </div>
</DashboardLayout>
