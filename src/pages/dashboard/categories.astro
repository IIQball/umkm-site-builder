---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { getAuthenticatedUser } from '@/lib/auth';
import { db, stores } from '@/db';
import { eq } from 'drizzle-orm';
import CategoryManager from '@/components/dashboard/CategoryManager.svelte';

const user = await getAuthenticatedUser(Astro.request);
if (!user) return Astro.redirect("/auth/login");
if (user.role !== "tenant") return Astro.redirect("/dashboard");

// Fetch the tenant's store
const userStore = await db.query.stores.findFirst({
  where: eq(stores.userId, user.id),
});
---

<DashboardLayout title="Kategori Produk" breadcrumb="Kategori">
  <!-- Header Section -->
  <div class="mb-8 flex flex-col sm:flex-row sm:items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-main">
        Manajemen Kategori
      </h1>
      <p class="text-sm text-secondary mt-1">
        Kelola daftar kategori dan distribusinya per toko.
      </p>
    </div>
    <button id="add-category-btn" class="btn bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white border-none shadow-sm rounded-xl px-5">
      <span class="material-symbols-outlined text-[20px] mr-1">add</span>
      Tambah Kategori
    </button>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('add-category-btn');
      if (btn) {
        btn.addEventListener('click', () => {
          window.dispatchEvent(new CustomEvent('open-add-category'));
        });
      }
    });
  </script>

  <CategoryManager 
    client:load 
    storeId={userStore?.id || ''} 
    storeName={userStore?.name || 'Toko Anda'} 
  />
</DashboardLayout>
