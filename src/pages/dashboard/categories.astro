---
/**
 * pages/dashboard/categories.astro
 * Halaman Manajemen Kategori untuk Tenant
 */
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { getAuthenticatedUser } from '@/lib/auth';
import CategoryManager from '@/components/dashboard/CategoryManager.svelte';

const user = await getAuthenticatedUser(Astro.request);
if (!user) return Astro.redirect('/auth/login');
if (user.role !== 'tenant') return Astro.redirect('/dashboard');

---

<DashboardLayout title="Manajemen Kategori">
  <div class="max-w-5xl mx-auto space-y-8">
    <div class="space-y-1">
      <h1 class="text-3xl font-bold tracking-tight text-base-content">Manajemen Kategori</h1>
      <p class="text-base-content/60 text-sm">Kelola kategori untuk mengelompokkan produk Anda secara rapi.</p>
    </div>

    <CategoryManager client:load />
  </div>
</DashboardLayout>
