---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { getAuthenticatedUser } from '@/lib/auth';
import CategoryManager from '@/components/dashboard/CategoryManager.svelte';

const user = await getAuthenticatedUser(Astro.request);
if (!user) return Astro.redirect("/auth/login");
if (user.role !== "tenant") return Astro.redirect("/dashboard");
---

<DashboardLayout title="Kategori Produk" breadcrumb="Kategori">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-base-content">
        Manajemen Kategori
      </h1>
      <p class="text-xs sm:text-sm text-base-content/60 mt-1">
        Kelola daftar kategori produk untuk memudahkan pembeli menavigasi katalog toko Anda.
      </p>
    </div>

    <CategoryManager client:load />
  </div>
</DashboardLayout>
