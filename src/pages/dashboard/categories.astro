---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CategoryManager from '@/components/dashboard/CategoryManager.svelte';
import { LayoutDashboard, Package, Tag, Settings, LogOut } from 'lucide-svelte';
---

<BaseLayout title="Manajemen Kategori - Dashboard">
  <div class="drawer lg:drawer-open min-h-screen bg-base-200">
    <input id="dashboard-drawer" type="checkbox" class="drawer-toggle" />
    
    <!-- Sidebar -->
    <div class="drawer-side z-20">
      <label for="dashboard-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
      <div class="menu p-4 w-80 min-h-full bg-base-100 text-base-content flex flex-col">
        <div class="px-4 py-6 mb-4">
          <h1 class="text-2xl font-bold text-primary flex items-center gap-2">
            <LayoutDashboard size={24} />
            UMKM Builder
          </h1>
        </div>
        
        <ul class="space-y-1 flex-1">
          <li>
            <a href="/tenant/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-base-200">
              <LayoutDashboard size={20} />
              Dashboard
            </a>
          </li>
          <li>
            <a href="/dashboard/products" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-base-200">
              <Package size={20} />
              Produk
            </a>
          </li>
          <li>
            <a href="/dashboard/categories" class="flex items-center gap-3 px-4 py-3 rounded-lg bg-primary text-primary-content">
              <Tag size={20} />
              Kategori
            </a>
          </li>
          <li>
            <a href="/tenant/builder" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-base-200">
              <Settings size={20} />
              Store Builder
            </a>
          </li>
        </ul>

        <div class="mt-auto border-t border-base-200 pt-4">
          <button class="btn btn-ghost w-full justify-start gap-3 text-error">
            <LogOut size={20} />
            Keluar
          </button>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="drawer-content flex flex-col">
      <!-- Navbar (Mobile) -->
      <div class="navbar bg-base-100 lg:hidden shadow-sm">
        <div class="flex-none">
          <label for="dashboard-drawer" class="btn btn-square btn-ghost">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-5 h-5 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </label>
        </div>
        <div class="flex-1">
          <a class="btn btn-ghost normal-case text-xl">Dashboard</a>
        </div>
      </div>

      <main class="p-6 md:p-8 max-w-6xl mx-auto w-full">
        <CategoryManager client:load />
      </main>
    </div>
  </div>
</BaseLayout>
