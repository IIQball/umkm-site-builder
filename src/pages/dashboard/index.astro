---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import StatCard from '@/components/ui/StatCard.svelte';
import ChartWidget from '@/components/dashboard/ChartWidget.svelte';
import { getAuthenticatedUser } from '@/lib/auth';
import { db } from '@/lib/db/client';
import { stores } from '@/db/schema';
import { eq } from 'drizzle-orm';
import { getStoreTrafficSeries, type TrafficPoint } from '@/services/analytics.service';

const user = await getAuthenticatedUser(Astro.request);
if (!user) return Astro.redirect('/auth/login');
if (user.role === 'designer') return Astro.redirect('/designer/wallet');
if (user.role === 'superadmin') return Astro.redirect('/superadmin');
if (user.role === 'admin') return Astro.redirect('/admin');

const store = await db.query.stores.findFirst({
  where: eq(stores.userId, user.id),
  with: {
    registrar: {
      columns: { name: true },
    },
  },
});

// Data awal grafik (12 bulan) dirender dari server supaya grafik langsung muncul.
// Jika tabel statistik belum dibuat / query gagal, dashboard tetap tampil tanpa grafik error.
let initialPoints: TrafficPoint[] = [];
let initialPointsFailed = false;
if (store?.id) {
  try {
    initialPoints = await getStoreTrafficSeries(store.id, '12m');
  } catch (error) {
    initialPointsFailed = true;
    console.error('[DASHBOARD] gagal memuat data grafik:', error);
  }
}

const managedByAdmin = store?.registeredBy && store.registrar ? { name: store.registrar.name } : null;

const storeData = store || {
  id: '',
  totalViews: 0,
  totalWaClicks: 0,
  customization: {},
};

const customization = storeData.customization as Record<string, unknown> | undefined;
const isOnboarded = customization?.isOnboarded === true;

const conversionRate = storeData.totalViews > 0
  ? ((storeData.totalWaClicks / storeData.totalViews) * 100).toFixed(1)
  : '0.0';

const engagementScore = Math.min(
  Math.round((parseInt(conversionRate) / 100) * 100),
  100
);

const currentHour = new Date().getHours();
let greeting = 'Selamat Datang';
if (currentHour >= 4 && currentHour < 11) {
  greeting = 'Selamat Pagi';
} else if (currentHour >= 11 && currentHour < 15) {
  greeting = 'Selamat Siang';
} else if (currentHour >= 15 && currentHour < 18.5) {
  greeting = 'Selamat Sore';
} else {
  greeting = 'Selamat Malam';
}
---

<DashboardLayout title="Dashboard">
  <div class="min-h-full space-y-8 md:space-y-10 pb-10">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2">
      <div>
        <h1 class="text-heading-lg text-main font-bold tracking-tight flex items-center gap-2.5">
          <span>{greeting}, {user.name ? user.name.split(' ')[0] : 'Pengguna'}!</span>
        </h1>
        {managedByAdmin && (
          <span class="inline-flex items-center gap-1.5 px-3 py-1 mt-2 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            Didampingi oleh Admin {managedByAdmin.name}
          </span>
        )}
        <p class="text-body-base text-secondary mt-3 max-w-2xl leading-relaxed">
          Pantau pengunjung toko online dan aktivitas pelanggan Anda secara real-time.
        </p>
      </div>
    </div>

    <!-- Analytics Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <StatCard 
        client:load
        label="Total Views" 
        value={storeData.totalViews} 
        rawValue={storeData.totalViews}
        icon="visibility" 
        cardTheme="dark"
        badge="Pengunjung"
        footerText="Total kunjungan toko"
        delayClass="delay-100"
      />
      <StatCard 
        client:load
        label="WhatsApp Clicks" 
        value={storeData.totalWaClicks} 
        rawValue={storeData.totalWaClicks}
        icon="message" 
        cardTheme="default"
        badge="Kontak"
        footerText="Klik hubungi via WhatsApp"
        delayClass="delay-150"
      />
      <StatCard 
        client:load
        label="Conversion Rate" 
        value={`${conversionRate}%`} 
        rawValue={parseFloat(conversionRate)}
        icon="trending_up" 
        cardTheme="orange"
        badge="Metrik"
        footerText="Persentase konversi pengunjung"
        delayClass="delay-200"
      />
      <StatCard 
        client:load
        label="Engagement Score" 
        value={engagementScore} 
        rawValue={engagementScore}
        icon="poll" 
        cardTheme="blue"
        badge="Skor"
        valueSuffix="/ 100"
        footerText="Skor engagement toko"
        delayClass="delay-250"
      />
    </div>

    <!-- Chart Widget -->
    <div class="animate-fade-in-up delay-300">
      <ChartWidget 
        client:load 
        totalViews={storeData.totalViews}
        totalClicks={storeData.totalWaClicks}
        isOnboarded={isOnboarded}
        initialPoints={initialPoints}
        initialFailed={initialPointsFailed}
      />
    </div>

    <!-- Store Settings Link -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 animate-fade-in-up delay-500">
      <a href="/dashboard/store" class="group p-6 rounded-3xl bg-card border border-light shadow-xs hover:shadow-md hover:border-primary/40 transition-all">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-bold uppercase tracking-wider text-muted">Pengaturan Toko</h3>
          <span class="material-symbols-outlined text-base text-muted group-hover:text-primary transition-colors">arrow_forward</span>
        </div>
        <p class="text-body-base text-secondary">Kelola informasi toko, subdomain, dan kontak bisnis Anda</p>
      </a>
    </div>
  </div>
</DashboardLayout>
