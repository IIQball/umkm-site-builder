---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import TenantOrdersOverview from '@/components/dashboard/TenantOrdersOverview.svelte';
import Button from '@/components/ui/Button.svelte';
import { getAuthenticatedUser } from '@/lib/auth';
import { db } from '@/lib/db/client';
import { eq, and, desc } from 'drizzle-orm';
import { transactions, stores, users } from '@/db/schema';
import { getPaginationParams, paginate } from '@/lib/pagination/server';
import type { PaginatedResult } from '@/types/common';

export const prerender = false;

const user = await getAuthenticatedUser(Astro.request);
if (!user) {
  return Astro.redirect('/auth/login');
}

if (user.role !== 'tenant' && user.role !== 'admin' && user.role !== 'superadmin') {
  return Astro.redirect('/dashboard');
}

const { page } = getPaginationParams(Astro.url);
const whereClause = and(
  eq(transactions.userId, user.id),
  eq(transactions.type, 'template_purchase'),
);

let initialOrders: any[] = [];
let paginationResult: PaginatedResult<any> = {
  data: [],
  totalItems: 0,
  totalPages: 1,
  currentPage: page,
  pageSize: 10,
};

try {
  const queryBuilder = (limit: number, offset: number) =>
    db.query.transactions.findMany({
      where: whereClause,
      columns: {
        id: true,
        userId: true,
        type: true,
        amount: true,
        adminFee: true,
        status: true,
        storeId: true,
        templateId: true,
        assistedBy: true,
        externalId: true,
        paymentGatewayRef: true,
        paymentChannel: true,
        createdAt: true,
      },
      with: {
        template: {
          columns: {
            id: true,
            name: true,
            thumbnailUrl: true,
            price: true,
          },
        },
        assistant: {
          columns: { id: true, name: true, email: true },
        },
      },
      orderBy: [desc(transactions.createdAt)],
      limit,
      offset,
    });

  paginationResult = await paginate(db, transactions, queryBuilder, whereClause, page);
  initialOrders = paginationResult.data || [];
} catch {
  initialOrders = [];
}

const tenantStore = await db.query.stores.findFirst({
  where: eq(stores.userId, user.id),
  columns: { name: true },
});

const tenantUser = await db.query.users.findFirst({
  where: eq(users.id, user.id),
  columns: { name: true, email: true, registeredBy: true },
});

let registeringAdmin: { name: string; email: string } | null = null;
if (tenantUser?.registeredBy) {
  const adminRec = await db.query.users.findFirst({
    where: eq(users.id, tenantUser.registeredBy),
    columns: { name: true, email: true },
  });
  if (adminRec) {
    registeringAdmin = adminRec;
  }
}

const ordersWithMerchant = initialOrders.map((o) => {
  const isRegisteredByAdmin = Boolean(tenantUser?.registeredBy);
  const adminName = isRegisteredByAdmin
    ? (o.assistant?.name || registeringAdmin?.name || null)
    : null;
  const adminEmail = isRegisteredByAdmin
    ? (o.assistant?.email || registeringAdmin?.email || null)
    : null;

  return {
    ...o,
    merchantName: tenantUser?.name || user.name || user.email,
    merchantEmail: tenantUser?.email || user.email,
    storeName: tenantStore?.name || 'Belum Membuat Toko',
    adminName,
    adminEmail,
  };
});
---

<DashboardLayout title="Riwayat Pesanan Template" breadcrumb="Dashboard / Riwayat Pesanan">
  <div class="min-h-full space-y-8 md:space-y-10 pb-10">
    <!-- Page Header (matching designer/wallet & designer/templates style) -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2">
      <div>
        <h1 class="text-heading-lg text-main font-bold tracking-tight flex items-center gap-2.5">
          <span>Riwayat Pesanan & Tagihan</span>
        </h1>
        <p class="text-body-base text-secondary mt-1 max-w-2xl leading-relaxed">
          Pantau status invoice pembayaran template toko online Anda, selesaikan tagihan pending, dan unduh bukti faktur resmi.
        </p>
      </div>

      <!-- Quick Action Pill -->
      <div class="flex items-center gap-2 flex-shrink-0">
        <Button
          client:load
          href="/dashboard/templates"
          variant="secondary"
          size="md"
          class="font-bold"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0" aria-hidden="true">
            <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/>
            <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/>
            <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/>
            <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/>
            <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>
          </svg>
          <span>Galeri Template Toko</span>
        </Button>
      </div>
    </div>

    <!-- Master Tenant Orders Overview (Period Filter, Statcards & Interactive Table) -->
    <TenantOrdersOverview client:load allOrders={ordersWithMerchant} pagination={paginationResult} />
  </div>
</DashboardLayout>

