---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import ProductTable from '@/components/tenant/ProductTable.svelte';
import StatCard from '@/components/ui/StatCard.svelte';
import Button from '@/components/ui/Button.svelte';
import { db } from '@/lib/db/client';
import { storeCategories, stores, products } from '@/db/schema';
import { eq, isNull, and } from 'drizzle-orm';
import { getAuthenticatedUser } from '@/lib/auth';

const user = await getAuthenticatedUser(Astro.request);
if (!user) return Astro.redirect('/auth/login');

const userStores = await db.select()
  .from(stores)
  .where(and(eq(stores.userId, user.id), isNull(stores.deletedAt)))
  .limit(1);

const hasStore = userStores.length > 0;
const STORE_ID = hasStore ? userStores[0].id : null;

const categories = hasStore 
  ? await db.select()
      .from(storeCategories)
      .where(and(
        eq(storeCategories.storeId, STORE_ID!), 
        isNull(storeCategories.deletedAt)
      ))
  : [];

const productList = hasStore
  ? await db.select()
      .from(products)
      .where(and(
        eq(products.storeId, STORE_ID!),
        isNull(products.deletedAt)
      ))
  : [];

const totalProducts = productList.length;
const activeProducts = productList.filter(p => p.status === 'active').length;
const lowStockProducts = productList.filter(p => p.stock !== null && p.stock < 5).length;
---

<DashboardLayout title="Manajemen Produk" breadcrumb="Produk">
  <div class="min-h-full space-y-8 md:space-y-10 pb-10">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2">
      <div>
        <h1 class="text-heading-lg font-bold tracking-tight text-main">Manajemen Produk</h1>
        <p class="text-body-base text-secondary mt-1 max-w-2xl leading-relaxed">Kelola daftar produk, varian, dan harga untuk toko Anda.</p>
      </div>
      {hasStore ? (
        <Button
          client:load
          id="add-product-btn"
          variant="primary"
          size="md"
          class="font-bold flex-shrink-0"
        >
          <span class="material-symbols-outlined text-base">add</span>
          <span>Tambah Produk</span>
        </Button>
      ) : null}
    </div>
    
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('add-product-btn');
        if (btn) {
          btn.addEventListener('click', () => {
            window.dispatchEvent(new CustomEvent('open-add-product'));
          });
        }
      });
    </script>

    {hasStore && (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <StatCard 
          client:load
          label="Total Produk" 
          value={totalProducts} 
          rawValue={totalProducts}
          icon="shopping_bag" 
          cardTheme="dark"
          badge="Katalog"
          footerText="Jumlah produk dibuat"
          delayClass="delay-100"
        />
        <StatCard 
          client:load
          label="Produk Aktif" 
          value={activeProducts} 
          rawValue={activeProducts}
          icon="check_circle" 
          cardTheme="default"
          badge="Aktif"
          footerText="Tersedia untuk dijual"
          delayClass="delay-150"
        />
        <StatCard 
          client:load
          label="Stok Terbatas" 
          value={lowStockProducts} 
          rawValue={lowStockProducts}
          icon="warning" 
          cardTheme="orange"
          badge="Perhatian"
          footerText="Produk dengan stok < 5"
          delayClass="delay-200"
        />
        <StatCard 
          client:load
          label="Kategori" 
          value={categories.length} 
          rawValue={categories.length}
          icon="layers" 
          cardTheme="blue"
          badge="Organisir"
          footerText="Kategori produk toko"
          delayClass="delay-250"
        />
      </div>
    )}

    <div class="animate-fade-in-up {hasStore ? 'delay-300' : 'delay-100'}">
      {hasStore ? (
        <ProductTable client:load storeId={STORE_ID!} categories={categories} />
      ) : (
        <div class="bg-card border border-light shadow-sm rounded-2xl overflow-hidden p-6 text-center py-12">
          <span class="material-symbols-outlined text-6xl text-muted/30 mb-4">store_off</span>
          <h3 class="text-lg font-bold text-main mb-2">Toko Belum Diatur</h3>
          <p class="text-secondary mb-6">Anda belum memiliki toko yang aktif. Silakan buat atau atur toko Anda terlebih dahulu.</p>
          <Button
            client:load
            href="/dashboard/store"
            variant="primary"
            size="md"
            class="font-bold"
          >
            Atur Toko Sekarang
          </Button>
        </div>
      )}
    </div>
  </div>
</DashboardLayout>
