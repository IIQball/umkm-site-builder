---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import ProductTable from '@/components/tenant/ProductTable.svelte';
import { db } from '@/lib/db/client';
import { storeCategories, stores } from '@/db/schema';
import { eq, isNull, and } from 'drizzle-orm';
import { getAuthenticatedUser } from '@/lib/auth';

const user = await getAuthenticatedUser(Astro.request);
if (!user) return Astro.redirect('/auth/login');

const userStores = await db.select()
  .from(stores)
  .where(and(eq(stores.userId, user.id), isNull(stores.deletedAt)))
  .limit(1);

const hasStore = userStores.length > 0;
const STORE_ID = hasStore ? userStores[0].id : null;

const categories = hasStore 
  ? await db.select()
      .from(storeCategories)
      .where(and(
        eq(storeCategories.storeId, STORE_ID!), 
        isNull(storeCategories.deletedAt)
      ))
  : [];
---

<DashboardLayout title="Manajemen Produk" breadcrumb="Produk">
  <div class="mb-8 flex flex-col sm:flex-row sm:items-start justify-between gap-4">
    <div>
      <h1 class="text-heading-lg font-bold tracking-tight text-main">Manajemen Produk</h1>
      <p class="text-body-base text-secondary mt-1 max-w-2xl leading-relaxed">Kelola daftar produk, varian, dan harga untuk toko Anda.</p>
    </div>
    {hasStore ? (
      <button id="add-product-btn" class="bg-primary text-white hover:bg-primary/90 font-bold shadow-sm rounded-xl px-5 py-2.5 flex items-center transition-all cursor-pointer">
        <span class="material-symbols-outlined text-lg mr-1.5">add</span>
        Tambah Produk
      </button>
    ) : null}
  </div>
  
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('add-product-btn');
      if (btn) {
        btn.addEventListener('click', () => {
          window.dispatchEvent(new CustomEvent('open-add-product'));
        });
      }
    });
  </script>
  
  <div>
    {hasStore ? (
      <ProductTable client:load storeId={STORE_ID!} categories={categories} />
    ) : (
      <div class="bg-base-100 border border-base-200 shadow-sm rounded-2xl overflow-hidden p-6 text-center py-12">
        <span class="material-symbols-outlined text-6xl text-base-content/20 mb-4">store_off</span>
        <h3 class="text-lg font-bold text-base-content mb-2">Toko Belum Diatur</h3>
        <p class="text-base-content/60 mb-6">Anda belum memiliki toko yang aktif. Silakan buat atau atur toko Anda terlebih dahulu.</p>
        <a href="/dashboard/store" class="bg-primary text-white hover:bg-primary/90 font-bold px-6 py-3 rounded-xl inline-block transition-all shadow-sm">Atur Toko Sekarang</a>
      </div>
    )}
  </div>
</DashboardLayout>
