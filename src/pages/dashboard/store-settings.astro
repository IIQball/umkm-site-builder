---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import StoreSettingsForm from '../../components/dashboard/StoreSettingsForm.svelte';
import StatCard from '../../components/ui/StatCard.svelte';
import { getAuthenticatedUser } from '../../lib/auth';
import { db } from '../../db';
import { stores } from '../../db/schema';
import { eq } from 'drizzle-orm';

const user = await getAuthenticatedUser(Astro.request);
if (!user) {
  return Astro.redirect('/auth/login');
}

if (user.role !== 'tenant') {
  return Astro.redirect('/dashboard');
}

const [store] = await db.select().from(stores).where(eq(stores.userId, user.id));
if (!store) {
  return Astro.redirect('/onboarding');
}

const customization = (store.customization as Record<string, unknown>) || {};
const isOpen = customization.isOpen !== false;
---

<DashboardLayout title="Pengaturan Toko">
  <div class="min-h-full space-y-8 md:space-y-10 pb-10">
    <div class="pb-2">
      <h1 class="text-heading-lg font-bold tracking-tight text-main">Pengaturan Toko</h1>
      <p class="text-body-base text-secondary mt-1 max-w-2xl leading-relaxed">
        Kelola informasi profil toko, kontak bisnis, dan preferensi tampilan Anda.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <StatCard 
        client:load
        label="Nama Toko" 
        value={store.name || '—'} 
        icon="storefront" 
        cardTheme="dark"
        badge="Bisnis"
        footerText="Nama toko Anda"
        delayClass="delay-100"
      />
      <StatCard 
        client:load
        label="Subdomain Toko" 
        value={store.subdomain || '—'} 
        icon="link" 
        cardTheme="default"
        badge="URL"
        footerText="Domain unik toko"
        delayClass="delay-150"
      />
      <StatCard 
        client:load
        label="Kontak WhatsApp" 
        value={store.waNumber ? '✓' : '—'} 
        icon="message" 
        cardTheme="blue"
        badge="Hubungi"
        footerText="Nomor WhatsApp bisnis"
        delayClass="delay-200"
      />
    </div>

    <div class="animate-fade-in-up delay-300">
      <StoreSettingsForm
        client:load
        subdomain={store.subdomain}
        initialStoreName={store.name}
        initialWaNumber={store.waNumber}
        initialGoogleMapsUrl={store.googleMapsUrl || ''}
        initialIsOpen={isOpen}
      />
    </div>
  </div>
</DashboardLayout>