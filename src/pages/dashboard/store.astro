---
/**
 * pages/dashboard/store.astro
 * Halaman Pengaturan Toko untuk Tenant
 */
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { getAuthenticatedUser } from '@/lib/auth';
import StoreManager from '@/components/dashboard/StoreManager.svelte';
import { db, stores } from '@/db';
import { eq } from 'drizzle-orm';

const user = await getAuthenticatedUser(Astro.request);
if (!user) return Astro.redirect('/auth/login');
if (user.role !== 'tenant') return Astro.redirect('/dashboard');

// Ambil data toko jika ada
const userStore = await db.query.stores.findFirst({
  where: eq(stores.userId, user.id),
});

// Jika kita belum memiliki toko, kita set null
const initialStoreData = userStore ? {
  id: userStore.id,
  name: userStore.name,
  subdomain: userStore.subdomain,
  waNumber: userStore.waNumber,
  googleMapsUrl: userStore.googleMapsUrl || '',
} : null;

---

<DashboardLayout title="Pengaturan Toko">
  <div class="max-w-4xl mx-auto space-y-8">
    <div class="space-y-1">
      <h1 class="text-3xl font-bold tracking-tight text-base-content">Pengaturan Toko</h1>
      <p class="text-base-content/60 text-sm">Kelola informasi dasar toko, tautan, dan preferensi tampilan Anda.</p>
    </div>

    <StoreManager client:load initialData={initialStoreData} />
  </div>
</DashboardLayout>
