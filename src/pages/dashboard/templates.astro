---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import TemplateGallery from '../../components/dashboard/TemplateGallery.svelte';
import { getAuthenticatedUser } from '../../lib/auth';
import { db } from '../../db';
import { stores } from '../../db/schema';
import { eq } from 'drizzle-orm';

const user = await getAuthenticatedUser(Astro.request);
if (!user) {
  return Astro.redirect('/auth/login');
}

if (user.role !== 'tenant') {
  return Astro.redirect('/dashboard');
}

const [store] = await db.select().from(stores).where(eq(stores.userId, user.id));
if (!store) {
  return Astro.redirect('/onboarding');
}
---

<DashboardLayout title="Pilih Template">
  <div class="p-6">
    <div class="mb-8">
      <h1 class="text-3xl font-bold">Galeri Template</h1>
      <p class="text-base-content/70 mt-2">
        Pilih template untuk tampilan toko Anda. Template yang diterapkan akan langsung mengubah desain toko.
      </p>
    </div>

    <TemplateGallery
      client:load
      storeId={store.id}
      currentTemplateId={store.templateId}
    />
  </div>
</DashboardLayout>
