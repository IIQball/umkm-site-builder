---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import DesignerOrdersOverview from "@/components/designer/DesignerOrdersOverview.svelte";
import Button from "@/components/ui/Button.svelte";
import { getAuthenticatedUser, isAuthorizedDesigner } from "@/lib/auth";
import { transactionService } from "@/services/finance/transaction.service";
import { getPaginationParams, paginate } from "@/lib/pagination/server";
import { db } from "@/lib/db/client";
import { templates, transactions } from "@/db/schema";
import { eq, inArray, and, desc } from "drizzle-orm";
import type { PaginatedResult } from "@/types/common";

export const prerender = false;

const user = await getAuthenticatedUser(Astro.request);
if (!user || !isAuthorizedDesigner(user)) {
  return Astro.redirect("/auth/login?redirect=/designer/orders");
}

const { page } = getPaginationParams(Astro.url);

let initialOrders: Awaited<
  ReturnType<typeof transactionService.getDesignerIncomingOrders>
> = [];

let pagination: PaginatedResult<any> = {
  data: [],
  totalItems: 0,
  totalPages: 1,
  currentPage: page,
  pageSize: 10,
};

try {
  const designerTemplates = await db.query.templates.findMany({
    where: eq(templates.designerId, user.id),
    columns: { id: true },
  });
  const templateIds = designerTemplates.map((t) => t.id);

  if (templateIds.length > 0) {
    const whereCondition = and(
      inArray(transactions.templateId, templateIds),
      eq(transactions.type, "template_purchase"),
    );

    pagination = await paginate<any>(
      db,
      transactions,
      (limit, offset) =>
        db.query.transactions.findMany({
          where: whereCondition,
          columns: {
            id: true,
            userId: true,
            type: true,
            amount: true,
            adminFee: true,
            status: true,
            storeId: true,
            templateId: true,
            assistedBy: true,
            externalId: true,
            paymentGatewayRef: true,
            paymentChannel: true,
            createdAt: true,
          },
          with: {
            template: {
              columns: {
                id: true,
                name: true,
                thumbnailUrl: true,
                price: true,
              },
            },
            user: {
              columns: { id: true, name: true, email: true, image: true },
            },
            commission: {
              columns: {
                id: true,
                designerAmount: true,
                platformFee: true,
                totalAmount: true,
              },
            },
          },
          orderBy: [desc(transactions.createdAt)],
          limit,
          offset,
        }),
      whereCondition,
      page,
    );
    initialOrders = pagination.data;
  }
} catch {
  initialOrders = [];
}
---

<DashboardLayout title="Pesanan Masuk" breadcrumb="Desainer / Pesanan Masuk">
  <div class="min-h-full space-y-8 md:space-y-10 pb-10">
    <!-- Page Header (matching designer/wallet & designer/templates style) -->
    <div
      class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2"
    >
      <div>
        <h1
          class="text-heading-lg text-main font-bold tracking-tight flex items-center gap-2.5"
        >
          <span>Pesanan Template Masuk</span>
        </h1>
        <p class="text-body-base text-secondary mt-1 max-w-2xl leading-relaxed">
          Pantau seluruh aktivitas transaksi pembelian template toko online Anda
          oleh tenant UMKM secara real-time.
        </p>
      </div>

      <!-- Quick Actions / Link -->
      <div class="flex items-center gap-2 flex-shrink-0">
        <Button
          client:load
          href="/designer/wallet"
          variant="secondary"
          size="md"
          class="font-bold"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0" aria-hidden="true">
            <path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/>
            <path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>
          </svg>
          <span>Buka Dompet Keuangan</span>
        </Button>
      </div>
    </div>

    <!-- Master Designer Orders Overview (Period Filter, Statcards & Interactive Table) -->
    <DesignerOrdersOverview client:load allOrders={initialOrders} pagination={pagination} />
  </div>
</DashboardLayout>

