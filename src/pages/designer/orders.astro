---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import DesignerOrdersTable from '@/components/designer/DesignerOrdersTable.svelte';
import StatCard from '@/components/ui/StatCard.svelte';
import Button from '@/components/ui/Button.svelte';
import { getAuthenticatedUser, isAuthorizedDesigner } from '@/lib/auth';
import { transactionService } from '@/services/finance/transaction.service';
import { formatIDR } from '@/lib/currency';

export const prerender = false;

const user = await getAuthenticatedUser(Astro.request);
if (!user || !isAuthorizedDesigner(user)) {
  return Astro.redirect('/auth/login?redirect=/designer/orders');
}

let initialOrders: Awaited<ReturnType<typeof transactionService.getDesignerIncomingOrders>> = [];
try {
  initialOrders = await transactionService.getDesignerIncomingOrders(user.id);
} catch {
  initialOrders = [];
}

const totalPaidOrders = initialOrders.filter((o) => o.status === 'success');
const totalPendingOrders = initialOrders.filter((o) => o.status === 'pending');
const totalFailedOrders = initialOrders.filter((o) => o.status === 'failed' || o.status === 'expired' || o.status === 'canceled');

const totalNetEarned = totalPaidOrders.reduce(
  (sum, o) => sum + (o.commission?.designerAmount ?? Math.round(o.amount * 0.7)),
  0
);

const formattedNetIncome = formatIDR(totalNetEarned);
---

<DashboardLayout title="Pesanan Masuk" breadcrumb="Desainer / Pesanan Masuk">
  <div class="min-h-full space-y-8 md:space-y-10 pb-10">
    <!-- Page Header (matching designer/wallet & designer/templates style) -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2">
      <div>
        <h1 class="text-heading-lg text-main font-bold tracking-tight flex items-center gap-2.5">
          <span>Pesanan Template Masuk</span>
        </h1>
        <p class="text-body-base text-secondary mt-1 max-w-2xl leading-relaxed">
          Pantau seluruh aktivitas transaksi pembelian template toko online Anda oleh tenant UMKM secara real-time.
        </p>
      </div>

      <!-- Quick Actions / Link -->
      <div class="flex items-center gap-2 flex-shrink-0">
        <Button
          client:load
          href="/designer/wallet"
          variant="secondary"
          size="md"
          class="font-bold"
        >
          <span class="material-symbols-outlined text-primary text-base">account_balance_wallet</span>
          <span>Buka Dompet Keuangan</span>
        </Button>
      </div>
    </div>

    <!-- Statcards Grid (animated on client load) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 sm:gap-6">
      <StatCard
        client:load
        label="Total Pesanan"
        value={initialOrders.length}
        rawValue={initialOrders.length}
        icon="receipt_long"
        cardTheme="dark"
        badge="Semua Tagihan"
        footerText="Akumulasi seluruh pesanan"
        delayClass="delay-100"
      />
      <StatCard
        client:load
        label="Hak Komisi Lunas"
        value={formattedNetIncome}
        rawValue={totalNetEarned}
        icon="payments"
        cardTheme="default"
        badge="Lunas"
        footerText="Total pendapatan bersih"
        delayClass="delay-150"
      />
      <StatCard
        client:load
        label="Menunggu Pembayaran"
        value={totalPendingOrders.length}
        rawValue={totalPendingOrders.length}
        icon="hourglass_top"
        cardTheme="orange"
        badge="Pending"
        footerText="Belum diselesaikan tenant"
        delayClass="delay-200"
      />
      <StatCard
        client:load
        label="Batal / Kedaluwarsa"
        value={totalFailedOrders.length}
        rawValue={totalFailedOrders.length}
        icon="cancel"
        cardTheme="blue"
        badge="Expired"
        footerText="Invoice tidak diselesaikan"
        delayClass="delay-250"
      />
    </div>

    <!-- Interactive Table Card -->
    <div class="animate-fade-in-up delay-300">
      <DesignerOrdersTable client:load {initialOrders} />
    </div>
  </div>
</DashboardLayout>
