---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import DesignerOrdersOverview from "@/components/designer/DesignerOrdersOverview.svelte";
import Button from "@/components/ui/Button.svelte";
import { getAuthenticatedUser, isAuthorizedDesigner } from "@/lib/auth";
import { transactionService } from "@/services/finance/transaction.service";

export const prerender = false;

const user = await getAuthenticatedUser(Astro.request);
if (!user || !isAuthorizedDesigner(user)) {
  return Astro.redirect("/auth/login?redirect=/designer/orders");
}

let initialOrders: Awaited<
  ReturnType<typeof transactionService.getDesignerIncomingOrders>
> = [];
try {
  initialOrders = await transactionService.getDesignerIncomingOrders(user.id);
} catch {
  initialOrders = [];
}
---

<DashboardLayout title="Pesanan Masuk" breadcrumb="Desainer / Pesanan Masuk">
  <div class="min-h-full space-y-8 md:space-y-10 pb-10">
    <!-- Page Header (matching designer/wallet & designer/templates style) -->
    <div
      class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2"
    >
      <div>
        <h1
          class="text-heading-lg text-main font-bold tracking-tight flex items-center gap-2.5"
        >
          <span>Pesanan Template Masuk</span>
        </h1>
        <p class="text-body-base text-secondary mt-1 max-w-2xl leading-relaxed">
          Pantau seluruh aktivitas transaksi pembelian template toko online Anda
          oleh tenant UMKM secara real-time.
        </p>
      </div>

      <!-- Quick Actions / Link -->
      <div class="flex items-center gap-2 flex-shrink-0">
        <Button
          client:load
          href="/designer/wallet"
          variant="secondary"
          size="md"
          class="font-bold"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0" aria-hidden="true">
            <path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/>
            <path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>
          </svg>
          <span>Buka Dompet Keuangan</span>
        </Button>
      </div>
    </div>

    <!-- Master Designer Orders Overview (Period Filter, Statcards & Interactive Table) -->
    <DesignerOrdersOverview client:load allOrders={initialOrders} />
  </div>
</DashboardLayout>

