---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { getAuthenticatedUser, isAuthorizedDesigner } from '@/lib/auth';
import { db } from '@/lib/db/client';
import { templates, commissions } from '@/db/schema';
import { eq, and, isNull, desc, sql } from 'drizzle-orm';
import DesignerTemplateCard from '@/components/designer/DesignerTemplateCard.svelte';

export const prerender = false;

const user = await getAuthenticatedUser(Astro.request);
if (!user || !isAuthorizedDesigner(user)) {
  return Astro.redirect('/auth/login?redirect=/designer/templates');
}

const templatesList = await db
  .select({
    id: templates.id,
    name: templates.name,
    description: templates.description,
    price: templates.price,
    thumbnailUrl: templates.thumbnailUrl,
    status: templates.status,
    rejectionReason: templates.rejectionReason,
    createdAt: templates.createdAt,
    totalSold: sql<number>`count(${commissions.id})`.mapWith(Number),
  })
  .from(templates)
  .leftJoin(commissions, eq(templates.id, commissions.templateId))
  .where(and(eq(templates.designerId, user.id), isNull(templates.deletedAt)))
  .groupBy(templates.id, templates.name, templates.description, templates.price, templates.thumbnailUrl, templates.status, templates.rejectionReason, templates.createdAt)
  .orderBy(desc(templates.createdAt));
---

<DashboardLayout title="Manajemen Template" breadcrumb="Template Saya">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-base-100 p-6 rounded-2xl border border-base-200 shadow-sm">
      <div>
        <h1 class="text-2xl font-extrabold text-base-content tracking-tight">Template Saya</h1>
        <p class="text-xs text-base-content/60 mt-1">Kelola, buat, dan pantau status publikasi desain template toko Anda.</p>
      </div>
      <a
        href="/builder/new"
        class="btn btn-primary rounded-xl text-xs font-bold gap-2 px-5 text-white active:scale-95 transition-transform"
      >
        <span class="material-symbols-outlined text-[18px]">add</span>
        Buat Template Baru
      </a>
    </div>

    <!-- Status Filter Tabs -->
    <div class="flex items-center gap-1 overflow-x-auto pb-1 border-b border-base-200">
      <button
        type="button"
        class="tab-btn px-4 py-2 text-xs font-bold rounded-xl transition-colors bg-primary text-white"
        data-filter="all"
      >
        Semua ({templatesList.length})
      </button>
      <button
        type="button"
        class="tab-btn px-4 py-2 text-xs font-semibold text-base-content/70 hover:text-base-content hover:bg-base-200 rounded-xl transition-colors"
        data-filter="draft"
      >
        Draft ({templatesList.filter((t) => t.status === 'draft').length})
      </button>
      <button
        type="button"
        class="tab-btn px-4 py-2 text-xs font-semibold text-base-content/70 hover:text-base-content hover:bg-base-200 rounded-xl transition-colors"
        data-filter="pending"
      >
        Menunggu Review ({templatesList.filter((t) => t.status === 'pending').length})
      </button>
      <button
        type="button"
        class="tab-btn px-4 py-2 text-xs font-semibold text-base-content/70 hover:text-base-content hover:bg-base-200 rounded-xl transition-colors"
        data-filter="approved"
      >
        Disetujui ({templatesList.filter((t) => t.status === 'approved').length})
      </button>
      <button
        type="button"
        class="tab-btn px-4 py-2 text-xs font-semibold text-base-content/70 hover:text-base-content hover:bg-base-200 rounded-xl transition-colors"
        data-filter="rejected"
      >
        Ditolak ({templatesList.filter((t) => t.status === 'rejected').length})
      </button>
    </div>

    <!-- Templates Cards Grid -->
    {templatesList.length === 0 ? (
      <div class="card bg-base-100 border border-base-200 shadow-sm p-12 text-center max-w-md mx-auto rounded-2xl">
        <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mx-auto mb-4 border border-primary/20">
          <span class="material-symbols-outlined text-2xl">layers</span>
        </div>
        <h3 class="text-sm font-bold text-base-content">Belum Ada Template</h3>
        <p class="text-xs text-base-content/65 mt-1.5 mb-6">
          Mulai rancang dan publikasikan template toko online UMKM Anda pertama kali.
        </p>
        <a href="/builder/new" class="btn btn-primary btn-sm rounded-xl text-xs font-bold text-white px-6">
          Buat Template Baru
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {templatesList.map((tpl) => (
          <DesignerTemplateCard
            client:load
            template={tpl}
          />
        ))}
      </div>
    )}
  </div>

  <!-- Rejection Modal -->
  <dialog id="rejection_modal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box rounded-2xl border border-base-200 shadow-2xl p-6 bg-base-100">
      <h3 class="font-extrabold text-sm text-base-content flex items-center gap-1.5 text-rose-500">
        <span class="material-symbols-outlined text-[20px]">warning</span>
        Alasan Penolakan Template
      </h3>
      <p id="rejection_template_name" class="text-xs font-bold text-base-content/70 mt-3"></p>
      <div class="bg-rose-500/10 border border-rose-500/20 text-rose-600 rounded-xl p-4 mt-2 text-xs font-medium leading-relaxed">
        <p id="rejection_reason_text"></p>
      </div>
      <div class="modal-action">
        <form method="dialog">
          <button class="btn btn-sm rounded-xl px-4 text-xs font-bold btn-ghost">Tutup</button>
        </form>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>

  <script is:inline>
    async function deleteTemplate(templateId) {
      try {
        const response = await fetch(`/api/templates/draft?templateId=${templateId}`, {
          method: 'DELETE',
        });
        const result = await response.json();
        if (response.ok) {
          window.location.reload();
        } else {
          alert(result.error?.message || 'Gagal menghapus draf');
        }
      } catch (err) {
        alert('Terjadi kesalahan koneksi');
      }
    }

    function showRejectionModal(name, reason) {
      document.getElementById('rejection_template_name').textContent = name;
      document.getElementById('rejection_reason_text').textContent = reason;
      document.getElementById('rejection_modal').showModal();
    }

    // Status filter tabs logic
    document.querySelectorAll('.tab-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        
        document.querySelectorAll('.tab-btn').forEach((b) => {
          b.classList.remove('bg-primary', 'text-white');
          b.classList.add('text-base-content/70');
        });
        btn.classList.add('bg-primary', 'text-white');
        btn.classList.remove('text-base-content/70');

        document.querySelectorAll('.template-card').forEach((card) => {
          const status = card.getAttribute('data-status');
          if (filter === 'all' || status === filter) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</DashboardLayout>
