---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { getAuthenticatedUser, isAuthorizedDesigner } from "@/lib/auth";
import { db } from "@/lib/db/client";
import { templates, commissions } from "@/db/schema";
import { eq, and, isNull, desc, sql } from "drizzle-orm";
import DesignerTemplateTable from "@/components/designer/DesignerTemplateTable.svelte";
import StatCard from "@/components/ui/StatCard.svelte";
import Button from "@/components/ui/Button.svelte";

import { getPaginationParams, paginate } from "@/lib/pagination/server";
import type { PaginatedResult } from "@/types/common";

export const prerender = false;

const user = await getAuthenticatedUser(Astro.request);
if (!user || !isAuthorizedDesigner(user)) {
  return Astro.redirect("/auth/login?redirect=/designer/templates");
}

const { page } = getPaginationParams(Astro.url);
const whereCondition = and(eq(templates.designerId, user.id), isNull(templates.deletedAt));

let templatesList: Array<any> = [];
let pagination: PaginatedResult<any> = {
  data: [],
  totalItems: 0,
  totalPages: 1,
  currentPage: page,
  pageSize: 10,
};

let counts = {
  all: 0,
  draft: 0,
  pending: 0,
  approved: 0,
  rejected: 0,
};

try {
  const [countsRows, paginatedRes] = await Promise.all([
    db
      .select({
        id: templates.id,
        status: templates.status,
      })
      .from(templates)
      .where(whereCondition),
    paginate(
      db,
      templates,
      db
        .select({
          id: templates.id,
          name: templates.name,
          description: templates.description,
          price: templates.price,
          thumbnailUrl: templates.thumbnailUrl,
          status: templates.status,
          rejectionReason: templates.rejectionReason,
          createdAt: templates.createdAt,
          totalSold: sql<number>`count(${commissions.id})`.mapWith(Number),
        })
        .from(templates)
        .leftJoin(commissions, eq(templates.id, commissions.templateId))
        .where(whereCondition)
        .groupBy(
          templates.id,
          templates.name,
          templates.description,
          templates.price,
          templates.thumbnailUrl,
          templates.status,
          templates.rejectionReason,
          templates.createdAt,
        )
        .orderBy(desc(templates.createdAt)),
      whereCondition,
      page
    ),
  ]);

  pagination = paginatedRes;
  templatesList = pagination.data || [];

  counts = {
    all: countsRows.length,
    draft: countsRows.filter((t) => t.status === "draft").length,
    pending: countsRows.filter((t) => t.status === "pending").length,
    approved: countsRows.filter((t) => t.status === "approved").length,
    rejected: countsRows.filter((t) => t.status === "rejected").length,
  };
} catch (error) {
  console.error("[DesignerTemplates] Failed to query templates:", error);
}
---

<DashboardLayout title="Template Saya" breadcrumb="Template Saya">
  <div class="min-h-full space-y-8 md:space-y-10 pb-10">
    <!-- Page header -->
    <div
      class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2"
    >
      <div>
        <h1
          class="text-heading-lg text-main font-bold tracking-tight flex items-center gap-2.5"
        >
          <span>Koleksi Template Desain</span>
        </h1>
        <p class="text-body-base text-secondary mt-1 max-w-2xl leading-relaxed">
          Kelola, buat, dan pantau status kurasi publikasi template toko online
          UMKM Anda.
        </p>
      </div>
      <Button
        client:load
        href="/builder/new"
        variant="primary"
        size="md"
        class="font-bold flex-shrink-0"
      >
        <span class="material-symbols-outlined text-base">add_circle</span>
        <span>Buat Desain Baru</span>
      </Button>
    </div>

    <!-- Statcards Grid (animated on client load) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <StatCard
        client:load
        label="Total Koleksi"
        value={counts.all}
        rawValue={counts.all}
        icon="layers"
        cardTheme="dark"
        badge="Koleksi"
        footerText="Total template dibuat"
        delayClass="delay-100"
      />
      <StatCard
        client:load
        label="Disetujui"
        value={counts.approved}
        rawValue={counts.approved}
        icon="check_circle"
        cardTheme="default"
        badge="Aktif"
        footerText="Tersedia di katalog publik"
        delayClass="delay-150"
      />
      <StatCard
        client:load
        label="Menunggu Review"
        value={counts.pending}
        rawValue={counts.pending}
        icon="hourglass_top"
        cardTheme="blue"
        badge="Kurasi Admin"
        footerText="Sedang diperiksa tim kurator"
        delayClass="delay-200"
      />
      <StatCard
        client:load
        label="Draft & Revisi"
        value={counts.draft + counts.rejected}
        rawValue={counts.draft + counts.rejected}
        icon="edit_note"
        cardTheme="orange"
        badge="Dalam Proses"
        footerText="Belum dipublikasikan"
        delayClass="delay-250"
      />
    </div>

    <!-- Interactive Template Table (matching Riwayat Mutasi & Transaksi style) -->
    <div class="animate-fade-in-up delay-300">
      <DesignerTemplateTable client:load templates={templatesList} pagination={pagination} />
    </div>
  </div>
</DashboardLayout>
