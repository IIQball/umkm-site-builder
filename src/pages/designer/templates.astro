---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { getAuthenticatedUser, isAuthorizedDesigner } from '@/lib/auth';
import { db } from '@/lib/db/client';
import { templates, commissions } from '@/db/schema';
import { eq, and, isNull, desc, sql } from 'drizzle-orm';
import DesignerTemplateManager from '@/components/designer/DesignerTemplateManager.svelte';

export const prerender = false;

const user = await getAuthenticatedUser(Astro.request);
if (!user || !isAuthorizedDesigner(user)) {
  return Astro.redirect('/auth/login?redirect=/designer/templates');
}

const templatesList = await db
  .select({
    id: templates.id,
    name: templates.name,
    description: templates.description,
    price: templates.price,
    thumbnailUrl: templates.thumbnailUrl,
    status: templates.status,
    rejectionReason: templates.rejectionReason,
    createdAt: templates.createdAt,
    totalSold: sql<number>`count(${commissions.id})`.mapWith(Number),
  })
  .from(templates)
  .leftJoin(commissions, eq(templates.id, commissions.templateId))
  .where(and(eq(templates.designerId, user.id), isNull(templates.deletedAt)))
  .groupBy(
    templates.id,
    templates.name,
    templates.description,
    templates.price,
    templates.thumbnailUrl,
    templates.status,
    templates.rejectionReason,
    templates.createdAt,
  )
  .orderBy(desc(templates.createdAt));
---

<DashboardLayout title="Template Saya" breadcrumb="Template Saya">
  <div class="min-h-full bg-canvas -m-4 md:-m-6 lg:-m-8 p-4 md:p-6 lg:p-8">
    <!-- Page header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
      <div>
        <h1 class="text-xl font-black text-main tracking-tight animate-fade-in">Koleksi Template Desain</h1>
        <p class="text-sm text-secondary mt-1">
          Kelola, buat, pantau status publikasi, dan hapus template toko UMKM Anda.
        </p>
      </div>
      <a
        href="/builder/new"
        class="btn btn-primary text-sm font-bold rounded-xl px-5 py-2.5 transition-all flex-shrink-0 flex items-center gap-1.5"
      >
        <span class="material-symbols-outlined text-sm">add</span>
        <span>Buat Desain Baru</span>
      </a>
    </div>

    <!-- Interactive Manager Component -->
    <DesignerTemplateManager client:load initialTemplates={templatesList} />
  </div>
</DashboardLayout>
