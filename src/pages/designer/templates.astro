---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { getAuthenticatedUser, isAuthorizedDesigner } from '@/lib/auth';
import { db } from '@/lib/db/client';
import { templates, commissions } from '@/db/schema';
import { eq, and, isNull, desc, sql } from 'drizzle-orm';
import DesignerTemplateCard from '@/components/designer/DesignerTemplateCard.svelte';
import StatCard from '@/components/ui/StatCard.svelte';

export const prerender = false;

const user = await getAuthenticatedUser(Astro.request);
if (!user || !isAuthorizedDesigner(user)) {
  return Astro.redirect('/auth/login?redirect=/designer/templates');
}

const templatesList = await db
  .select({
    id: templates.id,
    name: templates.name,
    description: templates.description,
    price: templates.price,
    thumbnailUrl: templates.thumbnailUrl,
    status: templates.status,
    rejectionReason: templates.rejectionReason,
    createdAt: templates.createdAt,
    totalSold: sql<number>`count(${commissions.id})`.mapWith(Number),
  })
  .from(templates)
  .leftJoin(commissions, eq(templates.id, commissions.templateId))
  .where(and(eq(templates.designerId, user.id), isNull(templates.deletedAt)))
  .groupBy(
    templates.id, templates.name, templates.description, templates.price,
    templates.thumbnailUrl, templates.status, templates.rejectionReason, templates.createdAt,
  )
  .orderBy(desc(templates.createdAt));

const counts = {
  all:      templatesList.length,
  draft:    templatesList.filter((t) => t.status === 'draft').length,
  pending:  templatesList.filter((t) => t.status === 'pending').length,
  approved: templatesList.filter((t) => t.status === 'approved').length,
  rejected: templatesList.filter((t) => t.status === 'rejected').length,
};

type FilterKey = keyof typeof counts;

const tabs: Array<{ key: FilterKey; label: string }> = [
  { key: 'all',      label: 'Semua' },
  { key: 'draft',    label: 'Draft' },
  { key: 'pending',  label: 'Menunggu Review' },
  { key: 'approved', label: 'Disetujui' },
  { key: 'rejected', label: 'Ditolak' },
];
---

<DashboardLayout title="Template Saya" breadcrumb="Template Saya">
  <div class="min-h-full bg-canvas -m-4 md:-m-6 lg:-m-8 p-4 md:p-6 lg:p-8">

    <!-- Page header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
      <div>
        <h1 class="text-xl font-black text-main tracking-tight animate-fade-in">Koleksi Template Desain</h1>
        <p class="text-[13px] text-secondary mt-1">
          Kelola, buat, dan pantau status publikasi template toko UMKM Anda.
        </p>
      </div>
      <a
        href="/builder/new"
        class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white
               text-[13px] font-bold rounded-xl px-5 py-2.5 shadow-sm shadow-indigo-600/25
               transition-colors active:scale-95 flex-shrink-0"
      >
        <span class="material-symbols-outlined text-[17px]">add</span>
        Buat Desain Baru
      </a>
    </div>

    <!-- Stat cards — matches wallet DesignerStatCards style -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-5">
      <StatCard label="Total Template" value={counts.all} icon="layers" iconCls="icon-wrapper-indigo" borderAccent="border-t-2 border-t-indigo-400" />
      <StatCard label="Disetujui" value={counts.approved} icon="check_circle" iconCls="icon-wrapper-emerald" borderAccent="border-t-2 border-t-emerald-400" />
      <StatCard label="Menunggu Review" value={counts.pending} icon="hourglass_top" iconCls="icon-wrapper-amber" borderAccent="border-t-2 border-t-amber-400" />
      <StatCard label="Draft" value={counts.draft} icon="edit_note" iconCls="text-secondary" borderAccent="border-t-2 border-t-slate-400" />
    </div>

    <!-- Filter + Grid container — matches wallet panel style -->
    <div class="bg-card border border-light rounded-2xl shadow-sm overflow-hidden">
      <!-- Filter tabs header -->
      <div class="px-6 py-4 border-b border-light flex items-center justify-between gap-4 flex-wrap">
        <div>
          <h3 class="text-[13px] font-bold text-main">Daftar Template</h3>
          <p class="text-[11px] text-muted mt-0.5">Filter berdasarkan status publikasi</p>
        </div>
        <div class="flex items-center gap-1 bg-nested border border-light rounded-xl p-1 overflow-x-auto flex-shrink-0">
          {tabs.map((tab) => (
            <button
              type="button"
              class={`tab-btn flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[12px] font-semibold whitespace-nowrap transition-all ${tab.key === 'all' ? 'bg-indigo-600 text-white shadow-sm' : 'text-secondary hover:text-main hover:bg-card'}`}
              data-filter={tab.key}
            >
              {tab.label}
              <span class={`text-[10px] font-bold ${tab.key === 'all' ? 'bg-white/20 text-white' : 'bg-nested border border-light text-secondary'} rounded-md px-1.5 py-0.5 leading-none`}>
                {counts[tab.key]}
              </span>
            </button>
          ))}
        </div>
      </div>

      <!-- Templates grid or empty state -->
      <div class="p-6">
        {templatesList.length === 0 ? (
          <div class="py-12 flex flex-col items-center text-center">
            <div class="w-14 h-14 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mx-auto mb-4">
              <span class="material-symbols-outlined icon-filled text-[28px]">layers</span>
            </div>
            <h3 class="text-[14px] font-bold text-main">Belum Ada Template</h3>
            <p class="text-[12px] text-secondary mt-1.5 mb-6 max-w-xs mx-auto leading-relaxed">
              Mulai rancang dan publikasikan template toko online UMKM pertama Anda.
            </p>
            <a
              href="/builder/new"
              class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white text-[12px] font-bold rounded-xl px-6 py-2.5 transition-colors active:scale-95"
            >
              <span class="material-symbols-outlined text-[15px]">add</span>
              Buat Template Baru
            </a>
          </div>
        ) : (
          <div id="templates-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {templatesList.map((tpl) => (
              <DesignerTemplateCard client:load template={tpl} />
            ))}
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Rejection modal -->
  <dialog id="rejection_modal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box rounded-2xl border border-light shadow-2xl p-6 bg-card max-w-sm">
      <div class="flex items-center gap-2 mb-4">
        <div class="w-9 h-9 rounded-xl bg-rose-500/10 border border-rose-500/25 flex items-center justify-center">
          <span class="material-symbols-outlined icon-filled text-[18px] text-rose-500">warning</span>
        </div>
        <h3 class="text-[14px] font-bold text-rose-600">Alasan Penolakan</h3>
      </div>
      <p id="rejection_template_name" class="text-[11px] font-bold text-secondary mb-2"></p>
      <div class="bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 rounded-xl p-4 text-[12px] font-medium leading-relaxed font-mono">
        <p id="rejection_reason_text"></p>
      </div>
      <div class="modal-action mt-5">
        <form method="dialog">
          <button class="inline-flex items-center px-5 py-2 text-[12px] font-bold text-main
                         border border-light rounded-xl hover:bg-nested transition-colors">
            Tutup
          </button>
        </form>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>

  <script is:inline>
    // Segmented filter tabs logic
    document.querySelectorAll('.tab-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        document.querySelectorAll('.tab-btn').forEach((b) => {
          b.classList.remove('bg-indigo-600', 'text-white', 'shadow-sm');
          b.classList.add('text-slate-500', 'hover:text-slate-800', 'hover:bg-slate-50');
          // Reset badge style
          const badge = b.querySelector('span:last-child');
          if (badge) {
            badge.classList.remove('bg-white/20', 'text-white');
            badge.classList.add('bg-slate-100', 'text-slate-500');
          }
        });

        btn.classList.add('bg-indigo-600', 'text-white', 'shadow-sm');
        btn.classList.remove('text-slate-500', 'hover:text-slate-800', 'hover:bg-slate-50');
        const badge = btn.querySelector('span:last-child');
        if (badge) {
          badge.classList.add('bg-white/20', 'text-white');
          badge.classList.remove('bg-slate-100', 'text-slate-500');
        }

        document.querySelectorAll('.template-card').forEach((card) => {
          const status = card.getAttribute('data-status');
          card.style.display = (filter === 'all' || status === filter) ? '' : 'none';
        });
      });
    });
  </script>
</DashboardLayout>
