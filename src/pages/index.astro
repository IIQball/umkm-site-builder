---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="UMKM Site Builder - Beranda" description="Buat website profesional untuk bisnis UMKM Anda dalam hitungan menit, tanpa coding.">
  <main class="container mx-auto px-4 py-12">
    <div class="text-center">
      <h1 class="text-4xl font-bold mb-4">UMKM Site Builder</h1>
      <p class="text-xl text-gray-600 mb-8">
        Pembuat website tanpa kode untuk UMKM Indonesia
      </p>
      <div class="flex gap-4 justify-center">
        <a href="/auth/login" class="btn btn-primary">Masuk</a>
        <a href="/auth/register" class="btn btn-outline">Mulai Gratis</a>
      </div>
    </div>
  </main>
</BaseLayout>
