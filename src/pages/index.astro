---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="UMKM Site Builder - Home" description="Create a professional website for your UMKM business in minutes, no coding required.">
  <main class="container mx-auto px-4 py-12">
    <div class="text-center">
      <h1 class="text-4xl font-bold mb-4">UMKM Site Builder</h1>
      <p class="text-xl text-gray-600 mb-8">
        No-code web builder for Indonesian micro-enterprises
      </p>
      <div class="flex gap-4 justify-center">
        <a href="/auth/login" class="btn btn-primary">Sign In</a>
        <a href="/auth/register" class="btn btn-outline">Get Started</a>
      </div>
    </div>
  </main>
</BaseLayout>
