---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TemplateCardAction from '@/components/public/TemplateCardAction.svelte';
import { db } from '@/lib/db/client';
import { templates, userTemplates, designers, users } from '@/db/schema';
import { eq, and, isNull, desc } from 'drizzle-orm';
import { getAuthenticatedUser } from '@/lib/auth';
import { formatCurrency } from '@/lib/utils/format';

const currentUser = await getAuthenticatedUser(Astro.request);
const isDesigner = currentUser?.role === 'designer';

// Fetch all templates (only approved and published ones for marketplace)
const records = await db
  .select({
    id: templates.id,
    name: templates.name,
    description: templates.description,
    thumbnailUrl: templates.thumbnailUrl,
    price: templates.price,
    status: templates.status,
    createdAt: templates.createdAt,
    designerName: users.name,
  })
  .from(templates)
  .leftJoin(designers, eq(templates.designerId, designers.userId))
  .leftJoin(users, eq(designers.userId, users.id))
  .where(and(eq(templates.status, 'approved'), isNull(templates.deletedAt)))
  .orderBy(desc(templates.createdAt));

// Fetch owned template IDs if logged in
let ownedTemplateIds: string[] = [];
if (currentUser) {
  const owned = await db
    .select({ templateId: userTemplates.templateId })
    .from(userTemplates)
    .where(eq(userTemplates.userId, currentUser.id));
  ownedTemplateIds = owned.map((o) => o.templateId);
}

const formatPrice = (price: number) => {
  return price === 0 ? 'Gratis' : formatCurrency(price);
};

const getStatusBadge = (status: string) => {
  switch (status) {
    case 'approved':
      return {
        label: 'Siap Pakai',
        className: 'badge-custom-emerald',
      };
    case 'pending':
      return {
        label: 'Menunggu Review',
        className: 'badge-custom-amber',
      };
    case 'rejected':
      return {
        label: 'Perlu Revisi',
        className: 'badge-custom-rose',
      };
    default:
      return {
        label: 'Draft Desainer',
        className: 'badge-custom-slate',
      };
  }
};
---

<BaseLayout title="Katalog Template Website UMKM - UMKM Site Builder">
  <div class="min-h-screen bg-base-100 py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <!-- Header Section -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 border-b border-base-200 pb-8">
        <div>
          <div class="inline-flex items-center gap-1.5 bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-semibold mb-3 border border-primary/25">
            <span class="material-symbols-outlined text-xs">storefront</span>
            Template Marketplace
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-base-content leading-tight">
            Desain Profesional untuk Toko Online Anda
          </h1>
          <p class="text-base-content/75 text-sm mt-2 max-w-2xl leading-relaxed">
            Pilih template buatan desainer handal kami untuk mendongkrak omzet penjualan produk digital & fisik UMKM Anda secara instan.
          </p>
        </div>
      </div>

      <!-- Templates Grid -->
      {records.length === 0 ? (
        <div class="flex flex-col items-center justify-center py-20 text-center bg-base-200/50 rounded-2xl border border-base-content/10">
          <div class="w-16 h-16 rounded-full bg-base-300 flex items-center justify-center mb-4 text-base-content/50">
            <span class="material-symbols-outlined text-3xl">layers_clear</span>
          </div>
          <h3 class="text-lg font-bold text-base-content">Belum Ada Template</h3>
          <p class="text-sm text-base-content/60 mt-1 max-w-sm">
            Saat ini belum ada template yang siap dipublikasikan ke pasar. Silakan hubungi tim administrasi.
          </p>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {records.map((tpl) => {
            const badge = getStatusBadge(tpl.status);
            return (
              <div class="card bg-base-100 border border-base-content/10 shadow-lg hover:shadow-xl hover:border-base-content/20 transition-all rounded-2xl overflow-hidden flex flex-col group">
                <!-- Thumbnail -->
                <div class="relative h-48 w-full bg-slate-900 flex items-center justify-center overflow-hidden border-b border-base-200/60">
                  {tpl.thumbnailUrl ? (
                    <img
                      src={tpl.thumbnailUrl}
                      alt={tpl.name}
                      class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
                    />
                  ) : (
                    <div class="flex flex-col items-center justify-center text-slate-400 gap-2 p-6 text-center">
                      <div class="w-10 h-10 rounded-xl bg-slate-800 border border-slate-700/60 flex items-center justify-center text-slate-300">
                        <span class="material-symbols-outlined">palette</span>
                      </div>
                      <span class="text-xs font-medium text-slate-300">Preview Desain Toko</span>
                    </div>
                  )}

                  <!-- Status Badge -->
                  <div class="absolute top-3 right-3">
                    <span class={`badge-custom backdrop-blur-md ${badge.className}`}>
                      {badge.label}
                    </span>
                  </div>
                </div>

                <!-- Card Body -->
                <div class="p-5 flex-1 flex flex-col justify-between">
                  <div>
                    <!-- Name & Price -->
                    <div class="flex items-start justify-between gap-2 mb-1.5">
                      <h2 class="text-base font-bold text-base-content line-clamp-1 group-hover:text-primary transition-colors">
                        {tpl.name}
                      </h2>
                      <span class="text-sm font-extrabold text-primary flex-shrink-0">
                        {formatPrice(tpl.price)}
                      </span>
                    </div>

                    <!-- Description -->
                    <p class="text-xs text-base-content/65 line-clamp-2 mb-4 leading-relaxed">
                      {tpl.description || 'Template responsif modern dengan integrasi katalog produk, WhatsApp, dan checkout praktis.'}
                    </p>
                  </div>

                  <div>
                    <!-- Designer Info -->
                    <div class="flex items-center gap-2 pt-3 border-t border-base-200/70 mb-3.5">
                      <div class="w-5 h-5 rounded-full bg-primary/20 text-primary font-bold text-xs flex items-center justify-center">
                        {tpl.designerName ? tpl.designerName.charAt(0).toUpperCase() : 'D'}
                      </div>
                      <span class="text-xs text-base-content/70 font-medium truncate">
                        {tpl.designerName || 'Desainer'}
                      </span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex flex-col gap-2 pt-1">
                      <a
                        href={`/builder/preview/${tpl.id}`}
                        class="btn btn-outline border-base-300 hover:bg-base-200 btn-sm rounded-xl text-xs font-medium flex items-center justify-center gap-1.5 w-full"
                      >
                        <span class="material-symbols-outlined text-base">visibility</span>
                        <span>Pratinjau Langsung</span>
                      </a>
                      {!isDesigner && (
                        <TemplateCardAction
                          client:load
                          templateId={tpl.id}
                          price={tpl.price}
                          isOwned={ownedTemplateIds.includes(tpl.id)}
                          isLoggedIn={!!currentUser}
                        />
                      )}
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
