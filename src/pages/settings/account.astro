---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import AccountSettings from '@/components/settings/AccountSettings.svelte';
import { getAuthenticatedUser } from '@/lib/auth';

const user = await getAuthenticatedUser(Astro.request);
if (!user) return Astro.redirect('/auth/login');

const userJson = JSON.stringify(user);
---

<DashboardLayout title="Pengaturan Akun" breadcrumb="Pengaturan Akun">
  <div class="max-w-7xl mx-auto">
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight">Pengaturan Akun</h1>
      <p class="text-muted mt-2">Kelola informasi profil dan keamanan akun Anda.</p>
    </div>
    
    <AccountSettings client:load userJson={userJson} />
  </div>
</DashboardLayout>
