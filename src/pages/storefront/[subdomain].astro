---
import StorefrontLayout from "@/layouts/StorefrontLayout.astro";
import StorefrontDynamicPage from "@/components/storefront/StorefrontDynamicPage.svelte";
import { db } from "@/lib/db/client";
import { stores, products, storeCategories } from "@/db/schema";
import { eq, and, sql, isNull } from "drizzle-orm";
import { migrateTemplateConfig } from "@/lib/templates/migration";
import { mergeStoreCustomization } from "@/lib/templates/mergeCustomization";
import { buildStorefrontCssTheme } from "@/components/builder/canvas/canvasCss.helpers";
import { extractFontNames, buildGoogleFontsUrl } from "@/components/builder/canvas/fontLoader.helpers";
import { firstProductImageUrl } from "@/lib/products/image";
import { deserializeVariants } from "@/components/tenant/products/productForm.helpers";

const { subdomain } = Astro.params;

if (!subdomain) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

// 2. Data Fetching: Ambil store dengan relasi template, templateCategory, dan businessCategory
const store = await db.query.stores.findFirst({
  where: and(
    eq(stores.subdomain, subdomain),
    isNull(stores.deletedAt)
  ),
  with: {
    category: true,
    template: {
      with: {
        category: true,
      },
    },
    registrar: {
      columns: { name: true },
    },
  },
});

if (!store || store.status !== "active") {
  return new Response(null, { status: 404, statusText: "Store Not Found or Inactive" });
}

// 3. Ambil data produk aktif & kategori toko
const dbProducts = await db.query.products.findMany({
  where: and(
    eq(products.storeId, store.id),
    eq(products.isAvailable, true),
    isNull(products.deletedAt)
  ),
  with: {
    category: true,
  },
  orderBy: [sql`${products.sortOrder} ASC`],
});

const storeProducts = dbProducts.map((p) => {
  const resolvedImage = firstProductImageUrl(p.imageUrls);
  return {
    id: p.id,
    name: p.name,
    // DB column is basePrice, not price
    price: Number(p.basePrice || 0),
    basePrice: Number(p.basePrice || 0),
    image: resolvedImage,
    imageUrl: resolvedImage,
    imageUrls: Array.isArray(p.imageUrls) ? (p.imageUrls as string[]) : [],
    description: p.description || '',
    variants: deserializeVariants(p.variants),
    category: p.category ? { id: p.category.id, name: p.category.name, slug: p.category.slug } : null,
    categoryName: p.category?.name || null,
    badge: p.isAvailable ? undefined : 'Habis',
    sortOrder: p.sortOrder,
  };
});

const dbCategories = await db.query.storeCategories.findMany({
  where: and(
    eq(storeCategories.storeId, store.id),
    isNull(storeCategories.deletedAt)
  ),
});

const categories = dbCategories.map((c) => ({
  id: c.id,
  name: c.name,
  slug: c.slug,
}));

// 4. Normalisasi & Deep Merge Konfigurasi Template Toko
const baseTemplateConfig = store.template?.config;
const normalizedConfig = migrateTemplateConfig(baseTemplateConfig);

// Resolve Google Maps shortlinks (goo.gl / maps.app.goo.gl) to full canonical place URL
let canonicalMapsUrl = store.googleMapsUrl;
if (canonicalMapsUrl && (canonicalMapsUrl.includes('goo.gl') || canonicalMapsUrl.includes('maps.app.goo.gl'))) {
  try {
    const headRes = await fetch(canonicalMapsUrl, {
      redirect: 'manual',
      signal: AbortSignal.timeout(2500),
    });
    const redirectLocation = headRes.headers.get('location');
    if (redirectLocation) {
      canonicalMapsUrl = redirectLocation;
    }
  } catch {
    void 0;
  }
}

const storeCustomization = (store.customization as Record<string, unknown>) || {};
const branchMode = (storeCustomization.maps as any)?.branchMode || (storeCustomization as any).branchMode || 'single';
const branches = (storeCustomization.maps as any)?.branches || (storeCustomization as any).branches || [];

const finalConfig = mergeStoreCustomization(normalizedConfig, store.customization, {
  id: store.id,
  name: store.name,
  subdomain: store.subdomain,
  address: store.address,
  waNumber: store.waNumber,
  googleMapsEmbedUrl: store.googleMapsEmbedUrl,
  googleMapsUrl: canonicalMapsUrl || store.googleMapsUrl,
  categoryName: store.category?.name || undefined,
  latitude: store.latitude,
  longitude: store.longitude,
  branchMode,
  branches,
});

// 5. Dynamic Theme Tokens & Google Fonts Injection
const themeCss = buildStorefrontCssTheme(finalConfig.theme ?? {});

const fontNames = [
  ...extractFontNames(finalConfig.theme?.typography?.headingFont || ""),
  ...extractFontNames(finalConfig.theme?.typography?.bodyFont || ""),
];
const googleFontsUrl = buildGoogleFontsUrl(fontNames);

const customization = storeCustomization;
const isOpen = customization.isOpen !== false;
const storeLogo = (customization.logoUrl as string) || storeProducts[0]?.image || '/og-image.png';

// Set cache headers
Astro.response.headers.set("Cache-Control", "public, max-age=3600, s-maxage=86400");
Astro.response.headers.set("Surrogate-Control", "public, max-age=86400");
Astro.response.headers.set("Surrogate-Key", `store-${store.id}`);

const userAgent = Astro.request.headers.get("user-agent") || "";
const secChUaMobile = Astro.request.headers.get("sec-ch-ua-mobile");
const isMobileDevice = secChUaMobile === "?1" || /Mobile|Android|iPhone|iPad|iPod/i.test(userAgent);
const initialViewMode: 'mobile' | 'desktop' = isMobileDevice ? "mobile" : "desktop";

const heroSection = finalConfig.sections?.find((s: any) => s.type === 'hero');
const heroImageUrl = (heroSection?.props as any)?.imageUrl || 'https://images.unsplash.com/photo-1555421689-491a97ff2040?auto=format&fit=crop&w=1200&q=80';

const safeStore = {
  id: store.id,
  name: store.name,
  subdomain: store.subdomain,
  templateId: store.templateId,
  waNumber: store.waNumber,
  whatsappTemplate: customization.waCheckoutTemplate as string,
  address: store.address,
  googleMapsUrl: canonicalMapsUrl || store.googleMapsUrl,
  googleMapsEmbedUrl: store.googleMapsEmbedUrl,
  latitude: store.latitude,
  longitude: store.longitude,
  status: store.status,
  branchMode,
  branches,
  category: store.category ? { id: store.category.id, name: store.category.name, slug: store.category.slug } : null,
  managedByAdmin: store.registeredBy && store.registrar?.name ? { name: store.registrar.name } : null,
};
---

<StorefrontLayout
  title={`${store.name} — ${store.category?.name || "Toko Online"}`}
  description={`${store.name} — Toko online resmi di Banyuwangi. ${store.address ? store.address + '.' : ''} Pesan produk lokal terbaik langsung via WhatsApp.`}
  image={storeLogo}
>
  <link
    rel="preload"
    as="image"
    href={heroImageUrl.includes('images.unsplash.com') ? heroImageUrl.replace('w=1200', 'w=500').replace('q=80', 'q=75') : heroImageUrl}
    imagesrcset={heroImageUrl.includes('images.unsplash.com') ? `${heroImageUrl.replace('w=1200', 'w=500').replace('q=80', 'q=75')} 500w, ${heroImageUrl} 1200w` : undefined}
    imagesizes="(max-width: 640px) 100vw, 600px"
    fetchpriority="high"
  />
  {googleFontsUrl && (
    <link
      rel="stylesheet"
      href={googleFontsUrl}
      media="print"
      onload="this.media='all'"
    />
  )}
  <style is:inline set:html={themeCss} />

  <StorefrontDynamicPage
    config={finalConfig}
    store={safeStore}
    products={storeProducts}
    categories={categories}
    isOpen={isOpen}
    viewModeOverride={initialViewMode}
  />

  {safeStore.id && (
    <script is:inline define:vars={{ storeId: safeStore.id }}>
      if (typeof window !== 'undefined' && storeId) {
        try {
          fetch('/api/analytics/track', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ storeId: storeId, eventType: 'store_view' }),
            keepalive: true
          }).catch(function() {});
        } catch (e) {}
      }
    </script>
  )}
</StorefrontLayout>
