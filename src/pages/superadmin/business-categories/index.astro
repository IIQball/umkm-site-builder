---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import BusinessCategoryManager from "@/components/admin/BusinessCategoryManager.svelte";
import StatCard from "@/components/ui/StatCard.svelte";
import Button from "@/components/ui/Button.svelte";
import { getAuthenticatedUser, isAuthorizedSuperAdmin } from "@/lib/auth";
import { db } from "@/lib/db/client";
import { businessCategories } from "@/db/schema";
import { desc } from "drizzle-orm";
import { getPaginationParams, paginate } from "@/lib/pagination/server";
import type { PaginatedResult } from "@/types/common";

export const prerender = false;

const user = await getAuthenticatedUser(Astro.request);
if (!user) {
  return Astro.redirect("/auth/login?redirect=/superadmin/business-categories");
}

if (!isAuthorizedSuperAdmin(user)) {
  return Astro.redirect("/403");
}

const { page } = getPaginationParams(Astro.url);
let categoryResult: PaginatedResult<typeof businessCategories.$inferSelect> = {
  data: [],
  totalItems: 0,
  totalPages: 1,
  currentPage: page,
  pageSize: 10,
};

try {
  const categoryQueryBuilder = db
    .select({
      id: businessCategories.id,
      name: businessCategories.name,
      slug: businessCategories.slug,
      description: businessCategories.description,
      icon: businessCategories.icon,
      createdBy: businessCategories.createdBy,
      createdAt: businessCategories.createdAt,
      updatedAt: businessCategories.updatedAt,
    })
    .from(businessCategories)
    .orderBy(desc(businessCategories.createdAt));

  categoryResult = await paginate(
    db,
    businessCategories,
    categoryQueryBuilder,
    undefined,
    page
  );
} catch {
  categoryResult.data = [];
}
---

<DashboardLayout
  title="Kategori Bisnis"
  breadcrumb="Super Admin / Kategori Bisnis"
>
  <div class="min-h-full space-y-8 md:space-y-10 pb-10">
    <!-- Page Header -->
    <div
      class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2"
    >
      <div>
        <h1
          class="text-heading-lg text-main tracking-tight flex items-center gap-2.5"
        >
          <span>Kelola Kategori Bisnis</span>
        </h1>
        <p class="text-sm text-secondary mt-1 max-w-2xl leading-relaxed">
          Atur master kategori bidang usaha dan industri toko UMKM yang tersedia untuk pilihan registrasi merchant dan filter direktori toko.
        </p>
      </div>

      <!-- Quick Action / Add Category -->
      <div class="flex items-center gap-2 flex-shrink-0">
        <Button
          client:load
          id="btn-add-biz-category-top"
          variant="primary"
          size="md"
          class="font-bold shadow-xs cursor-pointer"
        >
          <span class="material-symbols-outlined text-base">add</span>
          <span>Tambah Kategori</span>
        </Button>
      </div>
    </div>

    <!-- Statcards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <StatCard
        client:load
        label="Total Kategori Bisnis"
        value={categoryResult.totalItems}
        rawValue={categoryResult.totalItems}
        icon="storefront"
        cardTheme="dark"
        badge="Master Data"
        footerText="Semua kategori industri UMKM terdaftar"
        delayClass="delay-100"
      />
      <StatCard
        client:load
        label="Kategori Aktif"
        value={categoryResult.totalItems}
        rawValue={categoryResult.totalItems}
        icon="check_circle"
        cardTheme="default"
        badge="Aktif"
        footerText="Tersedia di form pendaftaran toko"
        delayClass="delay-150"
      />
      <StatCard
        client:load
        label="Standar Industri"
        value="100%"
        rawValue={100}
        icon="verified"
        cardTheme="blue"
        badge="Tervalidasi"
        footerText="Sesuai taxonomi usaha nasional"
        delayClass="delay-200"
      />
    </div>

    <!-- Interactive Table Panel -->
    <div class="animate-fade-in-up delay-300">
      <BusinessCategoryManager client:load initialCategories={categoryResult.data} pagination={categoryResult} />
    </div>
  </div>

  <script>
    document
      .getElementById("btn-add-biz-category-top")
      ?.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("open_create_biz_category_modal"));
      });
  </script>
</DashboardLayout>
