---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { getAuthenticatedUser } from '@/lib/auth';
import AdminMetricsOverview from '@/components/admin/AdminMetricsOverview.svelte';

export const prerender = false;

const user = await getAuthenticatedUser(Astro.request);
if (!user || user.role !== 'superadmin') {
  return Astro.redirect('/auth/login?redirect=/superadmin');
}

const currentHour = new Date().getHours();
let greeting = 'Selamat Datang';
if (currentHour >= 4 && currentHour < 11) {
  greeting = 'Selamat Pagi';
} else if (currentHour >= 11 && currentHour < 15) {
  greeting = 'Selamat Siang';
} else if (currentHour >= 15 && currentHour < 18.5) {
  greeting = 'Selamat Sore';
} else {
  greeting = 'Selamat Malam';
}
---

<DashboardLayout title="Super Admin Dashboard" breadcrumb="Super Admin / Dashboard">
  <div class="min-h-full pb-10 flex flex-col">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h1 class="text-heading-lg text-main font-bold tracking-tight flex items-center gap-2.5">
          <span>{greeting}, {user.name ? user.name.split(' ')[0] : 'Super Admin'}!</span>
        </h1>
        <p class="text-body-base text-secondary mt-1 max-w-2xl leading-relaxed">
          Berikut adalah metrik operasional, pendapatan platform, dan manajemen pengguna sistem.
        </p>
      </div>
    </div>

    <!-- Map & Location Quick Actions -->
    <div class="bg-card-base border border-light/60 rounded-3xl p-5 shadow-xs flex flex-col md:flex-row gap-6 items-center mt-6 mb-12">
      <!-- Map Preview -->
      <div class="w-full md:w-1/2 h-48 rounded-2xl overflow-hidden bg-nested/50 relative border border-light/50 shadow-inner group">
        <iframe 
          width="100%" 
          height="100%" 
          frameborder="0" 
          style="border:0;" 
          allowfullscreen="" 
          aria-hidden="false" 
          tabindex="0"
          src="https://maps.google.com/maps?q=UMKM+terdekat&t=&z=14&ie=UTF8&iwloc=&output=embed"
          class="grayscale opacity-90 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-500"
        ></iframe>
        <div class="absolute top-3 left-3 bg-white/90 dark:bg-slate-900/90 backdrop-blur-sm px-3 py-1.5 rounded-xl border border-light/60 shadow-sm flex items-center gap-2 pointer-events-none">
          <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
          <span class="text-xs font-bold text-main">Live Location Area</span>
        </div>
      </div>
      
      <!-- Actions -->
      <div class="w-full md:w-1/2 flex flex-col gap-3">
        <h3 class="text-lg font-bold text-main font-heading flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          Peta & Titik UMKM
        </h3>
        <p class="text-sm text-secondary leading-relaxed">
          Pantau sebaran lokasi UMKM di sekitar Anda. Gunakan akses cepat di bawah ini untuk mendaftarkan titik toko baru ke Google Maps dan memperluas jangkauan pencarian lokal mereka.
        </p>
        <div class="mt-3 flex flex-wrap gap-3">
          <a href="https://business.google.com/create" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-hover text-white px-5 py-2.5 rounded-xl font-bold text-sm transition-all shadow-sm shadow-primary/20 hover:scale-105 active:scale-95">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><line x1="12" y1="9" x2="12" y2="15"></line><line x1="9" y1="12" x2="15" y2="12"></line></svg>
            Daftar Toko Baru
          </a>
          <a href="https://maps.google.com/maps?q=UMKM+terdekat" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-card border border-light/60 hover:bg-nested text-main px-5 py-2.5 rounded-xl font-bold text-sm transition-all hover:scale-105 active:scale-95">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"></path><path d="M9 21H3v-6"></path><path d="M21 3l-7 7"></path><path d="M3 21l7-7"></path></svg>
            Perbesar Peta
          </a>
        </div>
      </div>
    </div>

    <!-- Metrik Sistem & Transaksi -->
    <AdminMetricsOverview client:load />
  </div>
</DashboardLayout>
