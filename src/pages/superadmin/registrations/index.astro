---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import AdminRegistrationPanel from '@/components/admin/AdminRegistrationPanel.svelte';
import { getAuthenticatedUser } from '@/lib/auth';
import { db } from '@/lib/db/client';
import { tenantInvitations, users } from '@/db/schema';
import { eq, desc } from 'drizzle-orm';

export const prerender = false;

const user = await getAuthenticatedUser(Astro.request);
if (!user || user.role !== 'superadmin') {
  return Astro.redirect('/auth/login?redirect=/superadmin/registrations');
}

let initialInvitations: Array<{
  id: string;
  name: string;
  email: string;
  token: string;
  invitedBy: string;
  expiresAt: string;
  acceptedAt: string | null;
  createdAt: string;
}> = [];

try {
  const rows = await db
    .select({
      id: tenantInvitations.id,
      name: users.name,
      email: tenantInvitations.email,
      token: tenantInvitations.token,
      invitedBy: tenantInvitations.invitedBy,
      expiresAt: tenantInvitations.expiresAt,
      acceptedAt: tenantInvitations.acceptedAt,
      createdAt: tenantInvitations.createdAt,
    })
    .from(tenantInvitations)
    .innerJoin(users, eq(tenantInvitations.email, users.email))
    .where(eq(tenantInvitations.invitedBy, user.id))
    .orderBy(desc(tenantInvitations.createdAt));

  initialInvitations = (rows || []).map((row) => ({
    id: row.id,
    name: row.name,
    email: row.email,
    token: row.token,
    invitedBy: row.invitedBy,
    expiresAt: row.expiresAt.toISOString(),
    acceptedAt: row.acceptedAt ? row.acceptedAt.toISOString() : null,
    createdAt: row.createdAt.toISOString(),
  }));
} catch (error) {
  console.error('[AdminRegistrations] Failed to query invitations:', error);
}
---

<DashboardLayout title="Link Registrasi" breadcrumb="Superadmin / Link Registrasi">
  <div class="min-h-full space-y-8 md:space-y-10 pb-10">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2">
      <div>
        <h1 class="text-heading-lg text-main font-bold tracking-tight flex items-center gap-2.5">
          <span>Link Registrasi Admin</span>
        </h1>
        <p class="text-body-base text-secondary mt-1 max-w-2xl leading-relaxed">
          Buat dan kelola link undangan registrasi khusus untuk Admin.
        </p>
      </div>
    </div>

    <AdminRegistrationPanel client:load invitations={initialInvitations} currentUser={user} />
  </div>
</DashboardLayout>
