---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import CommissionSettingsPanel from '@/components/admin/CommissionSettingsPanel.svelte';
import { getAuthenticatedUser, isAuthorizedSuperAdmin } from '@/lib/auth';
import { db } from '@/lib/db/client';
import { platformSettings } from '@/db/schema';

export const prerender = false;

const user = await getAuthenticatedUser(Astro.request);
if (!user) {
  return Astro.redirect('/auth/login');
}

if (!isAuthorizedSuperAdmin(user)) {
  return Astro.redirect('/403');
}

let initialFeePercentage = 30;
let initialSettlementDelayDays = 7;
let initialAdminServiceFee = 5000;
let initialMaxStoreBranches = 5;
let initialMaxTemplateRevisions = 3;

try {
  const records = await db
    .select({
      platformFeePercentage: platformSettings.platformFeePercentage,
      settlementDelayDays: platformSettings.settlementDelayDays,
      adminServiceFee: platformSettings.adminServiceFee,
      maxStoreBranches: platformSettings.maxStoreBranches,
      maxTemplateRevisions: platformSettings.maxTemplateRevisions,
    })
    .from(platformSettings)
    .limit(1);
  if (records.length > 0) {
    if (typeof records[0].platformFeePercentage === 'number') {
      initialFeePercentage = records[0].platformFeePercentage;
    }
    if (typeof records[0].settlementDelayDays === 'number') {
      initialSettlementDelayDays = records[0].settlementDelayDays;
    }
    if (typeof records[0].adminServiceFee === 'number') {
      initialAdminServiceFee = records[0].adminServiceFee;
    }
    if (typeof records[0].maxStoreBranches === 'number') {
      initialMaxStoreBranches = records[0].maxStoreBranches;
    }
    if (typeof records[0].maxTemplateRevisions === 'number') {
      initialMaxTemplateRevisions = records[0].maxTemplateRevisions;
    }
  }
} catch {
  initialFeePercentage = 30;
  initialSettlementDelayDays = 7;
  initialAdminServiceFee = 5000;
  initialMaxStoreBranches = 5;
  initialMaxTemplateRevisions = 3;
}
---

<DashboardLayout title="Pengaturan Komisi" breadcrumb="Super Admin / Pengaturan Platform">
  <div class="min-h-full space-y-8 md:space-y-10 pb-10">
    <CommissionSettingsPanel
      client:load
      {initialFeePercentage}
      {initialSettlementDelayDays}
      {initialAdminServiceFee}
      {initialMaxStoreBranches}
      {initialMaxTemplateRevisions}
    />
  </div>
</DashboardLayout>
