---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import TemplateCategoryManager from "@/components/admin/TemplateCategoryManager.svelte";
import StatCard from "@/components/ui/StatCard.svelte";
import Button from "@/components/ui/Button.svelte";
import { getAuthenticatedUser, isAuthorizedSuperAdmin } from "@/lib/auth";
import { db } from "@/lib/db/client";
import { templateCategories } from "@/db/schema";
import { desc } from "drizzle-orm";
import { getPaginationParams, paginate } from "@/lib/pagination/server";
import type { PaginatedResult } from "@/types/common";

export const prerender = false;

const user = await getAuthenticatedUser(Astro.request);
if (!user) {
  return Astro.redirect("/auth/login?redirect=/superadmin/template-categories");
}

if (!isAuthorizedSuperAdmin(user)) {
  return Astro.redirect("/403");
}

const { page } = getPaginationParams(Astro.url);
let categoryResult: PaginatedResult<typeof templateCategories.$inferSelect> = {
  data: [],
  totalItems: 0,
  totalPages: 1,
  currentPage: page,
  pageSize: 10,
};

try {
  const categoryQueryBuilder = db
    .select({
      id: templateCategories.id,
      name: templateCategories.name,
      slug: templateCategories.slug,
      description: templateCategories.description,
      icon: templateCategories.icon,
      createdAt: templateCategories.createdAt,
      updatedAt: templateCategories.updatedAt,
    })
    .from(templateCategories)
    .orderBy(desc(templateCategories.createdAt));

  categoryResult = await paginate(
    db,
    templateCategories,
    categoryQueryBuilder,
    undefined,
    page
  );
} catch {
  categoryResult.data = [];
}
---

<DashboardLayout
  title="Kategori Template"
  breadcrumb="Super Admin / Kategori Template"
>
  <div class="min-h-full space-y-8 md:space-y-10 pb-10">
    <!-- Page Header (matching designer/wallet & designer/templates style) -->
    <div
      class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2"
    >
      <div>
        <h1
          class="text-heading-lg text-main font-bold tracking-tight flex items-center gap-2.5"
        >
          <span>Kelola Kategori Template</span>
        </h1>
        <p class="text-body-base text-secondary mt-1 max-w-2xl leading-relaxed">
          Atur master kategori ceruk bisnis UMKM yang tersedia untuk template
          desainer dan filter katalog marketplace.
        </p>
      </div>

      <!-- Quick Action / Add Category -->
      <div class="flex items-center gap-2 flex-shrink-0">
        <Button
          client:load
          id="btn-add-category-top"
          variant="primary"
          size="md"
          class="font-bold shadow-xs cursor-pointer"
        >
          <span class="material-symbols-outlined text-base">add</span>
          <span>Tambah Kategori</span>
        </Button>
      </div>
    </div>

    <!-- Statcards Grid (animated on client load) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <StatCard
        client:load
        label="Total Kategori"
        value={categoryResult.totalItems}
        rawValue={categoryResult.totalItems}
        icon="category"
        cardTheme="dark"
        badge="Master Data"
        footerText="Semua ceruk bisnis terdaftar"
        delayClass="delay-100"
      />
      <StatCard
        client:load
        label="Kategori Aktif"
        value={categoryResult.totalItems}
        rawValue={categoryResult.totalItems}
        icon="check_circle"
        cardTheme="default"
        badge="Aktif"
        footerText="Tersedia di form builder desainer"
        delayClass="delay-150"
      />
      <StatCard
        client:load
        label="Standar Marketplace"
        value="100%"
        rawValue={100}
        icon="verified"
        cardTheme="blue"
        badge="Tervalidasi"
        footerText="Sesuai taxonomi toko UMKM"
        delayClass="delay-200"
      />
    </div>

    <!-- Interactive Table Panel -->
    <div class="animate-fade-in-up delay-300">
      <TemplateCategoryManager client:load initialCategories={categoryResult.data} pagination={categoryResult} />
    </div>
  </div>

  <script>
    document
      .getElementById("btn-add-category-top")
      ?.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("open_create_category_modal"));
      });
  </script>
</DashboardLayout>
