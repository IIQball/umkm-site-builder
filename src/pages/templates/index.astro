---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublicTemplates } from '@/services';
import { getAuthenticatedUser } from '@/lib/auth';
import { db } from '@/lib/db/client';
import { userTemplates } from '@/db/schema';
import { eq } from 'drizzle-orm';
import TemplateCardAction from '@/components/public/TemplateCardAction.svelte';

export const prerender = false;

const currentUser = await getAuthenticatedUser(Astro.request);
const ownedTemplateIds = currentUser
  ? (
      await db
        .select({ templateId: userTemplates.templateId })
        .from(userTemplates)
        .where(eq(userTemplates.userId, currentUser.id))
    ).map((ut) => ut.templateId)
  : [];

const templatesList = await getPublicTemplates();

const formatPrice = (price: number): string => {
  if (!price || price === 0) return 'Gratis';
  return `Rp ${price.toLocaleString('id-ID')}`;
};

const getStatusBadge = (status: string) => {
  switch (status) {
    case 'approved':
      return {
        label: 'Siap Pakai',
        className: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20',
      };
    case 'pending':
      return {
        label: 'Menunggu Review',
        className: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20',
      };
    case 'rejected':
      return {
        label: 'Perlu Revisi',
        className: 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/20',
      };
    default:
      return {
        label: 'Draft Desainer',
        className: 'bg-slate-500/10 text-slate-600 dark:text-slate-400 border-slate-500/20',
      };
  }
};
---

<BaseLayout title="Katalog Template Website UMKM - UMKM Site Builder">
  <div class="min-h-screen bg-base-100 py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <!-- Header Section -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 border-b border-base-200 pb-8">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 text-xs font-semibold mb-3 border border-blue-200 dark:border-blue-800/60 shadow-sm">
            <span>Marketplace Template Desainer</span>
          </div>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-base-content">
            Katalog Template Website UMKM
          </h1>
          <p class="text-xs sm:text-sm text-base-content/70 mt-2 max-w-2xl leading-relaxed">
            Pilih desain landing page dan toko online profesional siap pakai untuk memaksimalkan konversi penjualan bisnis lokal Anda.
          </p>
        </div>
      </div>

      <!-- Templates Grid -->
      {templatesList.length === 0 ? (
        <div class="text-center py-16 px-4 bg-base-200/40 rounded-2xl border border-dashed border-base-300 max-w-md mx-auto">
          <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center mx-auto mb-3 border border-blue-100 dark:border-blue-900/50">
            <span class="material-symbols-outlined text-2xl">layers</span>
          </div>
          <h3 class="text-base font-bold text-base-content mb-1">Belum Ada Template Terdaftar</h3>
          <p class="text-xs text-base-content/60">
            Saat ini belum ada template yang tersedia di katalog.
          </p>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {templatesList.map((tpl) => {
            const badge = getStatusBadge(tpl.status);
            const isDesigner = currentUser?.role === 'designer';
            return (
              <div class="card bg-base-100 border border-base-200/80 hover:border-blue-500/40 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-200 flex flex-col group">
                <!-- Thumbnail / Header Preview -->
                <div class="relative h-48 w-full bg-slate-900 flex items-center justify-center overflow-hidden border-b border-base-200/60">
                  {tpl.thumbnailUrl ? (
                    <img
                      src={tpl.thumbnailUrl}
                      alt={tpl.name}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                  ) : (
                    <div class="flex flex-col items-center justify-center text-slate-400 gap-2 p-6 text-center">
                      <div class="w-10 h-10 rounded-xl bg-slate-800 border border-slate-700/60 flex items-center justify-center text-slate-300">
                        <span class="material-symbols-outlined text-xl">storefront</span>
                      </div>
                      <span class="text-xs font-medium text-slate-300">Preview Desain Toko</span>
                    </div>
                  )}

                  <!-- Status Badge -->
                  <div class="absolute top-3 right-3">
                    <span class={`text-[10px] font-semibold uppercase tracking-wider px-2.5 py-0.5 rounded-full border shadow-sm backdrop-blur-md ${badge.className}`}>
                      {badge.label}
                    </span>
                  </div>
                </div>

                <!-- Card Body -->
                <div class="p-5 flex-1 flex flex-col justify-between">
                  <div>
                    <!-- Name & Price -->
                    <div class="flex items-start justify-between gap-2 mb-1.5">
                      <h2 class="text-base font-bold text-base-content line-clamp-1 group-hover:text-primary transition-colors">
                        {tpl.name}
                      </h2>
                      <span class="text-sm font-extrabold text-blue-600 dark:text-blue-400 flex-shrink-0">
                        {formatPrice(tpl.price)}
                      </span>
                    </div>

                    <!-- Description -->
                    <p class="text-xs text-base-content/65 line-clamp-2 mb-4 leading-relaxed">
                      {tpl.description || 'Template responsif modern dengan integrasi katalog produk, WhatsApp, dan checkout praktis.'}
                    </p>
                  </div>

                  <div>
                    <!-- Designer Info -->
                    <div class="flex items-center gap-2 pt-3 border-t border-base-200/70 mb-3.5">
                      <div class="w-5 h-5 rounded-full bg-blue-500/20 text-blue-600 dark:text-blue-400 font-bold text-[10px] flex items-center justify-center">
                        {tpl.designerName.charAt(0).toUpperCase()}
                      </div>
                      <span class="text-xs text-base-content/70 font-medium truncate">
                        {tpl.designerName}
                      </span>
                    </div>

                     <!-- Action Buttons -->
                    <div class="flex flex-col gap-2 pt-1">
                      <a
                        href={`/builder/preview/${tpl.id}`}
                        class="btn btn-outline border-base-300 hover:bg-base-200 btn-sm rounded-xl text-xs font-medium flex items-center justify-center gap-1.5 w-full"
                      >
                        <span class="material-symbols-outlined text-[16px]">visibility</span>
                        <span>Pratinjau Langsung</span>
                      </a>
                      {!isDesigner && (
                        <TemplateCardAction
                          client:load
                          templateId={tpl.id}
                          price={tpl.price}
                          isOwned={ownedTemplateIds.includes(tpl.id)}
                          isLoggedIn={!!currentUser}
                        />
                      )}
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
