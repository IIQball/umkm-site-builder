---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Direktori UMKM - Temukan Toko Online UMKM Indonesia"
  description="Cari dan temukan toko online UMKM Indonesia. Direktori lengkap usaha kecil dan menengah lokal."
>
  <main class="container mx-auto px-4 py-10 max-w-5xl">
    <!-- Header -->
    <div class="mb-8 text-center space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 text-xs font-semibold border border-emerald-200 dark:border-emerald-800/60">
        <span class="material-symbols-outlined text-[14px]">store</span>
        <span>Direktori Toko UMKM</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-slate-50">
        Temukan Toko Online UMKM
      </h1>
      <p class="text-slate-600 dark:text-slate-300 text-sm max-w-lg mx-auto">
        Jelajahi ribuan toko online UMKM Indonesia. Mode baca-saja — kunjungi langsung untuk berbelanja.
      </p>
    </div>

    <!-- Search Bar -->
    <div class="relative max-w-xl mx-auto mb-10">
      <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-[20px]">search</span>
      <input
        type="text"
        placeholder="Cari nama toko, kategori, atau lokasi..."
        class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm text-slate-700 dark:text-slate-200 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/40 shadow-sm"
      />
    </div>

    <!-- Placeholder Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
      {Array.from({ length: 6 }).map(() => (
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col gap-3 hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
            <span class="material-symbols-outlined text-slate-400">storefront</span>
          </div>
          <div class="space-y-1.5">
            <div class="h-4 w-3/4 rounded bg-slate-200 dark:bg-slate-700 animate-pulse"></div>
            <div class="h-3 w-1/2 rounded bg-slate-100 dark:bg-slate-800 animate-pulse"></div>
          </div>
          <div class="flex gap-1.5 mt-auto pt-2">
            <div class="h-5 w-16 rounded-full bg-emerald-100 dark:bg-emerald-900/40 animate-pulse"></div>
          </div>
        </div>
      ))}
    </div>

    <!-- Coming Soon Note -->
    <p class="text-center text-xs text-slate-400 dark:text-slate-600 mt-10">
      Halaman ini menampilkan data toko yang telah dipublikasikan. Konten sedang disiapkan.
    </p>
  </main>
</BaseLayout>
